@page "/CSharpNew/Index"
@{
    Layout = "_Layout";
    ViewData["Title"] = "C# New - Course Overview";
    ViewData["ActiveMenu"] = "CSharpNew";
    ViewData["ActivePage"] = "ModuleIndex";
}
@section LeftMenu {
    @await Html.PartialAsync("_LeftMenu_CSharpNew", new { CurrentModule = "Index" })
}

<style>
    .tt { position: relative; cursor: help; border-bottom: 1px dashed #0d6efd; }
    .tt::after { content: attr(data-tip); position: absolute; left: 0; bottom: 125%; background: #0d6efd; color: #fff; padding: 6px 8px; border-radius: 6px; opacity: 0; pointer-events: none; width: 240px; transition: opacity .2s; font-size: 0.9rem; }
    .tt:hover::after { opacity: 1; }
    .zoomable { transition: transform .25s ease; transition-delay: 3s; transform-origin: center; }
    .zoomable:hover { transform: scale(1.03); }
    .example-box { background: #f4f4f4; border: 1px solid #dcdcdc; border-radius: 8px; }
    .code-block { background: #1e1e1e; color: #e5e5e5; padding: 12px; border-radius: 10px; overflow-x: auto; }
    .toc-box { background: #eef6ff; border: 1px solid #cfe2ff; border-radius: 8px; }
    .ans pre.code { background: #1e1e1e; color: #f8f9fa; padding: 12px; border-radius: 8px; overflow-x: auto; }
</style>

<main class="container-fluid my-4">
    <header class="mb-3">
        <h1 class="h3">C# New Course Overview</h1>
        <p class="lead zoomable">Start with Module 01 at <a href="/CSharpNew/StartHappyLearning.html">StartHappyLearning.html</a> to align with the required file name.</p>
        <p class="zoomable">Course subtitle: C#.NET FOR FULLSTACK Developers. Course promise: clear words, tiny steps, friendly practice.</p>
    </header>
    <section class="toc-box p-3 mb-4">
        <h2 class="h5">Modules</h2>
        <ol>
        <li><a href="/CSharpNew/StartHappyLearning.html">Module 01: C# Programming + Assignment + Use case</a></li>
        <li><a href="/CSharpNew/02-sql-server-assignment-use-case.html">Module 02: SQL Server + Assignment + Use case</a></li>
        <li><a href="/CSharpNew/03-git-and-github-assignment-use-case.html">Module 03: Git & Github + Assignment + Use case</a></li>
        <li><a href="/CSharpNew/04-automated-testing-with-mstest-and-async-progr.html">Module 04: Automated Testing with MSTest and Async Programming in .Net + Assignment + Use case</a></li>
        <li><a href="/CSharpNew/05-ado-net-and-linq-and-entity-framework-assignm.html">Module 05: ADO.NET and LINQ and Entity Framework + Assignment + Use case</a></li>
        </ol>
    </section>
    <section class="my-4">
        <h3>How to use this course</h3>
        <p class="zoomable">Open the left menu to jump between modules. Each page includes table of contents, tooltips, zoom-on-hover, and practice sets.</p>
        <p class="zoomable">Start with Module 01 then follow next buttons at the end of each subtopic.</p>
    </section>
</main>
