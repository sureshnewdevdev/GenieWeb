@page "/CSharpNew/Index"
@{
    Layout = "_Layout";
    ViewData["Title"] = "C# New - Course Index";
    ViewData["ActiveMenu"] = "CSharpNew";
    ViewData["ActivePage"] = "CSharpNewIndex";
    ViewData["CSharpNewCurrentModule"] = "01";
}

<style>
    .tt {
        position: relative;
        cursor: help;
        border-bottom: 1px dashed #6c757d;
    }
    .tt:hover::after {
        content: attr(data-tip);
        position: absolute;
        left: 0;
        top: 1.6rem;
        background: #212529;
        color: #fff;
        padding: 0.5rem;
        border-radius: 0.25rem;
        width: 260px;
        z-index: 10;
        font-size: 0.9rem;
    }
    .zoomable { transition: transform .25s ease; transition-delay: 3s; transform-origin:center; }
    .zoomable:hover { transform: scale(1.03); }
    .module-card { border: 1px solid #e5e5e5; border-radius: 0.5rem; padding: 1rem; background: #f8f9fa; }
</style>

<section class="mt-4">
    <header class="mb-3">
        <h2 class="fw-bold">Welcome to C# New</h2>
        <p class="zoomable">This beginner-friendly path helps you learn <span class="tt" data-tip="Modern, type-safe, object-oriented programming language used for web, desktop, cloud, and games">C#</span> step by step with simple language, ready-to-run examples, and friendly guidance.</p>
        <p class="text-muted zoomable">You will start with core .NET ideas, set up tools, then write and reason about code like a confident junior developer.</p>
    </header>

    <div class="alert alert-info zoomable">
        <strong>Course subtitle:</strong> C#.NET FOR FULLSTACK Developers.<br />
        <span class="text-secondary">Mandatory and optional assessment based questions will be provided after each and every module completion.</span>
    </div>

    <div class="row g-3">
        <div class="col-12">
            <div class="module-card h-100 shadow-sm zoomable">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <p class="mb-1 text-uppercase text-secondary">Module 01</p>
                        <h3 class="h5 mb-1">C# Programming + Assignment + Use case</h3>
                        <p class="mb-0 text-muted">Route: StartHappyLearning.html</p>
                    </div>
                    <a class="btn btn-primary" href="/CSharpNew/StartHappyLearning.html">Start module</a>
                </div>
                <p class="zoomable">Preview: fundamentals, .NET runtime, tool setup, first C# program, and guided practice.</p>
                <ul class="mb-0">
                    <li>Course Fundamentals &amp; .NET Overview</li>
                    <li>Introduction to .NET, CLI, CLR, Framework Architecture</li>
                    <li>Introducing Visual Studio</li>
                    <li>C# Language Introduction</li>
                    <li>C# Language Tokens, Versions, Syntax structure</li>
                    <li>First C# Application (Visual Studio setup, Console class)</li>
                </ul>
            </div>
        </div>
    </div>

    <section class="mt-4">
        <h3>How to use this course</h3>
        <ol class="zoomable">
            <li>Open the left menu and pick the first module.</li>
            <li>Follow the step-by-step sections and run the sample code.</li>
            <li>Practice with the coding questions at the end of each module.</li>
            <li>Use tooltips for quick reminders of new terms.</li>
        </ol>
    </section>

    <section class="mt-4">
        <h3>Glossary (Tooltips)</h3>
        <table class="table table-striped">
            <thead>
                <tr><th>Term</th><th>Tooltip Description</th></tr>
            </thead>
            <tbody>
                <tr><td>CLI</td><td>Command Line Interface that runs compiled .NET applications and tools.</td></tr>
                <tr><td>CLR</td><td>Common Language Runtime that executes C# code safely and manages memory.</td></tr>
                <tr><td>Console</td><td>Simple text window where your first C# program writes output.</td></tr>
            </tbody>
        </table>
    </section>
</section>

@section LeftMenu {
    <partial name="~/Pages/Shared/_LeftMenu_CSharpNew.cshtml" />
}
