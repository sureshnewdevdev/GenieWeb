    <section id="practice-coding-questions" class="mb-5">
        <h2>To Become Best coder Practice this</h2>

        <div class="mb-4">
            <h3 class="h5">Scenario-based questions</h3>
            <div class="mb-3 zoomable">
                <h4>1) Warm welcome logger</h4>
                <ul>
                    <li><strong>Problem:</strong> Read a user's name and log a welcome message with timestamp.</li>
                    <li><strong>Input/Output:</strong> Input: name string. Output: greeting with current time.</li>
                    <li><strong>Example Input/Output:</strong> Input: "Sara" → Output: "[10:00] Hello Sara".</li>
                    <li><strong>Constraints:</strong> Name length &lt; 50.</li>
                    <li><strong>Hint:</strong> Use <code>DateTime.Now</code> and string interpolation.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>2) CLI project creator helper</h4>
                <ul>
                    <li><strong>Problem:</strong> Print steps to create and run a console app using CLI.</li>
                    <li><strong>Input/Output:</strong> Input: project name. Output: commands list.</li>
                    <li><strong>Example Input/Output:</strong> "Demo" → "dotnet new console -n Demo" etc.</li>
                    <li><strong>Constraints:</strong> Only letters allowed in the name.</li>
                    <li><strong>Hint:</strong> Build command strings and print them.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>3) Architecture explainer</h4>
                <ul>
                    <li><strong>Problem:</strong> Output a short summary of CLI → Compiler → CLR flow.</li>
                    <li><strong>Input/Output:</strong> Input: none. Output: three lines.</li>
                    <li><strong>Example Input/Output:</strong> "CLI creates", "Compiler builds", "CLR runs".</li>
                    <li><strong>Constraints:</strong> Keep each line under 40 characters.</li>
                    <li><strong>Hint:</strong> Use an array of strings and loop.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>4) Token counter</h4>
                <ul>
                    <li><strong>Problem:</strong> Count words in a line and label them as identifiers or keywords.</li>
                    <li><strong>Input/Output:</strong> Input: code line. Output: counts per category.</li>
                    <li><strong>Example Input/Output:</strong> "int age = 3;" → keyword=1, identifiers=1.</li>
                    <li><strong>Constraints:</strong> Treat known keywords from a small list.</li>
                    <li><strong>Hint:</strong> Store keywords in a HashSet.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>5) Friendly compiler message</h4>
                <ul>
                    <li><strong>Problem:</strong> Detect missing semicolon in a line and print guidance.</li>
                    <li><strong>Input/Output:</strong> Input: code line. Output: either "Looks good" or "Add ;".</li>
                    <li><strong>Example Input/Output:</strong> "Console.WriteLine("Hi")" → "Add ;"</li>
                    <li><strong>Constraints:</strong> Only check last character.</li>
                    <li><strong>Hint:</strong> Trim whitespace before checking.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>6) Visual Studio shortcut helper</h4>
                <ul>
                    <li><strong>Problem:</strong> Show shortcut descriptions when a user selects an action.</li>
                    <li><strong>Input/Output:</strong> Input: action name. Output: shortcut text.</li>
                    <li><strong>Example Input/Output:</strong> "format" → "Ctrl+K, Ctrl+D".</li>
                    <li><strong>Constraints:</strong> Support at least three actions.</li>
                    <li><strong>Hint:</strong> Use a dictionary lookup.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>7) Console echo with validation</h4>
                <ul>
                    <li><strong>Problem:</strong> Read text, ensure it is not empty, then echo.</li>
                    <li><strong>Input/Output:</strong> Input: string. Output: same string or warning.</li>
                    <li><strong>Example Input/Output:</strong> "Hi" → "You said: Hi".</li>
                    <li><strong>Constraints:</strong> Trim spaces before validation.</li>
                    <li><strong>Hint:</strong> Use <code>string.IsNullOrWhiteSpace</code>.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>8) Version reporter</h4>
                <ul>
                    <li><strong>Problem:</strong> Print the current C# language version symbol you target.</li>
                    <li><strong>Input/Output:</strong> Input: version string. Output: formatted text.</li>
                    <li><strong>Example Input/Output:</strong> "12" → "You target C# 12".</li>
                    <li><strong>Constraints:</strong> Validate numeric input.</li>
                    <li><strong>Hint:</strong> Use <code>decimal.TryParse</code>.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>9) Mini roadmap printer</h4>
                <ul>
                    <li><strong>Problem:</strong> Print module steps with numbering.</li>
                    <li><strong>Input/Output:</strong> Input: list of steps. Output: numbered list.</li>
                    <li><strong>Example Input/Output:</strong> ["Setup","Run"] → "1. Setup".</li>
                    <li><strong>Constraints:</strong> At least two steps.</li>
                    <li><strong>Hint:</strong> Use a for loop with index.</li>
                </ul>
            </div>
            <div class="mb-3 zoomable">
                <h4>10) Safe division helper</h4>
                <ul>
                    <li><strong>Problem:</strong> Read two numbers and divide with zero check.</li>
                    <li><strong>Input/Output:</strong> Input: a, b. Output: result or warning.</li>
                    <li><strong>Example Input/Output:</strong> 10 and 2 → "Result: 5".</li>
                    <li><strong>Constraints:</strong> b must not be zero.</li>
                    <li><strong>Hint:</strong> Use an <code>if</code> guard before division.</li>
                </ul>
            </div>
        </div>

        <h3 class="mt-4">Answers (Click to Expand)</h3>
        <details class="ans mb-2"><summary>Show Answer Code 1-2</summary><pre class="code">// 1) Warm welcome logger
Console.Write("Enter name: ");
var name = Console.ReadLine();
Console.WriteLine($"[{DateTime.Now:HH:mm}] Hello {name}");

// 2) CLI project creator helper
string project = "Demo";
Console.WriteLine($"dotnet new console -n {project}");
Console.WriteLine($"cd {project}");
Console.WriteLine("dotnet run");</pre></details>
        <details class="ans mb-2"><summary>Show Answer Code 3-4</summary><pre class="code">// 3) Architecture explainer
string[] lines = {"CLI creates", "Compiler builds", "CLR runs"};
foreach (var line in lines) Console.WriteLine(line);

// 4) Token counter
var keywords = new HashSet<string>{"int","string","class","namespace"};
string input = "int age = 3;";
var parts = input.Split(' ', StringSplitOptions.RemoveEmptyEntries);
int keywordCount = parts.Count(p => keywords.Contains(p));
int idCount = parts.Length - keywordCount - 2; // rough count minus operator and literal
Console.WriteLine($"Keywords: {keywordCount}, Identifiers: {idCount}");</pre></details>
        <details class="ans mb-2"><summary>Show Answer Code 5-6</summary><pre class="code">// 5) Friendly compiler message
string line = "Console.WriteLine(\"Hi\")";
Console.WriteLine(line.TrimEnd().EndsWith(";") ? "Looks good" : "Add ;");

// 6) Visual Studio shortcut helper
var shortcuts = new Dictionary<string,string>{{"format","Ctrl+K, Ctrl+D"},{"build","Ctrl+Shift+B"},{"comment","Ctrl+/"}};
string action = "format";
Console.WriteLine(shortcuts.TryGetValue(action, out var tip) ? tip : "Unknown");</pre></details>
        <details class="ans mb-2"><summary>Show Answer Code 7-8</summary><pre class="code">// 7) Console echo with validation
string? text = Console.ReadLine();
Console.WriteLine(string.IsNullOrWhiteSpace(text) ? "Please type something" : $"You said: {text}");

// 8) Version reporter
string ver = "12";
Console.WriteLine(decimal.TryParse(ver, out var num) ? $"You target C# {num}" : "Invalid version");</pre></details>
        <details class="ans"><summary>Show Answer Code 9-10</summary><pre class="code">// 9) Mini roadmap printer
var steps = new[]{"Setup","Run"};
for(int i=0;i<steps.Length;i++) Console.WriteLine($"{i+1}. {steps[i]}");

// 10) Safe division helper
double a = 10, b = 2;
Console.WriteLine(b == 0 ? "Cannot divide" : $"Result: {a/b}");</pre></details>
