@page "/CSharpNew/StartHappyLearning.html"
@{
    Layout = "_Layout";
    ViewData["Title"] = "C# New - C# Programming + Assignment + Use case";
    ViewData["ActiveMenu"] = "CSharpNew";
    ViewData["ActivePage"] = "Module01";
}
@section LeftMenu {
    @await Html.PartialAsync("_LeftMenu_CSharpNew", new { CurrentModule = "01" })
}

<style>
    .tt { position: relative; cursor: help; border-bottom: 1px dashed #0d6efd; }
    .tt::after { content: attr(data-tip); position: absolute; left: 0; bottom: 125%; background: #0d6efd; color: #fff; padding: 6px 8px; border-radius: 6px; opacity: 0; pointer-events: none; width: 240px; transition: opacity .2s; font-size: 0.9rem; }
    .tt:hover::after { opacity: 1; }
    .zoomable { transition: transform .25s ease; transition-delay: 3s; transform-origin: center; }
    .zoomable:hover { transform: scale(1.03); }
    .example-box { background: #f4f4f4; border: 1px solid #dcdcdc; border-radius: 8px; }
    .code-block { background: #1e1e1e; color: #e5e5e5; padding: 12px; border-radius: 10px; overflow-x: auto; }
    .toc-box { background: #eef6ff; border: 1px solid #cfe2ff; border-radius: 8px; }
    .ans pre.code { background: #1e1e1e; color: #f8f9fa; padding: 12px; border-radius: 8px; overflow-x: auto; }
</style>
