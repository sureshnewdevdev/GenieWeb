<div class="p-3 bg-light rounded-3 border">
    <h4 class="fw-bold">C# New</h4>
    <p class="text-muted mb-3">@courseSubtitle</p>
    <ol class="list-unstyled">
    @foreach (var module in modules)
    {
        <li class="mb-2">
            <a class="nav-link @(currentModule == module.No ? "fw-bold text-primary" : "")" href="@module.Route">Module @module.No: @module.Title</a>
            @if (currentModule == module.No)
            {
                <ul class="nav flex-column ms-3">
                @foreach (var sub in module.Subtopics)
                {
                    <li><a class="nav-link small" href="@($"{module.Route}#{sub.Anchor}")">@sub.Title</a></li>
                }
                </ul>
            }
        </li>
    }
    </ol>
</div>