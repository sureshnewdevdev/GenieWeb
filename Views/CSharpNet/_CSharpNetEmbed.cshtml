@model string

<div class="container-fluid py-4">
    <div class="border rounded-4 shadow-sm overflow-hidden" style="min-height: 900px; height: calc(100vh - 140px);">
        <iframe src="@Url.Content($"~/SupportFiles/CsharpNew/{Model}.html")"
                class="w-100 h-100 border-0"
                title="C#.NET @Model content"
                loading="lazy"
                referrerpolicy="no-referrer">
        </iframe>
    </div>
</div>
