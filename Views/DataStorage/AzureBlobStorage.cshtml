    <h4 class=" text-success mt-4"> Step 7: CSHTML View (ViewStudents.cshtml)</h4>
    <pre><code class="language-htmml">
        @@model List<blob_access.Models.Student>

            @@{
                ViewBag.Title = "Student List";
            }

<h2>Stored Student Records</h2>

            @@if (Model.Count > 0)
            {
        <table border="1" cellpadding="5">
        <thead>
        <tr>
        <th>Name</th>
        <th>Roll Number</th>
        <th>Total Marks</th>
                </tr>
            </thead>
