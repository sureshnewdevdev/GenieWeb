@* @{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Path to your layout page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Google AdSense script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2270827713894017"
            crossorigin="anonymous"></script>
</head>
<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="/">ItTechGenie</a>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Main Content Only (without sidebar) -->
            <main class="col-md-12 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">@ViewData["Title"]</h1>
                </div>
                <div>
                    <!-- Privacy Policy Content -->
                    <h2>Privacy Policy for IT Tech Genie</h2>
                    <p>
                        At <strong>IT Tech Genie</strong>, accessible from <strong>ittechgenie.com</strong>, we prioritize the privacy of our visitors. This Privacy Policy outlines the types of information that we collect and how we use it.
                    </p>
                    <h3>1. Information We Collect</h3>
                    <p>
                        We collect information to provide better services to all our users. The information we collect includes:
                    </p>
                    <ul>
                        <li><strong>Personal Information:</strong> Name, email address, or any other information provided voluntarily when contacting us.</li>
                        <li><strong>Non-Personal Information:</strong> IP address, browser type, and version, as well as browsing patterns and device information.</li>
                        <li><strong>Cookies:</strong> We use cookies to enhance the user experience. You may disable cookies via your browser settings.</li>
                    </ul>

                    <h3>2. How We Use Information</h3>
                    <p>
                        The information we collect may be used for:
                    </p>
                    <ul>
                        <li>Improving user experience and website content</li>
                        <li>Responding to inquiries and offering support</li>
                        <li>Sending site updates, tutorials, and promotional offers (if opted-in)</li>
                    </ul>

                    <h3>3. Third-Party Services</h3>
                    <p>
                        We may use third-party services like Google Analytics to understand how visitors interact with the site. These services may collect data, such as cookies and usage statistics, in compliance with privacy policies.
                    </p>

                    <h3>4. External Links</h3>
                    <p>
                        Our website may include links to external sites. We are not responsible for the privacy practices or content of such sites.
                    </p>

                    <h3>5. Security</h3>
                    <p>
                        We take the protection of your data seriously, but remember that no method of transmission over the Internet is completely secure. We cannot guarantee absolute data security.
                    </p>

                    <h3>6. Changes to This Policy</h3>
                    <p>
                        We may update this Privacy Policy from time to time. Changes will be posted on this page, and the policy will take effect immediately.
                    </p>

                    <h3>7. Contact Us</h3>
                    <p>
                        If you have any questions about this Privacy Policy, feel free to contact us at:
                    </p>
                    <p><strong>Email:</strong> admin@ittechgenie.com</p>
                </div>

                <!-- Google AdSense ad -->
                <div class="ads-container">
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2270827713894017"
                         data-ad-slot="3993585551"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
