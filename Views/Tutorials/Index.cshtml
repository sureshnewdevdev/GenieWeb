@model IReadOnlyList<GenieWeb.Models.TutorialDocument>
@{
    var total = Model.FirstOrDefault()?.TotalTutorials ?? 27;
}

<p class="lead">
    A @total-part learning path on building GenAI-powered applications with C# and .NET —
    from prompt engineering fundamentals through Azure OpenAI, RAG, Semantic Kernel, and
    multi-agent systems, to a real-world capstone project.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No tutorials have been published yet — check back soon.</div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var t in Model)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               href="@Url.Action("Detail", "Tutorials", new { slug = t.Slug })">
                <span>
                    <span class="badge bg-dark me-2">@t.TutorialNumber</span>
                    @t.Title
                </span>
                <span class="badge bg-secondary">@t.Level</span>
            </a>
        }
    </div>

    @if (Model.Count < total)
    {
        <p class="text-muted mt-3">@Model.Count of @total tutorials published so far — the rest are on the way.</p>
    }
}
