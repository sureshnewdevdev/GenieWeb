@{
    ViewData["Title"] = "Boards, Queries, and Charts";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <h1 class="text-center text-primary">Boards, Queries, and Charts in Azure DevOps</h1>
    <p class="lead text-center">Enhance your project management efficiency with Azure DevOps Boards, Queries, and Charts.</p>
    <hr />

    <!-- Azure Boards Overview -->
    <div class="mt-4">
        <h2 class="text-success">Azure Boards</h2>
        <p>
            Azure Boards provide interactive and customizable Kanban boards, backlogs, and sprint planning tools to help teams plan, track, and discuss work across the entire development lifecycle.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-boards-overview.jpg" alt="Azure Boards Overview" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Visualize your work with Azure Boards.</small></p>
        </div>
    </div>

    <!-- Queries Overview -->
    <div class="mt-5">
        <h2 class="text-warning">Queries in Azure DevOps</h2>
        <p>
            Queries help filter and track work items efficiently. Azure DevOps allows you to create custom queries using various filters, helping teams focus on relevant tasks and priorities.
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Flat Queries:</strong> Display work items in a simple list.</li>
            <li class="list-group-item"><strong>Tree Queries:</strong> Show hierarchical relationships between work items.</li>
            <li class="list-group-item"><strong>Direct Links Queries:</strong> Identify related work items through direct linking.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/azure-queries.jpg" alt="Azure Queries" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Create and manage queries to track work progress.</small></p>
        </div>
    </div>

    <!-- Charts Overview -->
    <div class="mt-5">
        <h2 class="text-danger">Charts in Azure DevOps</h2>
        <p>
            Charts provide a visual representation of work progress, enabling better decision-making. Azure DevOps allows teams to generate customized charts from queries to track key metrics.
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Pie Charts:</strong> Show work item distribution.</li>
            <li class="list-group-item"><strong>Bar Charts:</strong> Compare progress across different categories.</li>
            <li class="list-group-item"><strong>Trend Charts:</strong> Monitor work trends over time.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/azure-charts.jpg" alt="Azure Charts" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Visualize work progress with Azure Charts.</small></p>
        </div>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Azure Boards, Queries, and Charts are essential tools in Azure DevOps that help teams collaborate effectively, track work efficiently, and gain insights through visualization.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-overview.jpg" alt="Azure DevOps Summary" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Optimize your project management with Azure DevOps tools.</small></p>
        </div>
    </div>
</div>