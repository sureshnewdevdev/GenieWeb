@{
    ViewData["Title"] = "Cloning, Branching, and Merging";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <p class="lead text-center">Learn how to efficiently manage your code with cloning, branching, and merging techniques in Azure Repos.</p>
    <hr />

    <!-- Cloning a Repository -->
    <div class="mt-4">
        <h2 class="text-success">Cloning a Repository</h2>
        <p>
            Cloning a repository creates a local copy of the remote repository, allowing developers to work offline and commit changes later.
        </p>
        <h4>Steps to Clone a Repository:</h4>
        <ol>
            <li>Navigate to Azure Repos and select the repository you want to clone.</li>
            <li>Click on the "Clone" button and copy the HTTPS or SSH URL.</li>
            <li>Open a terminal or command prompt and use the command:</li>
            <pre><code>git clone &lt;repository-url&gt;</code></pre>
            <li>Navigate into the cloned repository and start working.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/clone-repo.jpg" alt="Cloning Repository" class="img-fluid rounded shadow-lg w-100">
        </div>
    </div>

    <!-- Branching -->
    <div class="mt-5">
        <h2 class="text-warning">Branching in Azure Repos</h2>
        <p>
            Branching allows developers to create separate workspaces for features, bug fixes, or experiments without affecting the main codebase.
        </p>
        <h4>Steps to Create a Branch:</h4>
        <ol>
            <li>Go to Azure Repos and select the repository.</li>
            <li>Click on "Branches" and select "New Branch".</li>
            <li>Enter a branch name and choose the base branch.</li>
            <li>Click "Create" and start working on the new branch.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/branching.jpg" alt="Creating a Branch" class="img-fluid rounded shadow-lg w-100">
        </div>
    </div>

    <!-- Merging -->
    <div class="mt-5">
        <h2 class="text-danger">Merging Changes</h2>
        <p>
            Merging integrates changes from one branch into another, ensuring that the latest updates are combined into the main codebase.
        </p>
        <h4>Steps to Merge a Branch:</h4>
        <ol>
            <li>Open a pull request in Azure Repos.</li>
            <li>Select the source branch and the target branch.</li>
            <li>Review changes and resolve conflicts if any.</li>
            <li>Approve and complete the merge.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/merging.jpg" alt="Merging Branches" class="img-fluid rounded shadow-lg w-100">
        </div>
    </div>

    <!-- Best Practices -->
    <div class="mt-5">
        <h2 class="text-info">Best Practices</h2>
        <ul>
            <li>Use feature branches for new developments.</li>
            <li>Commit and push changes frequently.</li>
            <li>Review and test code before merging.</li>
            <li>Resolve merge conflicts carefully.</li>
        </ul>
    </div>
</div>
