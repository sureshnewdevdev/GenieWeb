@{
    ViewData["Title"] = "Creating Repositories";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <h1 class="text-center text-primary">Creating Repositories in Azure Repos</h1>
    <p class="lead text-center">Learn how to create and manage repositories in Azure Repos for effective version control.</p>
    <hr />

    <!-- What is a Repository? -->
    <div class="mt-4">
        <h2 class="text-success">What is a Repository?</h2>
        <p>
            A repository is a storage location where the source code and revision history are managed. Azure Repos offers two types of repositories:
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Git:</strong> A distributed version control system that allows multiple developers to collaborate.</li>
            <li class="list-group-item"><strong>TFVC:</strong> A centralized version control system where all changes are tracked on a central server.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/repository-overview.jpg" alt="Repository Overview" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Repositories are essential for managing and tracking code changes.</small></p>
        </div>
    </div>

    <!-- Steps to Create a Repository -->
    <div class="mt-5">
        <h2 class="text-warning">Steps to Create a Repository in Azure Repos</h2>
        <ol class="list-group list-group-numbered">
            <li class="list-group-item">Sign in to <a href="https://dev.azure.com" target="_blank">Azure DevOps</a>.</li>
            <li class="list-group-item">Select your organization and navigate to your project.</li>
            <li class="list-group-item">Click on <strong>Repos</strong> in the left-hand menu.</li>
            <li class="list-group-item">Click <strong>New Repository</strong> and choose <strong>Git</strong> or <strong>TFVC</strong>.</li>
            <li class="list-group-item">Provide a name and description for your repository.</li>
            <li class="list-group-item">Click <strong>Create</strong> to finalize the repository setup.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/creating-repository.jpg" alt="Creating Repository" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Creating a repository is quick and easy in Azure Repos.</small></p>
        </div>
    </div>

    <!-- Best Practices -->
    <div class="mt-5">
        <h2 class="text-info">Best Practices for Managing Repositories</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Use meaningful repository names:</strong> Ensure clarity in repository purpose.</li>
            <li class="list-group-item"><strong>Organize repositories properly:</strong> Structure repositories based on projects and teams.</li>
            <li class="list-group-item"><strong>Implement proper access control:</strong> Restrict access based on roles and responsibilities.</li>
            <li class="list-group-item"><strong>Regularly backup your repository:</strong> Ensure data safety and recovery options.</li>
            <li class="list-group-item"><strong>Maintain a clean branch strategy:</strong> Use branching models like GitFlow for better collaboration.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/repository-best-practices.jpg" alt="Repository Best Practices" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Following best practices ensures efficient and secure repository management.</small></p>
        </div>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Repositories play a crucial role in version control and collaboration. Azure Repos provides a robust platform for managing repositories efficiently. By following best practices, teams can enhance productivity and maintain code quality.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/repository-summary.jpg" alt="Repository Summary" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Effective repository management is key to successful DevOps workflows.</small></p>
        </div>
    </div>
</div>
