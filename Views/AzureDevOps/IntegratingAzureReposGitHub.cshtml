@{
    ViewData["Title"] = "Integrating Azure Repos with GitHub";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <p class="lead text-center">Learn how to connect GitHub with Azure Repos to enhance your DevOps workflow.</p>
    <hr />

    <!-- Introduction -->
    <div class="mt-4">
        <h2 class="text-success">Why Integrate Azure Repos with GitHub?</h2>
        <p>
            Integrating Azure Repos with GitHub allows developers to leverage both platforms' strengths. GitHub offers a massive community and extensive collaboration tools, while Azure DevOps provides powerful CI/CD pipelines and work item tracking.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/github-azure-integration.jpg" alt="Azure Repos and GitHub Integration" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Seamless collaboration between Azure DevOps and GitHub.</small></p>
        </div>
    </div>

    <!-- Benefits of Integration -->
    <div class="mt-5">
        <h2 class="text-warning">Key Benefits</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Efficient Workflows:</strong> Automate builds and deployments using Azure Pipelines.</li>
            <li class="list-group-item"><strong>Version Control:</strong> Use GitHub for hosting repositories while leveraging Azure DevOps services.</li>
            <li class="list-group-item"><strong>Enhanced Security:</strong> Securely manage access and permissions for repositories.</li>
            <li class="list-group-item"><strong>Better Collaboration:</strong> Use GitHub pull requests with Azure Boards work items.</li>
        </ul>
    </div>

    <!-- Step-by-Step Guide -->
    <div class="mt-5">
        <h2 class="text-danger">Step-by-Step Integration</h2>
        <ol class="list-group list-group-numbered">
            <li class="list-group-item">Go to <a href="https://dev.azure.com/" target="_blank">Azure DevOps</a> and sign in.</li>
            <li class="list-group-item">Create or open an existing Azure DevOps project.</li>
            <li class="list-group-item">Navigate to "Project Settings" and select "Service Connections."</li>
            <li class="list-group-item">Click "New service connection" and choose "GitHub."</li>
            <li class="list-group-item">Authenticate using your GitHub account.</li>
            <li class="list-group-item">Select the repository you want to integrate.</li>
            <li class="list-group-item">Save the connection and use it in Azure Pipelines.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/github-azure-setup.jpg" alt="Setting up GitHub Integration in Azure" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Connecting GitHub to Azure DevOps in a few simple steps.</small></p>
        </div>
    </div>

    <!-- Best Practices -->
    <div class="mt-5">
        <h2 class="text-info">Best Practices</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Use Webhooks:</strong> Automate workflows by setting up GitHub webhooks in Azure Pipelines.</li>
            <li class="list-group-item"><strong>Enable Two-Factor Authentication:</strong> Enhance security for GitHub and Azure DevOps accounts.</li>
            <li class="list-group-item"><strong>Manage Access Properly:</strong> Use Azure DevOps permissions and GitHub branch protection rules.</li>
        </ul>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Integrating Azure Repos with GitHub improves development efficiency and streamlines DevOps workflows. By following best practices, teams can ensure a secure and scalable setup that enhances collaboration and deployment automation.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/github-azure-conclusion.jpg" alt="Final Thoughts on GitHub and Azure Integration" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Enhance your DevOps workflow with GitHub and Azure DevOps integration.</small></p>
        </div>
    </div>
</div>