@{
    ViewData["Title"] = "Key Azure DevOps Services";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <h1 class="text-center text-primary">Key Azure DevOps Services</h1>
    <p class="text-center lead">Azure DevOps provides a comprehensive suite of development tools for planning, developing, testing, and delivering software efficiently.</p>
    <hr />

    <!-- Azure Boards -->
    <div class="mt-4">
        <h2 class="text-success">Azure Boards</h2>
        <p>
            Azure Boards offers agile planning and tracking tools, including Kanban boards, backlogs, and dashboards, helping teams to efficiently manage their projects.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-boards.jpg" alt="Azure Boards" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Manage work effectively with Azure Boards.</small></p>
        </div>
    </div>

    <!-- Azure Repos -->
    <div class="mt-5">
        <h2 class="text-warning">Azure Repos</h2>
        <p>
            Azure Repos provides Git repositories for version control, enabling teams to collaborate and maintain source code efficiently with branching, pull requests, and code reviews.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-repos.jpg" alt="Azure Repos" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Collaborate on code with Azure Repos.</small></p>
        </div>
    </div>

    <!-- Azure Pipelines -->
    <div class="mt-5">
        <h2 class="text-danger">Azure Pipelines</h2>
        <p>
            Azure Pipelines enables continuous integration and continuous deployment (CI/CD) to build, test, and deploy applications efficiently across multiple platforms.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-pipelines.jpg" alt="Azure Pipelines" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Automate your deployments with Azure Pipelines.</small></p>
        </div>
    </div>

    <!-- Azure Test Plans -->
    <div class="mt-5">
        <h2 class="text-info">Azure Test Plans</h2>
        <p>
            Azure Test Plans provides a rich set of tools for manual and exploratory testing, ensuring high-quality applications with detailed tracking and reporting.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-test-plans.jpg" alt="Azure Test Plans" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Ensure software quality with Azure Test Plans.</small></p>
        </div>
    </div>

    <!-- Azure Artifacts -->
    <div class="mt-5">
        <h2 class="text-primary">Azure Artifacts</h2>
        <p>
            Azure Artifacts simplifies package management by allowing teams to create, host, and share packages from public and private sources with built-in security and scalability.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-artifacts.jpg" alt="Azure Artifacts" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Manage and share packages with Azure Artifacts.</small></p>
        </div>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Azure DevOps offers a robust set of services that streamline the software development lifecycle. By leveraging these tools, teams can enhance collaboration, improve productivity, and accelerate software delivery.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-devops-overview.jpg" alt="Azure DevOps" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Azure DevOps empowers organizations with seamless development workflows.</small></p>
        </div>
    </div>
</div>
