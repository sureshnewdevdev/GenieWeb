@{
    ViewData["Title"] = "Role-Based Access Control (RBAC) in Azure DevOps";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <p class="lead text-center">Learn how RBAC enhances security and access management in Azure DevOps.</p>
    <hr />

    <!-- Introduction -->
    <div class="mt-4">
        <h2 class="text-success">What is RBAC?</h2>
        <p>
            Role-Based Access Control (RBAC) is a security model that restricts system access based on user roles.
            It ensures that only authorized users can access specific resources and perform designated actions in Azure DevOps.
        </p>
        <p>
            RBAC enhances security by minimizing unnecessary access privileges and enforcing the principle of least privilege.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/rbac-overview.jpg" alt="RBAC Overview" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>RBAC helps manage user permissions effectively.</small></p>
        </div>
    </div>

    <!-- Benefits of RBAC -->
    <div class="mt-5">
        <h2 class="text-warning">Benefits of RBAC in Azure DevOps</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Enhanced Security:</strong> Reduces unauthorized access to critical resources.</li>
            <li class="list-group-item"><strong>Compliance & Governance:</strong> Helps meet security standards and regulatory compliance.</li>
            <li class="list-group-item"><strong>Operational Efficiency:</strong> Simplifies user role management and permissions assignment.</li>
            <li class="list-group-item"><strong>Minimized Risk:</strong> Restricts permissions to only what is necessary for each role.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/rbac-benefits.jpg" alt="Benefits of RBAC" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>RBAC improves security and efficiency in DevOps environments.</small></p>
        </div>
    </div>

    <!-- Key Roles in RBAC -->
    <div class="mt-5">
        <h2 class="text-danger">Key Roles in RBAC</h2>
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Role</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Project Administrator</td>
                    <td>Manages all settings, security policies, and permissions for the project.</td>
                </tr>
                <tr>
                    <td>Contributor</td>
                    <td>Has access to repositories, pipelines, and work items but with limited permissions.</td>
                </tr>
                <tr>
                    <td>Reader</td>
                    <td>Can view resources but cannot make changes.</td>
                </tr>
                <tr>
                    <td>Build Administrator</td>
                    <td>Manages build and release pipelines.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Implementing RBAC in Azure DevOps -->
    <div class="mt-5">
        <h2 class="text-info">How to Implement RBAC in Azure DevOps</h2>
        <ol class="list-group list-group-numbered">
            <li class="list-group-item">Navigate to Azure DevOps Organization Settings.</li>
            <li class="list-group-item">Select "Permissions" and choose the relevant project.</li>
            <li class="list-group-item">Assign users to predefined roles such as Contributor, Reader, or Administrator.</li>
            <li class="list-group-item">Apply security policies to enforce access control.</li>
            <li class="list-group-item">Review and update permissions regularly.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/rbac-implementation.jpg" alt="Implementing RBAC" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Follow these steps to enforce RBAC in Azure DevOps.</small></p>
        </div>
    </div>

    <!-- Best Practices for RBAC -->
    <div class="mt-5">
        <h2 class="text-secondary">Best Practices for RBAC</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Apply Least Privilege:</strong> Grant users only the permissions they need.</li>
            <li class="list-group-item"><strong>Use Groups Instead of Individual Users:</strong> Simplifies permission management.</li>
            <li class="list-group-item"><strong>Audit Access Regularly:</strong> Ensure permissions align with organizational needs.</li>
            <li class="list-group-item"><strong>Enable Multi-Factor Authentication (MFA):</strong> Adds an extra layer of security.</li>
        </ul>
        <div class="text-center my-3">
            <img src="https://example.com/rbac-best-practices.jpg" alt="RBAC Best Practices" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Following best practices ensures robust security.</small></p>
        </div>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            RBAC is a critical component in Azure DevOps security management. By defining roles and access levels, organizations can maintain security, compliance, and efficiency while preventing unauthorized access to sensitive resources.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/rbac-summary.jpg" alt="RBAC Summary" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Effective RBAC implementation strengthens security in Azure DevOps.</small></p>
        </div>
    </div>
</div>
