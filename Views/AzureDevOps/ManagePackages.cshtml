@{
    ViewData["Title"] = "Managing Packages in Azure Artifacts";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <p class="lead text-center">Learn how to manage and distribute packages using Azure Artifacts for efficient development workflows.</p>
    <hr />

    <!-- Introduction -->
    <div class="mt-4">
        <h2 class="text-success">What is Azure Artifacts?</h2>
        <p>
            Azure Artifacts is a package management service within Azure DevOps that allows teams to create, host, and share packages across different development projects. It supports multiple package formats, including NuGet, npm, Maven, Python, and Universal Packages.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/azure-artifacts.jpg" alt="Azure Artifacts Overview" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Azure Artifacts simplifies package management across teams.</small></p>
        </div>
    </div>

    <!-- Benefits of Azure Artifacts -->
    <div class="mt-5">
        <h2 class="text-warning">Why Use Azure Artifacts?</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Centralized Package Management:</strong> Host and share packages securely across your organization.</li>
            <li class="list-group-item"><strong>Seamless CI/CD Integration:</strong> Easily integrate with Azure Pipelines for automated deployments.</li>
            <li class="list-group-item"><strong>Multi-Format Support:</strong> Works with multiple package types (NuGet, npm, Maven, etc.).</li>
            <li class="list-group-item"><strong>Access Control:</strong> Define permissions and ensure secure access to packages.</li>
        </ul>
    </div>

    <!-- Setting Up Azure Artifacts -->
    <div class="mt-5">
        <h2 class="text-danger">How to Set Up and Manage Packages</h2>
        <ol class="list-group list-group-numbered">
            <li class="list-group-item">Go to <strong>Azure DevOps</strong> and navigate to "Artifacts".</li>
            <li class="list-group-item">Click on "Create Feed" to set up a new package feed.</li>
            <li class="list-group-item">Choose visibility options (public or private) and configure feed settings.</li>
            <li class="list-group-item">Connect to the feed using a supported package manager (NuGet, npm, Maven, etc.).</li>
            <li class="list-group-item">Publish or consume packages directly within your projects.</li>
        </ol>
        <div class="text-center my-3">
            <img src="https://example.com/setup-artifacts.jpg" alt="Setting Up Azure Artifacts" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Setting up and managing packages in Azure Artifacts.</small></p>
        </div>
    </div>

    <!-- Best Practices -->
    <div class="mt-5">
        <h2 class="text-info">Best Practices for Package Management</h2>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Use Scoped Feeds:</strong> Organize packages by project or team to improve efficiency.</li>
            <li class="list-group-item"><strong>Automate Package Publishing:</strong> Set up CI/CD pipelines for automated publishing.</li>
            <li class="list-group-item"><strong>Enforce Versioning:</strong> Use semantic versioning to manage package updates effectively.</li>
            <li class="list-group-item"><strong>Implement Access Control:</strong> Restrict package access based on user roles.</li>
        </ul>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Azure Artifacts is a powerful package management solution that enhances collaboration and efficiency in development workflows. By following best practices, teams can ensure secure, scalable, and seamless package distribution across projects.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/conclusion-artifacts.jpg" alt="Azure Artifacts Summary" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Efficient package management ensures smooth project workflows.</small></p>
        </div>
    </div>
</div>
