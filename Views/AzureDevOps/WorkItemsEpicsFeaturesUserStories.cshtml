        <a href="@Url.Action("IntroductionToAgileScrum", "AzureDevOps")" class="btn btn-outline-secondary">&larr; Previous: Introduction to Agile & Scrum</a>
        <a href="@Url.Action("SprintPlanningBacklogManagement", "AzureDevOps")" class="btn btn-outline-secondary">Next: Sprint Planning & Backlog Management &rarr;</a>
    </div>
</div>