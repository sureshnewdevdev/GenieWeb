@{
    ViewData["Title"] = "Work Items, Epics, Features, and User Stories";
    ViewData["ActiveMenu"] = "AzureDevOps";
}

<div class="container py-4">
    <h1 class="text-center text-primary">Work Items, Epics, Features, and User Stories</h1>
    <p class="lead text-center">Understanding the different work items in Azure DevOps and how they contribute to Agile project management.</p>
    <hr />

    <!-- Work Items Overview -->
    <div class="mt-4">
        <h2 class="text-success">What are Work Items?</h2>
        <p>
            Work items in Azure DevOps are the fundamental tracking units used to manage projects efficiently. They help teams track tasks, bugs, user stories, and other elements of software development.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/work-items-overview.jpg" alt="Work Items Overview" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Work Items in Azure DevOps streamline project tracking.</small></p>
        </div>
    </div>

    <!-- Epics -->
    <div class="mt-5">
        <h2 class="text-warning">Epics</h2>
        <p>
            Epics represent large work items that span multiple sprints. They help in grouping related features and user stories to achieve strategic objectives.
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">Used to manage broad project goals.</li>
            <li class="list-group-item">Typically broken down into multiple Features.</li>
            <li class="list-group-item">Provide a high-level view of the project roadmap.</li>
        </ul>
    </div>

    <!-- Features -->
    <div class="mt-5">
        <h2 class="text-info">Features</h2>
        <p>
            Features are a subset of Epics and describe significant functionalities of the system. They help in defining a roadmap for delivering value to end users.
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">Smaller than Epics but larger than User Stories.</li>
            <li class="list-group-item">Help in breaking down development tasks into manageable parts.</li>
            <li class="list-group-item">Usually span multiple User Stories.</li>
        </ul>
    </div>

    <!-- User Stories -->
    <div class="mt-5">
        <h2 class="text-danger">User Stories</h2>
        <p>
            User Stories capture a specific requirement from an end user's perspective. They define what the user wants and why it is important.
        </p>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">Written in a simple, concise format.</li>
            <li class="list-group-item">Follows the format: "As a [user], I want [goal] so that [benefit]."</li>
            <li class="list-group-item">Used as a basis for discussion and implementation.</li>
        </ul>
    </div>

    <!-- Conclusion -->
    <div class="mt-5">
        <h2 class="text-secondary">Conclusion</h2>
        <p>
            Understanding Work Items, Epics, Features, and User Stories is crucial for managing Agile projects effectively in Azure DevOps. These elements ensure a structured workflow and improve collaboration among development teams.
        </p>
        <div class="text-center my-3">
            <img src="https://example.com/agile-process.jpg" alt="Agile Process" class="img-fluid rounded shadow-lg w-100">
            <p class="text-muted mt-2"><small>Azure DevOps provides structured work management for Agile teams.</small></p>
        </div>
    </div>
</div>
