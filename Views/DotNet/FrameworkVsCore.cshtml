@{
    ViewData["Title"] = ".NET Framework vs .NET Core vs .NET 5+";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "FrameworkVsCore";
}

<div class="container py-4">
    <p class="text-center lead">
        Understanding the differences between .NET Framework, .NET Core, and .NET 5+ helps you choose the right technology for your project. Here’s a beginner-friendly comparison.
    </p>
    <hr />

    <!-- Section: Overview -->
    <div class="mt-5">
        <h2>Three Flavors of .NET</h2>
        <p>.NET has evolved into three main branches, each with its own strengths and purposes:</p>
        <ul>
            <li><strong>.NET Framework:</strong> The original, Windows-only version</li>
            <li><strong>.NET Core:</strong> A cross-platform, open-source alternative</li>
            <li><strong>.NET 5 and later:</strong> A unified platform combining both worlds</li>
        </ul>
    </div>

    <!-- Section: Comparison Table -->
    <div class="mt-5">
        <h3>Feature Comparison</h3>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Feature</th>
                        <th>.NET Framework</th>
                        <th>.NET Core</th>
                        <th>.NET 5+</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Platform Support</td>
                        <td>Windows only</td>
                        <td>Windows, Linux, macOS</td>
                        <td>Cross-platform</td>
                    </tr>
                    <tr>
                        <td>App Types</td>
                        <td>Desktop, Web (ASP.NET)</td>
                        <td>Web, APIs, Microservices</td>
                        <td>All (Web, Mobile, Desktop, Cloud, IoT)</td>
                    </tr>
                    <tr>
                        <td>Open Source</td>
                        <td>Partially</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td>Performance</td>
                        <td>Moderate</td>
                        <td>High</td>
                        <td>Very High</td>
                    </tr>
                    <tr>
                        <td>Latest Support</td>
                        <td>Maintenance Mode</td>
                        <td>Last version was 3.1 (LTS)</td>
                        <td>Current and future direction</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section: Use Cases -->
    <div class="mt-5">
        <h3>When to Use What?</h3>
        <ul>
            <li><strong>.NET Framework:</strong> Only if you're maintaining legacy Windows apps.</li>
            <li><strong>.NET Core:</strong> Good for cross-platform web apps and microservices (use .NET 6+ for new projects).</li>
            <li><strong>.NET 5+ (.NET 6, .NET 7, .NET 8):</strong> Best for modern apps. Supports all types of workloads.</li>
        </ul>
    </div>

    <!-- Section: Code Consistency -->
    <div class="mt-5">
        <h3>Same Language, Better Tools</h3>
        <p>No matter the flavor, you use the same C# language, syntax, and base libraries. Here's a simple example that works across all versions:</p>

        <div class="code-snippet bg-light p-3 rounded position-relative">
            <pre class="mb-0"><code>// Simple program compatible across versions
using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Running on .NET!");
    }
}</code></pre>
            <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
        </div>
    </div>

    <!-- Summary -->
    <div class="mt-5">
        <p>
            If you're starting fresh, use <strong>.NET 6 or .NET 8</strong>. They're fast, modern, and fully supported. The future of .NET is unified — cross-platform development from one base.
        </p>
    </div>

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-between mt-4">
        <a href="@Url.Action("Evolution", "DotNet")" class="btn btn-outline-secondary">
            &larr; Previous: Evolution of the .NET Platform
        </a>
        <a href="@Url.Action("DotNetEcosystem", "DotNet")" class="btn btn-outline-secondary">
            Next: Overview of the .NET Ecosystem &rarr;
        </a>
    </div>
</div>

<script>
    document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const codeText = this.parentElement.querySelector('code')?.innerText;
            if (codeText) {
                navigator.clipboard.writeText(codeText).then(() => {
                    alert('Code copied to clipboard!');
                });
            }
        });
    });
</script>
