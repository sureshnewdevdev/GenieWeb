@{
    ViewData["Title"] = ".NET Core History";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "DotNetCoreHistory";
}

<div class="container py-4">
    <h1 class="mb-3">From .NET Core 1.0 to the unified .NET</h1>
    <p class="lead">A concise timeline that highlights the milestones leading to today&rsquo;s unified .NET platform.</p>

    <div class="p-4 bg-white border rounded-4 shadow-sm">
        <ul class="mb-0 timeline list-unstyled">
            <li class="mb-3">
                <strong>2016:</strong> <span class="text-muted">.NET Core 1.0</span> ships with cross-platform ASP.NET Core and CLI tooling.
            </li>
            <li class="mb-3">
                <strong>2017:</strong> <span class="text-muted">.NET Core 2.0</span> expands API surface area and adds Razor Pages for page-focused web apps.
            </li>
            <li class="mb-3">
                <strong>2019:</strong> <span class="text-muted">.NET Core 3.x</span> introduces Windows desktop support (WPF/WinForms) and gRPC for high-speed RPC.
            </li>
            <li class="mb-3">
                <strong>2020:</strong> <span class="text-muted">.NET 5</span> begins the unification journey, merging Core + Framework into a single product line.
            </li>
            <li class="mb-3">
                <strong>2021:</strong> <span class="text-muted">.NET 6 (LTS)</span> ships with minimal APIs, Hot Reload, and long-term support through Nov 2024.
            </li>
            <li class="mb-3">
                <strong>2022-2024:</strong> <span class="text-muted">.NET 7/8</span> deliver cloud-native improvements (rate limiting middleware, output caching) and trimming/AOT enhancements.
            </li>
        </ul>
    </div>

    <div class="mt-4 p-4 bg-light border rounded-3">
        <h2 class="h5">Why this matters for teams</h2>
        <ul class="mb-0">
            <li><strong>Predictable cadence:</strong> yearly releases with clear LTS/STS labels simplify upgrade planning.</li>
            <li><strong>API consistency:</strong> the same BCL across app types reduces code divergence between services and tools.</li>
            <li><strong>Deployment flexibility:</strong> self-contained and trimmed publishes keep artifacts small and portable.</li>
        </ul>
    </div>
</div>
