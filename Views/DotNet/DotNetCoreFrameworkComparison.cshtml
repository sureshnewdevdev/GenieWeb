@{
    ViewData["Title"] = ".NET Core vs .NET Framework";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "DotNetCoreFrameworkComparison";
}

<div class="container py-4">
    <h1 class="mb-3">How .NET Core differs from .NET Framework</h1>
    <p class="lead">Key distinctions that help you choose the right runtime for new applications or modernization projects.</p>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Aspect</th>
                    <th>.NET Core</th>
                    <th>.NET Framework</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Platform reach</td>
                    <td>Windows, Linux, macOS; great in containers and cloud-native stacks.</td>
                    <td>Windows-only; ideal for legacy desktop and on-premises enterprise apps.</td>
                </tr>
                <tr>
                    <td>Deployment</td>
                    <td>Self-contained or framework-dependent, side-by-side versions, small images.</td>
                    <td>Machine-wide installation; version upgrades impact all apps on the host.</td>
                </tr>
                <tr>
                    <td>API surface</td>
                    <td>Modern BCL, Span/Memory, minimal APIs, gRPC, performance-focused libraries.</td>
                    <td>Broader Windows desktop stack (WCF, WebForms, WF) but slower innovation pace.</td>
                </tr>
                <tr>
                    <td>Tooling cadence</td>
                    <td>Yearly releases with LTS/STS; monthly servicing.</td>
                    <td>Servicing only; no new feature investments for most workloads.</td>
                </tr>
                <tr>
                    <td>Best fit</td>
                    <td>New cloud services, microservices, cross-platform CLIs, and high-scale APIs.</td>
                    <td>Existing Windows-only apps that rely on WebForms, WCF, or full-trust scenarios.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="mt-4 p-4 bg-light border rounded-3">
        <h2 class="h5">Migration tips</h2>
        <ul class="mb-0">
            <li>Start by upgrading libraries to <code>netstandard2.0</code> or <code>net8.0</code> compatible packages.</li>
            <li>Split monoliths gradually: move APIs or background jobs to .NET Core while keeping UI layers stable.</li>
            <li>Use compatibility analyzers (<code>try-convert</code>, <code>upgrade-assistant</code>) to identify API gaps.</li>
        </ul>
    </div>
</div>
