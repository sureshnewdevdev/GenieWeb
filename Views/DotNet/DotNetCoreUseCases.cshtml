@{
    ViewData["Title"] = ".NET Core Use Cases";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "DotNetCoreUseCases";
}

<div class="container py-4">
    <h1 class="mb-3">Where .NET Core fits best</h1>
    <p class="lead">Examples of production scenarios that benefit from .NET Core&rsquo;s performance, tooling, and cross-platform reach.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">API-first platforms</h2>
                <ul>
                    <li>High-throughput REST or gRPC gateways with rate limiting and caching middleware.</li>
                    <li>Real-time dashboards using SignalR for live telemetry and notifications.</li>
                    <li>Integration hubs that call third-party services with Polly-based resilience policies.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Background and data work</h2>
                <ul>
                    <li>Workers that stream data from queues (Azure Service Bus, Kafka) and write to databases.</li>
                    <li>Batch jobs for ETL, PDF/image processing, or nightly reconciliation tasks.</li>
                    <li>Observability-friendly daemons exposing metrics endpoints for Prometheus/Grafana.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Cloud &amp; edge deployments</h2>
                <ul>
                    <li>Microservices packaged as containers and deployed to AKS, Kubernetes, or Azure Container Apps.</li>
                    <li>Lightweight ARM64 builds for edge devices and gateways using trimmed/self-contained publishes.</li>
                    <li>Serverless APIs and timed jobs executed in Azure Functions with isolated worker model.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Enterprise applications</h2>
                <ul>
                    <li>Line-of-business portals that share domain models between MVC pages and APIs.</li>
                    <li>Event-driven systems leveraging MediatR, CQRS patterns, and EF Core migrations.</li>
                    <li>Hybrid workloads that integrate Azure AD for identity and Power BI for analytics.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
