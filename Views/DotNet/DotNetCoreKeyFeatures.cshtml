@{
    ViewData["Title"] = ".NET Core Key Features";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "DotNetCoreKeyFeatures";
}

<div class="container py-4">
    <h1 class="mb-3">.NET Core feature set</h1>
    <p class="lead">A closer look at the platform capabilities that help teams build secure, high-performing applications quickly.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Runtime and performance</h2>
                <ul>
                    <li><strong>Tiered compilation:</strong> balances startup speed with long-running throughput.</li>
                    <li><strong>Hardware intrinsics:</strong> SIMD APIs for vectorization and lower CPU usage.</li>
                    <li><strong>Span/Memory types:</strong> safer, allocation-friendly APIs for handling buffers and strings.</li>
                    <li><strong>ReadyToRun (R2R) images:</strong> pre-compiles IL to native code for faster cold starts.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Developer productivity</h2>
                <ul>
                    <li><strong>Unified SDK:</strong> one CLI (<code>dotnet</code>) for new projects, builds, tests, and publishing.</li>
                    <li><strong>Hot reload:</strong> refresh UI and API logic during development without restarting.</li>
                    <li><strong>Minimal APIs:</strong> concise syntax for small services and serverless workloads.</li>
                    <li><strong>Rich diagnostics:</strong> built-in logging, counters, and OpenTelemetry exporters.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Security and reliability</h2>
                <ul>
                    <li><strong>Managed memory model:</strong> automatic GC and type safety reduce common vulnerabilities.</li>
                    <li><strong>Secret management:</strong> integration with Key Vault, user secrets, and environment variables.</li>
                    <li><strong>HTTPS by default:</strong> templates include Kestrel + HTTPS redirection and HSTS.</li>
                    <li><strong>Regular servicing:</strong> monthly updates and predictable LTS cadences.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Cloud and container readiness</h2>
                <ul>
                    <li><strong>Optimized base images:</strong> official ASP.NET and runtime images stay small for faster pulls.</li>
                    <li><strong>Observability hooks:</strong> health checks, metrics, and logging endpoints for orchestrators.</li>
                    <li><strong>Scalable hosting:</strong> works with Kestrel behind Nginx/Apache, Azure Front Door, or load balancers.</li>
                    <li><strong>Configuration flexibility:</strong> layered config from JSON, environment variables, and secrets.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
