@{
    ViewData["Title"] = "Creating and Using Classes";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "UsingClasses";
}

<div class="container py-4">
    <p class="text-center lead">
        Classes are core to object-oriented programming in C#. In console applications, you can define and use your own classes to encapsulate data and logic, making your code cleaner and more reusable.
    </p>
    <hr />

    <!-- Section: What is a Class? -->
    <div class="mt-5">
        <h2>What is a Class?</h2>
        <p>
            A class is a blueprint for objects. It defines properties (data) and methods (behavior). You can create multiple objects (instances) from a single class definition.
        </p>

        <div class="code-snippet bg-light p-3 rounded position-relative">
            <pre class="mb-0"><code>public class Person
{
    public string Name;
    public int Age;

    public void Introduce()
    {
        Console.WriteLine($"Hi, I'm {Name} and I'm {Age} years old.");
    }
}</code></pre>
            <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
        </div>
    </div>

    <!-- Section: Creating Objects -->
    <div class="mt-5">
        <h3>Creating and Using an Object</h3>
        <p>Here’s how you can create an object of the class and use its members:</p>

        <div class="code-snippet bg-light p-3 rounded position-relative">
            <pre class="mb-0"><code>Person person = new Person();
person.Name = "Alice";
person.Age = 30;
person.Introduce();</code></pre>
            <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
        </div>
    </div>

    <!-- Section: Constructors -->
    <div class="mt-5">
        <h3>Using Constructors</h3>
        <p>
            A constructor is a special method that runs when an object is created. Use it to initialize values.
        </p>
        <div class="code-snippet bg-light p-3 rounded position-relative">
            <pre class="mb-0"><code>public class Book
{
    public string Title;
    public string Author;

    public Book(string title, string author)
    {
        Title = title;
        Author = author;
    }
}

Book b = new Book("C# Basics", "Jane Doe");
Console.WriteLine(b.Title);</code></pre>
            <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
        </div>
    </div>

    <!-- Section: Access Modifiers -->
    <div class="mt-5">
        <h3>Access Modifiers</h3>
        <p>
            Access modifiers control how a class or its members can be accessed:
        </p>
        <ul>
            <li><code>public</code> – accessible from anywhere</li>
            <li><code>private</code> – accessible only within the class</li>
            <li><code>protected</code> – accessible from the class and its subclasses</li>
            <li><code>internal</code> – accessible within the same project/assembly</li>
        </ul>
    </div>

    <!-- Section: Best Practices -->
    <div class="mt-5">
        <h3>Best Practices for Defining Classes</h3>
        <ul>
            <li>Use PascalCase for class and method names</li>
            <li>Group related logic into separate classes (e.g., <code>Customer</code>, <code>Order</code>)</li>
            <li>Encapsulate data using properties instead of public fields</li>
            <li>Keep classes focused on a single responsibility</li>
        </ul>
    </div>

    <!-- Summary -->
    <div class="mt-5">
        <p>
            Classes allow you to write modular and reusable code. In the next lesson, we’ll cover how to perform input and output operations in console applications, including reading from the user and writing to files.
        </p>
    </div>

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-between mt-4">
        <a href="@Url.Action("NamespacesReferences", "DotNet")" class="btn btn-outline-secondary">
            &larr; Previous: Namespaces and References
        </a>
        <a href="@Url.Action("InputOutput", "DotNet")" class="btn btn-outline-secondary">
            Next: Handling Input/Output &rarr;
        </a>
    </div>
</div>

<script>
    document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const codeText = this.parentElement.querySelector('code')?.innerText;
            if (codeText) {
                navigator.clipboard.writeText(codeText).then(() => {
                    alert('Code copied to clipboard!');
                });
            }
        });
    });
</script>
