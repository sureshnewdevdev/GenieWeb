@{
    ViewData["Title"] = "Modern .NET (5/6/7/8)";
    ViewData["ActiveMenu"] = "DotNetCore";
    ViewData["ActivePage"] = "DotNetCoreModernNet";
}

<div class="container py-4">
    <h1 class="mb-3">Transition to modern .NET</h1>
    <p class="lead">Planning guidance for moving from .NET Framework or early .NET Core versions to the current unified releases.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Upgrade checkpoints</h2>
                <ol class="mb-0">
                    <li>Inventory dependencies and confirm NuGet packages support <code>net6.0</code> or later.</li>
                    <li>Adopt the generic host (<code>Host.CreateDefaultBuilder</code>) for unified DI, logging, and config.</li>
                    <li>Enable nullable reference types and analyzers to harden your codebase during the move.</li>
                    <li>Use <code>dotnet publish --self-contained</code> or <code>--runtime linux-x64</code> for portable artifacts.</li>
                </ol>
            </div>
        </div>

        <div class="col-md-6">
            <div class="h-100 p-4 bg-white border rounded-4 shadow-sm">
                <h2 class="h5">Performance-focused steps</h2>
                <ul class="mb-0">
                    <li>Enable crossgen or ReadyToRun for services with strict cold-start requirements.</li>
                    <li>Use <code>dotnet-counters</code>, <code>dotnet-trace</code>, and OpenTelemetry for live diagnostics.</li>
                    <li>Trim unused code paths (<code>PublishTrimmed=true</code>) for leaner images where reflection allows.</li>
                    <li>Adopt output caching, rate limiting middleware, and AOT (where applicable) for API workloads.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="mt-4 p-4 bg-light border rounded-3">
        <h2 class="h5">Support timelines</h2>
        <p class="mb-2">Target LTS versions (.NET 6, .NET 8) for production stability and long-term patching.</p>
        <ul class="mb-0">
            <li>.NET 6 LTS: supported through November 2024.</li>
            <li>.NET 8 LTS: supported through November 2026.</li>
            <li>Adopt STS (current) releases in non-critical workloads to test new platform capabilities early.</li>
        </ul>
    </div>
</div>
