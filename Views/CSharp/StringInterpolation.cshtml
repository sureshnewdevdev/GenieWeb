@{
    ViewData["Title"] = "String Interpolation in C#";
}

<!-- Section: Introduction -->
<section class="mb-5">
    <h2 class="text-secondary">Understanding String Interpolation in C#</h2>
    <p class="lead">
        **String Interpolation** in C# provides an easy way to format strings by embedding expressions inside **interpolated strings** using the `$` symbol. It enhances readability and eliminates the need for **string concatenation or String.Format()**.
    </p>
</section>

<!-- Section: Key Features of String Interpolation -->
<section class="mb-5">
    <h2 class="text-secondary">Key Features of String Interpolation</h2>
    <ul class="list-group">
        <li class="list-group-item">Uses **$""** syntax to embed expressions inside strings.</li>
        <li class="list-group-item">Improves **code readability** over traditional string formatting.</li>
        <li class="list-group-item">Supports **expressions, method calls, and calculations** inside strings.</li>
        <li class="list-group-item">Works with **formatting options**, such as numbers and dates.</li>
    </ul>
</section>

<!-- Section: Basic String Interpolation -->
<section class="mb-5">
    <h2 class="text-secondary">Basic String Interpolation</h2>
    <p class="lead">
        Using **$""** allows variables and expressions to be embedded inside strings.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Using String Interpolation with Variables</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;

class Program
{
    static void Main()
    {
        string name = "Alice";
        int age = 25;

        Console.WriteLine($"Hello, my name is {name} and I am {age} years old.");
    }
}

// Output:
// Hello, my name is Alice and I am 25 years old.</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        The **$""** syntax allows embedding `name` and `age` directly inside the string.
    </p>
</section>

<!-- Section: Using Expressions and Method Calls -->
<section class="mb-5">
    <h2 class="text-secondary">Using Expressions and Method Calls Inside Interpolated Strings</h2>
    <p class="lead">
        You can **perform calculations** and **call methods** inside interpolated strings.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: String Interpolation with Expressions</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;

class Program
{
    static void Main()
    {
        int a = 10, b = 5;
        Console.WriteLine($"The sum of {a} and {b} is {a + b}");
        Console.WriteLine($"Uppercase: {"hello".ToUpper()}");
    }
}

// Output:
// The sum of 10 and 5 is 15
// Uppercase: HELLO</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        Expressions like `{a + b}` and method calls like `{"hello".ToUpper()}` can be used inside interpolated strings.
    </p>
</section>

<!-- Section: Formatting Dates and Numbers -->
<section class="mb-5">
    <h2 class="text-secondary">Formatting Dates and Numbers in Interpolated Strings</h2>
    <p class="lead">
        String Interpolation supports **format specifiers** for dates, currency, and decimals.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Formatting Dates and Numbers</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;

class Program
{
    static void Main()
    {
        DateTime today = DateTime.Now;
        double price = 99.99;

        Console.WriteLine($"Today's date: {today:MMMM dd, yyyy}");
        Console.WriteLine($"Price: {price:C}");
    }
}

// Output:
// Today's date: March 19, 2025
// Price: $99.99</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        **Format specifiers** like `{today:MMMM dd, yyyy}` (long date) and `{price:C}` (currency) are supported in interpolated strings.
    </p>
</section>

<!-- Section: Escaping Braces in Interpolated Strings -->
<section class="mb-5">
    <h2 class="text-secondary">Escaping Braces in Interpolated Strings</h2>
    <p class="lead">
        To print **curly braces** (`{}`) inside an interpolated string, use **double braces** (`{{` and `}}`).
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Escaping Curly Braces in Interpolated Strings</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;

class Program
{
    static void Main()
    {
        Console.WriteLine($"{{This is inside curly braces}}");
    }
}

// Output:
// {This is inside curly braces}</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        Use **double curly braces** `{{` and `}}` to print braces inside an interpolated string.
    </p>
</section>

<!-- Section: Best Practices for String Interpolation -->
<section class="mb-5">
    <h2 class="text-secondary">Best Practices for Using String Interpolation</h2>
    <ul class="list-group">
        <li class="list-group-item">Use **string interpolation instead of string concatenation** for better readability.</li>
        <li class="list-group-item">Use **format specifiers** for numbers, dates, and currency when needed.</li>
        <li class="list-group-item">Avoid **complex logic inside interpolated expressions**—use separate variables for clarity.</li>
        <li class="list-group-item">Use **double braces** (`{{ }}`) when you need to display `{}` in output.</li>
    </ul>
</section>

