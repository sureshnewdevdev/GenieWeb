        public int LoyaltyPoints { get; set; } = 1200;                // property 3

        public string FormatDisplay(string prefix, string suffix)     // method to invoke
            =&gt; $&quot;{prefix} {FullName} ({LoyaltyPoints}) {suffix}&quot;;     // formatted output
