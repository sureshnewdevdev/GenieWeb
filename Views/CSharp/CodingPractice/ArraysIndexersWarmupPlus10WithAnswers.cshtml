    {
        sku = (sku ?? &quot;&quot;).Trim();                                      // normalize
        if (sku.Length == 0) return &quot;NOT_FOUND&quot;;                       // empty key
        return _bySku.TryGetValue(sku, out var line) ? line : &quot;NOT_FOUND&quot;; // lookup
    }
}</code></pre>
