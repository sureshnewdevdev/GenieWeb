        private (int r, int c) Resolve(string sku, string wh)
        {
            sku = (sku ?? &quot;&quot;).Trim();                                    // normalize sku
            wh = (wh ?? &quot;&quot;).Trim();                                      // normalize warehouse

            if (!_skuRow.TryGetValue(sku, out var r))                     // sku exists?
