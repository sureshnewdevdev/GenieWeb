  <script>
(function(){
  function showToast(text){
    var t = document.getElementById("itqToast");
    if(!t) return;
    t.textContent = text;
    t.style.display = "block";
    clearTimeout(t._hide);
    t._hide = setTimeout(function(){ t.style.display = "none"; }, 1400);
  }
  window.itqCopy = function(codeId){
    var el = document.getElementById(codeId);
    if(!el) return;
    var text = el.innerText || el.textContent || "";
    navigator.clipboard.writeText(text).then(function(){ showToast("Code copied"); })
      .catch(function(){ showToast("Copy failed (browser blocked)"); });
  };
  window.itqCopyInput = function(textareaId){
    var el = document.getElementById(textareaId);
    if(!el) return;
    navigator.clipboard.writeText(el.value || "").then(function(){ showToast("Input copied"); })
      .catch(function(){ showToast("Copy failed"); });
  };
  window.itqToggle = function(id){
    var el = document.getElementById(id);
    if(!el) return;
    el.style.display = (el.style.display === "block") ? "none" : "block";
  };
})();
</script>
