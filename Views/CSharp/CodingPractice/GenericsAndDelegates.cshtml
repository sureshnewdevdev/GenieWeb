            <h3 class="h6">Answer 4 - Runtime Math Delegate</h3>
            <pre><code>public delegate int Operation(int x, int y); // Declares delegate signature for math operations.

public static int Add(int x, int y) => x + y; // Returns sum of two numbers.
public static int Multiply(int x, int y) => x * y; // Returns product of two numbers.

Operation action = Add; // Assigns Add method to delegate variable.
Console.WriteLine(action(5, 4)); // Invokes delegate and prints addition result.
action = Multiply; // Reassigns delegate to Multiply method.
Console.WriteLine(action(5, 4)); // Invokes delegate and prints multiplication result.</code></pre>
        </div>

        <div class="answer-card" id="answer5">
            <h3 class="h6">Answer 5 - Multicast Audit Logger</h3>
            <pre><code>public delegate void AuditLogger(string message); // Declares delegate for audit log handlers.

public static void LogToConsole(string message) // Defines console logging target.
{
    Console.WriteLine($"Console Log: {message}"); // Writes audit message to console output.
}

public static void LogToFile(string message) // Defines file logging target (simulated).
{
    Console.WriteLine($"File Log: {message}"); // Simulates writing audit message to file sink.
}

AuditLogger logger = LogToConsole; // Adds first log handler to delegate invocation list.
logger += LogToFile; // Adds second log handler to same delegate.
logger("Payment completed."); // Triggers both handlers using one delegate call.</code></pre>
        </div>

