            <pre><code>public class Animal { } // Creates base class for shared behavior.
public class Dog : Animal { } // Creates derived class that inherits from Animal.

public delegate Animal AnimalFactory(); // Delegate expects a method that returns Animal.
public delegate void DogHandler(Dog dog); // Delegate expects a method that accepts Dog.

Animal BuildDogAsAnimal() => new Dog(); // Returns Dog instance as Animal (covariance).
void HandleAnimal(Animal animal) { } // Accepts Animal, so it can also process Dog (contravariance).

AnimalFactory factory = BuildDogAsAnimal; // Valid covariance assignment for return type.
DogHandler handler = HandleAnimal; // Valid contravariance assignment for parameter type.</code></pre>
        </div>

        <div class="answer-card" id="answer10">
            <h3 class="h6">Answer 10 - Generic Retry Executor</h3>
            <pre><code>public static T ExecuteWithRetry&lt;T&gt;(Func&lt;T&gt; operation, int maxRetry) // Accepts generic operation and max retry count.
{
    for (int attempt = 1; attempt &lt;= maxRetry; attempt++) // Iterates through each retry attempt.
    {
        try
        {
            return operation(); // Executes operation and returns immediately on success.
        }
        catch
        {
            if (attempt == maxRetry) // Checks whether final attempt has already been used.
            {
                throw; // Rethrows exception because all retries are exhausted.
            }
        }
    }

    throw new InvalidOperationException("Unreachable code path."); // Adds safety fallback for compiler completeness.
}</code></pre>
