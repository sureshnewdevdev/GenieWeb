<script>
    document.addEventListener("DOMContentLoaded", function () {
        const questionCards = document.querySelectorAll(".question-card");
        const answerPanel = document.getElementById("answerPanel");
        const answerContent = document.getElementById("answerContent");

        questionCards.forEach(card => {
            card.addEventListener("click", function () {
                questionCards.forEach(item => item.classList.remove("active"));
                card.classList.add("active");

                const answerId = card.getAttribute("data-answer-id");
                const source = document.getElementById(answerId);

                if (!source) {
                    return;
                }

                answerContent.innerHTML = source.innerHTML;
                answerPanel.classList.remove("d-none");
                answerPanel.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        });
    });
</script>
