        <div class="answer-card" id="answer8">
            <h3 class="h6">Answer 8 - Type-Safe EventBus</h3>
            <pre><code>public class EventBus&lt;TPayload&gt; // Defines generic event bus for strongly typed payload events.
{
    private event Action&lt;TPayload&gt;? Handlers; // Holds all subscribed handlers for this payload type.

    public void Subscribe(Action&lt;TPayload&gt; handler) // Registers a new listener for the event.
    {
        Handlers += handler; // Adds handler into event invocation list.
    }

    public void Publish(TPayload payload) // Publishes event payload to all subscribers.
    {
        Handlers?.Invoke(payload); // Invokes handlers if at least one subscriber exists.
    }
}</code></pre>
        </div>

