    <div class="itq-answer" id="itqAns2">
      <h4>Answer (Logic + Code)</h4>
      <p>Use a stack: push openings, pop on closings, validate pairs, ignore others, stack must end empty.</p>
      <pre><code>public static bool IsValid(string text)
{
    var st = new Stack&lt;char&gt;();                                       // holds openings
    foreach (char ch in text)                                         // scan chars
    {
        if (ch is &#x27;(&#x27; or &#x27;{&#x27; or &#x27;[&#x27;)                                  // opening
            st.Push(ch);                                              // push
        else if (ch is &#x27;)&#x27; or &#x27;}&#x27; or &#x27;]&#x27;)                             // closing
        {
            if (st.Count == 0) return false;                          // nothing to match
            char open = st.Pop();                                     // last opening
            if ((ch == &#x27;)&#x27; &amp;&amp; open != &#x27;(&#x27;) ||
                (ch == &#x27;}&#x27; &amp;&amp; open != &#x27;{&#x27;) ||
                (ch == &#x27;]&#x27; &amp;&amp; open != &#x27;[&#x27;))
                return false;                                         // mismatch
        }
    }
    return st.Count == 0;                                             // all matched
}</code></pre>
