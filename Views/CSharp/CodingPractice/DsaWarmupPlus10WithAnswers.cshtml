    var text = el.innerText || el.textContent || "";
    navigator.clipboard.writeText(text).then(function(){ showToast("Code copied"); })
      .catch(function(){ showToast("Copy failed (browser blocked)"); });
  };
  window.itqCopyInput = function(textareaId){
    var el = document.getElementById(textareaId);
    if(!el) return;
    navigator.clipboard.writeText(el.value || "").then(function(){ showToast("Input copied"); })
      .catch(function(){ showToast("Copy failed"); });
  };
