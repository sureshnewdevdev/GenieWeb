@{
    ViewData["Title"] = "Collection Classes in C#";
}

<!-- Section: Introduction to Collection Classes -->
<section class="mb-5">
    <h2 class="text-secondary">What are Collection Classes in C#?</h2>
    <p class="lead">
        <b>Collection classes</b> in C# are predefined data structures provided by the .NET framework to store and manipulate objects efficiently. These collections are available in <code>System.Collections</code> (non-generic) and <code>System.Collections.Generic</code> (generic) namespaces.
    </p>
</section>

<!-- Section: Key Features of Collection Classes -->
<section class="mb-5">
    <h2 class="text-secondary">Key Features of Collection Classes</h2>
    <ul class="list-group">
        <li class="list-group-item">Provide dynamic data structures that can grow or shrink as needed.</li>
        <li class="list-group-item">Offer built-in methods for adding, removing, sorting, and searching elements.</li>
        <li class="list-group-item">Available in both generic (<code>List&lt;T&gt;</code>, <code>Dictionary&lt;TKey, TValue&gt;</code>) and non-generic (<code>ArrayList</code>, <code>Hashtable</code>) forms.</li>
        <li class="list-group-item">Improve performance compared to traditional arrays by handling memory automatically.</li>
    </ul>
</section>

<!-- Section: Common Collection Classes -->
<section class="mb-5">
    <h2 class="text-secondary">Common Collection Classes in C#</h2>
    <p class="lead">
        Below are some commonly used collection classes along with their descriptions and use cases:
    </p>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Collection Class</th>
                <th>Description</th>
                <th>Example Use Case</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>List&lt;T&gt;</code></td>
                <td>Dynamic array that can hold elements of a specific type.</td>
                <td>Managing a list of student names.</td>
            </tr>
            <tr>
                <td><code>Dictionary&lt;TKey, TValue&gt;</code></td>
                <td>Key-value pair collection for fast lookups.</td>
                <td>Storing configuration settings.</td>
            </tr>
            <tr>
                <td><code>Queue&lt;T&gt;</code></td>
                <td>First-In-First-Out (FIFO) collection.</td>
                <td>Processing a task queue in order.</td>
            </tr>
            <tr>
                <td><code>Stack&lt;T&gt;</code></td>
                <td>Last-In-First-Out (LIFO) collection.</td>
                <td>Implementing undo/redo functionality.</td>
            </tr>
            <tr>
                <td><code>HashSet&lt;T&gt;</code></td>
                <td>Stores unique elements only.</td>
                <td>Keeping track of unique student IDs.</td>
            </tr>
        </tbody>
    </table>
</section>

<!-- Section: Example of List<T> -->
<section class="mb-5">
    <h2 class="text-secondary">Example: Using List&lt;T&gt;</h2>
    <p class="lead">
        The <code>List&lt;T&gt;</code> class provides a dynamically resizable array.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Working with List&lt;T&gt;</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        List<string> students = new List<string> { "Alice", "Bob", "Charlie" };

        students.Add("David");
        students.Remove("Bob");

        Console.WriteLine("Student List:");
        foreach (var student in students)
        {
            Console.WriteLine(student);
        }
    }
}

// Output:
// Student List:
// Alice
// Charlie
// David</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        The <code>List&lt;T&gt;</code> class allows adding, removing, and accessing elements dynamically.
    </p>
</section>

<!-- Section: Example of Dictionary<T, T> -->
<section class="mb-5">
    <h2 class="text-secondary">Example: Using Dictionary&lt;TKey, TValue&gt;</h2>
    <p class="lead">
        The <code>Dictionary&lt;TKey, TValue&gt;</code> class stores key-value pairs for fast lookups.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Storing Key-Value Pairs in a Dictionary</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        Dictionary<int, string> students = new Dictionary<int, string>
        {
            {1, "Alice"},
            {2, "Bob"},
            {3, "Charlie"}
        };

        students[4] = "David"; // Adding a new key-value pair

        Console.WriteLine("Students:");
        foreach (var pair in students)
        {
            Console.WriteLine($"ID: {pair.Key}, Name: {pair.Value}");
        }
    }
}

// Output:
// Students:
// ID: 1, Name: Alice
// ID: 2, Name: Bob
// ID: 3, Name: Charlie
// ID: 4, Name: David</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        The <code>Dictionary</code> class allows efficient lookups using unique keys.
    </p>
</section>

<!-- Section: Best Practices for Using Collection Classes -->
<section class="mb-5">
    <h2 class="text-secondary">Best Practices for Using Collection Classes</h2>
    <ul class="list-group">
        <li class="list-group-item">Use <code>List&lt;T&gt;</code> when working with dynamic lists.</li>
        <li class="list-group-item">Use <code>Dictionary&lt;TKey, TValue&gt;</code> for fast key-based lookups.</li>
        <li class="list-group-item">Use <code>Queue&lt;T&gt;</code> for FIFO operations and <code>Stack&lt;T&gt;</code> for LIFO operations.</li>
        <li class="list-group-item">Use <code>HashSet&lt;T&gt;</code> when uniqueness is required.</li>
        <li class="list-group-item">Prefer generic collections over non-generic collections for type safety.</li>
    </ul>
</section>

