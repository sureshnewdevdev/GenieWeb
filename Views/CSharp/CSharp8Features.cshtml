      --tip:#e8f5e9;       --tip-border:#2e7d32;
      --warn:#ffebee;      --warn-border:#e53935;

      --example:#f3f4f6;
      --code-bg:#0b1020;
      --code-fg:#e5e7eb;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      color:var(--text);
      background:#ffffff;
      line-height:1.55;
    }
    main.col-12.col-lg-9{
      flex: 1 1 100%;
      max-width: 100%;
    }
    #rightAdSection{
      display:none !important;
    }

    /* Top bar (W3 style) */
    .topbar{
      position:fixed;
      top:0; left:0; right:0;
      height:56px;
      background:var(--w3-green);
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 16px;
      z-index:1000;
      box-shadow: 0 2px 10px rgba(0,0,0,.12);
    }
    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:700;
      letter-spacing:.2px;
    }
    .brand-badge{
      width:34px; height:34px;
      border-radius:50%;
      background:#ffffff;
      color:var(--w3-green);
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-weight:800;
      box-shadow: inset 0 0 0 2px rgba(4,170,109,.25);
    }
    .top-links{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      font-size:13px;
    }
    .top-links a{
      color:#fff;
      text-decoration:none;
      padding:6px 10px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.35);
    }
    .top-links a:hover{ background: rgba(255,255,255,.15); }

    /* Layout: fixed sidebar + content */
    .wrap{
      display:flex;
      margin-top:56px;
      min-height: calc(100vh - 56px);
      gap:18px;
      align-items:flex-start;
    }
    .sidebar{
      position:sticky;
      top:72px;
      align-self:flex-start;
      width:260px;
      max-height: calc(100vh - 72px);
      overflow:auto;
      background:var(--light);
      border-right:1px solid var(--border);
      padding:14px 12px;
      border-radius:12px;
    }
    .sidebar h3{
      margin:8px 8px 10px;
      font-size:14px;
      color:#0b2e1d;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    .menu{
      list-style:none;
      padding:0;
      margin:0;
    }
    .menu li{ margin:2px 0; }
    .menu a{
      display:block;
      padding:8px 10px;
      border-radius:8px;
      color:#0f172a;
      text-decoration:none;
      font-size:14px;
    }
    .menu a:hover{
      background:#e9f8f1;
      outline:1px solid rgba(4,170,109,.25);
    }
    .menu .group{
      margin:10px 0 6px;
      padding:8px 10px;
      border-radius:10px;
      background:#ffffff;
      border:1px solid var(--border);
      font-weight:700;
      font-size:13px;
      color:#0f172a;
    }
    .menu .sub{
      margin-left:8px;
      border-left:3px solid rgba(4,170,109,.25);
      padding-left:6px;
    }

    .content{
      flex:1;
      min-width:0;
      padding:18px 18px 70px;
    }

    /* Section boxes with green headers */
    .section{
      background:#fff;
      border:1px solid var(--border);
      border-radius:14px;
      margin:14px 0 18px;
      overflow:visible;
      box-shadow: 0 6px 20px rgba(17,24,39,.04);
    }
    .section .sh{
      background:linear-gradient(0deg, rgba(4,170,109,.09), rgba(4,170,109,.09)), #fff;
      border-bottom:1px solid rgba(4,170,109,.25);
      padding:12px 14px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
    }
    .section .sh h2{
      margin:0;
      font-size:18px;
      color:#064e3b;
    }
    .section .bd{
      padding:14px 14px 10px;
    }

    .content img,
    .content .diagram,
    .content p,
    .content li{
      cursor: zoom-in;
      transform-origin: top left;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .content img:hover,
    .content .diagram:hover,
    .content p:hover,
    .content li:hover{
      position: relative;
      z-index: 5;
      transform: scale(2);
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
      transition-delay: 2s;
    }

    .kicker{
      display:inline-block;
      font-size:12px;
      color:var(--muted);
      background:#f8fafc;
      border:1px solid var(--border);
      padding:4px 10px;
      border-radius:999px;
      margin-bottom:10px;
    }

    /* Notes / Tip / Warning */
    .callout{
      border-left:6px solid;
      padding:10px 12px;
      border-radius:10px;
      margin:12px 0;
      background:#fff;
    }
    .note{ background:var(--note); border-left-color:var(--note-border); }
    .tip{  background:var(--tip);  border-left-color:var(--tip-border);  }
    .warn{ background:var(--warn); border-left-color:var(--warn-border); }

    /* Example box */
    .example{
      background:var(--example);
      border:1px solid var(--border);
      border-radius:12px;
      padding:12px;
      margin:12px 0;
    }
    .example h3{
      margin:0 0 8px;
      font-size:15px;
      color:#111827;
    }

    /* Code blocks */
    pre{
      margin:10px 0 0;
      background:var(--code-bg);
      color:var(--code-fg);
      border-radius:12px;
      padding:12px;
      overflow:auto;
      border:1px solid rgba(255,255,255,.08);
    }
    code{ font-family: Consolas, "Courier New", monospace; font-size:13px; }

    /* ASCII diagram */
    .diagram{
      background:#0b1220;
      border:1px dashed rgba(229,231,235,.35);
      color:#e5e7eb;
      border-radius:12px;
      padding:12px;
      overflow:auto;
      margin:12px 0;
    }

    /* Buttons */
    .btnrow{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:space-between;
      margin-top:14px;
      padding:10px 14px 14px;
      border-top:1px solid var(--border);
      background:#fafafa;
    }
    .btn{
      display:inline-block;
      background:var(--w3-green);
      color:#fff;
      text-decoration:none;
      padding:10px 14px;
      border-radius:999px;
      font-weight:700;
      font-size:14px;
      border:1px solid rgba(0,0,0,.05);
    }
    .btn:hover{ filter: brightness(.95); }
    .btn.secondary{
      background:#ffffff;
      color:#064e3b;
      border:1px solid rgba(4,170,109,.35);
    }

    .try{
      display:inline-block;
      margin-top:10px;
      text-decoration:none;
      padding:9px 12px;
      border-radius:999px;
      border:1px solid rgba(4,170,109,.45);
      color:#064e3b;
      background:#e9f8f1;
      font-weight:700;
      font-size:13px;
    }
    .try:hover{ background:#dff6ee; }

    /* Tables */
    table{
      width:100%;
      border-collapse:collapse;
      margin:12px 0;
      font-size:14px;
    }
    th, td{
      border:1px solid var(--border);
      padding:10px;
      vertical-align:top;
    }
    th{
      background:#f9fafb;
      text-align:left;
    }

    /* Tooltips */
    .tt{
      position:relative;
      cursor:help;
      border-bottom:1px dotted rgba(4,170,109,.9);
      color:#065f46;
      font-weight:700;
    }
    .tt::after{
      content: attr(data-tip);
      position:absolute;
      left:0;
      top: calc(100% + 10px);
      min-width: 260px;
      max-width: 360px;
      background:#0b1020;
      color:#e5e7eb;
      padding:10px 10px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.12);
      box-shadow: 0 10px 30px rgba(0,0,0,.25);
      opacity:0;
      transform: translateY(-4px);
      pointer-events:none;
      transition: all .15s ease;
      font-weight:500;
      line-height:1.35;
      z-index:50;
      white-space:normal;
    }
    .tt::before{
      content:"";
      position:absolute;
      left:18px;
      top: calc(100% + 2px);
      border:8px solid transparent;
      border-bottom-color:#0b1020;
      opacity:0;
      transition: all .15s ease;
      z-index:51;
    }
    .tt:hover::after, .tt:hover::before{ opacity:1; transform: translateY(0); }

    /* TOC */
    .toc{
      border:1px solid var(--border);
      background:#ffffff;
      border-radius:14px;
      padding:12px 14px;
      margin:14px 0 18px;
