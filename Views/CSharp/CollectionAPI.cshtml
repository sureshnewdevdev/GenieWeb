@{
    ViewData["Title"] = "Collection API in C#";
}

<!-- Section: Introduction to Collection API -->
<section class="mb-5">
    <h2 class="text-secondary">What is the Collection API in C#?</h2>
    <p class="lead">
        The <b>Collection API</b> in C# refers to the set of classes and interfaces provided in the <code>System.Collections</code> and <code>System.Collections.Generic</code> namespaces. These APIs allow developers to manage data structures efficiently, supporting operations like adding, removing, sorting, and searching elements.
    </p>
</section>

<!-- Section: Key Features of Collection API -->
<section class="mb-5">
    <h2 class="text-secondary">Key Features of Collection API</h2>
    <ul class="list-group">
        <li class="list-group-item">Provides dynamic and flexible data structures.</li>
        <li class="list-group-item">Supports both generic (<code>List&lt;T&gt;</code>) and non-generic (<code>ArrayList</code>) collections.</li>
        <li class="list-group-item">Includes advanced operations like sorting, searching, and filtering.</li>
        <li class="list-group-item">Optimized for performance and memory efficiency.</li>
    </ul>
</section>

<!-- Section: Categories of Collections -->
<section class="mb-5">
    <h2 class="text-secondary">Categories of Collections in C#</h2>
    <p class="lead">
        The C# Collection API includes different types of collections for various use cases:
    </p>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Example Collection</th>
                <th>Use Case</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>List-Based Collections</td>
                <td><code>List&lt;T&gt;</code>, <code>ArrayList</code></td>
                <td>Storing an ordered list of items with dynamic resizing.</td>
            </tr>
            <tr>
                <td>Dictionary-Based Collections</td>
                <td><code>Dictionary&lt;TKey, TValue&gt;</code>, <code>Hashtable</code></td>
                <td>Storing key-value pairs for fast lookups.</td>
            </tr>
            <tr>
                <td>Queue-Based Collections</td>
                <td><code>Queue&lt;T&gt;</code>, <code>ConcurrentQueue&lt;T&gt;</code></td>
                <td>Processing items in First-In-First-Out (FIFO) order.</td>
            </tr>
            <tr>
                <td>Stack-Based Collections</td>
                <td><code>Stack&lt;T&gt;</code>, <code>ConcurrentStack&lt;T&gt;</code></td>
                <td>Processing items in Last-In-First-Out (LIFO) order.</td>
            </tr>
            <tr>
                <td>Set-Based Collections</td>
                <td><code>HashSet&lt;T&gt;</code>, <code>SortedSet&lt;T&gt;</code></td>
                <td>Ensuring unique elements in a collection.</td>
            </tr>
        </tbody>
    </table>
</section>

<!-- Section: Example of Using List<T> -->
<section class="mb-5">
    <h2 class="text-secondary">Example: Using List&lt;T&gt;</h2>
    <p class="lead">
        The <code>List&lt;T&gt;</code> class is a resizable array that supports dynamic storage.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: List Operations</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        List<string> names = new List<string> { "Alice", "Bob", "Charlie" };
        names.Add("David");

        Console.WriteLine($"Count: {names.Count}");
        Console.WriteLine($"Contains 'Bob': {names.Contains("Bob")}");

        names.Remove("Bob");

        Console.WriteLine("Updated List:");
        foreach (var name in names)
        {
            Console.WriteLine(name);
        }
    }
}

// Output:
// Count: 4
// Contains 'Bob': True
// Updated List:
// Alice
// Charlie
// David</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        The <code>List&lt;T&gt;</code> class provides easy manipulation of dynamic lists.
    </p>
</section>

<!-- Section: Example of Using Dictionary<T, T> -->
<section class="mb-5">
    <h2 class="text-secondary">Example: Using Dictionary&lt;TKey, TValue&gt;</h2>
    <p class="lead">
        The <code>Dictionary&lt;TKey, TValue&gt;</code> class allows fast retrieval of values based on unique keys.
    </p>

    <!-- Example Code Block -->
    <h3 class="text-info">Example: Dictionary Key-Value Storage</h3>
    <div class="code-snippet position-relative bg-light p-3 rounded border">
        <pre class="mb-0">
<code>using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        Dictionary<int, string> employees = new Dictionary<int, string>
        {
            { 101, "Alice" },
            { 102, "Bob" },
            { 103, "Charlie" }
        };

        employees[104] = "David"; // Adding a new entry

        Console.WriteLine("Employees:");
        foreach (var pair in employees)
        {
            Console.WriteLine($"ID: {pair.Key}, Name: {pair.Value}");
        }
    }
}

// Output:
// Employees:
// ID: 101, Name: Alice
// ID: 102, Name: Bob
// ID: 103, Name: Charlie
// ID: 104, Name: David</code>
        </pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>

    <p class="text-muted">
        The <code>Dictionary</code> class allows efficient key-based retrieval of values.
    </p>
</section>

<!-- Section: Best Practices for Using Collection API -->
<section class="mb-5">
    <h2 class="text-secondary">Best Practices for Using Collection API</h2>
    <ul class="list-group">
        <li class="list-group-item">Use <code>List&lt;T&gt;</code> for dynamic lists that require frequent modifications.</li>
        <li class="list-group-item">Use <code>Dictionary&lt;TKey, TValue&gt;</code> for fast key-based lookups.</li>
        <li class="list-group-item">Use <code>Queue&lt;T&gt;</code> for FIFO-based task processing.</li>
        <li class="list-group-item">Use <code>Stack&lt;T&gt;</code> for operations requiring LIFO ordering.</li>
        <li class="list-group-item">Use <code>HashSet&lt;T&gt;</code> to store unique elements efficiently.</li>
        <li class="list-group-item">Use generic collections over non-generic ones for type safety and performance.</li>
    </ul>
</section>

