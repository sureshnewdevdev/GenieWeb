@{
    ViewData["Title"] = "C# Features";
}

<style>
:root{
      --green:#04AA6D;
      --dark:#1f1f1f;
      --code:#0f172a;
      --sidebar:#f3f4f6;
      --box:#ffffff;
      --muted:#6b7280;
      --border:#e5e7eb;
      --note:#e8f0fe;
      --tip:#e7f7ef;
      --warn:#ffe8e8;
      --example:#f2f2f2;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background:#fff;
      color:#111827;
    }

    /* Top bar (W3-like) */
    .topbar{
      position:fixed; top:0; left:0; right:0;
      height:56px;
      background:var(--green);
      color:#fff;
      display:flex;
      align-items:center;
      padding:0 16px;
      z-index:999;
      box-shadow:0 2px 8px rgba(0,0,0,.15);
    }
    .brand{
      font-weight:800;
      letter-spacing:.3px;
      display:flex; align-items:center; gap:10px;
    }
    .brand .logo{
      width:34px; height:34px;
      border-radius:50%;
      background:rgba(255,255,255,.25);
      display:inline-flex;
      align-items:center; justify-content:center;
      font-weight:900;
    }
    .brand small{
      display:block;
      font-weight:600;
      opacity:.92;
      letter-spacing:0;
    }
    .topbar .right{
      margin-left:auto;
      display:flex;
      gap:10px;
      align-items:center;
      font-size:14px;
      opacity:.95;
    }
    .pill{
      background:rgba(255,255,255,.18);
      border:1px solid rgba(255,255,255,.25);
      padding:6px 10px;
      border-radius:999px;
      white-space:nowrap;
    }

    /* Layout */
    .layout{
      display:flex;
      padding-top:56px; /* topbar */
    }

    /* Sidebar (W3 left menu) */
    .sidebar{
      position:fixed;
      top:56px;
      left:0;
      bottom:0;
      width:290px;
      background:var(--sidebar);
      border-right:1px solid var(--border);
      overflow:auto;
      padding:14px 10px 40px;
    }
    .sidebar h3{
      margin:10px 10px 6px;
      font-size:14px;
      color:#111827;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    .menu a{
      display:block;
      text-decoration:none;
      color:#111827;
      padding:9px 10px;
      margin:2px 6px;
      border-radius:6px;
      font-size:14px;
      line-height:1.2;
    }
    .menu a:hover{ background:#e9ecef; }
    .menu .indent{ padding-left:22px; }
    .menu .indent2{ padding-left:34px; }
    .menu .active{
      background:#d9f3ea;
      border:1px solid #bfead9;
      font-weight:700;
    }

    /* Main content */
    .main{
      margin-left:290px;
      width:calc(100% - 290px);
      padding:18px 18px 60px;
      background:#fff;
    }

    /* Section box with green header */
    .section{
      background:var(--box);
      border:1px solid var(--border);
      border-radius:10px;
      overflow:hidden;
      margin:14px 0;
      box-shadow:0 1px 10px rgba(0,0,0,.04);
    }
    .section .head{
      background:var(--green);
      color:#fff;
      padding:12px 14px;
      font-size:18px;
      font-weight:800;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }
    .section .body{
      padding:14px;
    }
    .muted{ color:var(--muted); }
    .kpi{
      font-size:13px;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.18);
      border:1px solid rgba(255,255,255,.28);
      white-space:nowrap;
    }

    /* Notes */
    .note, .tip, .warn{
      border-radius:10px;
      padding:12px 12px;
      margin:12px 0;
      border:1px solid var(--border);
    }
    .note{ background:var(--note); border-color:#c7dcff; }
    .tip{ background:var(--tip); border-color:#bfead9; }
    .warn{ background:var(--warn); border-color:#ffbdbd; }
    .note b, .tip b, .warn b{ display:inline-block; margin-bottom:6px; }

    /* Example */
    .example{
      background:var(--example);
      border:1px solid var(--border);
      padding:12px;
      border-radius:10px;
      margin:12px 0;
    }
    .try{
      display:inline-block;
      background:var(--green);
      color:#fff;
      text-decoration:none;
      padding:9px 14px;
      border-radius:8px;
      font-weight:700;
      margin-top:8px;
    }
    .try:hover{ filter:brightness(.95); }

    /* Code block (dark) */
    pre{
      background:var(--code);
      color:#e5e7eb;
      padding:12px;
      border-radius:10px;
      overflow:auto;
      border:1px solid rgba(255,255,255,.08);
      margin:10px 0;
    }
    code{ font-family: Consolas, Menlo, Monaco, "Courier New", monospace; }

    /* ASCII diagram box */
    .ascii{
      font-family: Consolas, Menlo, Monaco, "Courier New", monospace;
      background:#0b1020;
      color:#dbeafe;
      padding:12px;
      border-radius:10px;
      border:1px solid rgba(255,255,255,.08);
      margin:10px 0;
      white-space:pre;
      overflow:auto;
    }

    /* Next/Prev buttons */
    .navbtns{
      display:flex;
      gap:10px;
      justify-content:space-between;
      margin-top:14px;
      flex-wrap:wrap;
    }
    .btn{
      display:inline-block;
      background:var(--green);
      color:#fff;
      text-decoration:none;
      padding:10px 14px;
      border-radius:999px;
      font-weight:800;
      min-width:170px;
      text-align:center;
    }
    .btn.secondary{
      background:#111827;
    }
    .btn:hover{ filter:brightness(.95); }

    /* Tables */
    table{
      width:100%;
      border-collapse:collapse;
      margin:10px 0;
      font-size:14px;
    }
    th, td{
      border:1px solid var(--border);
      padding:10px;
      vertical-align:top;
    }
    th{
      background:#f9fafb;
      text-align:left;
    }

    /* Tooltip */
    .tt{
      position:relative;
      border-bottom:1px dotted #111827;
      cursor:help;
      font-weight:700;
    }
    .tt::after{
      content:attr(data-tip);
      position:absolute;
      left:0;
      top:120%;
      width:min(360px, 70vw);
      background:#111827;
      color:#fff;
      padding:10px 10px;
      border-radius:10px;
      font-weight:500;
      font-size:13px;
      line-height:1.25;
      box-shadow:0 10px 22px rgba(0,0,0,.25);
      opacity:0;
      pointer-events:none;
      transform:translateY(6px);
      transition:opacity .15s ease, transform .15s ease;
      white-space:pre-line;
      z-index:50;
    }
    .tt::before{
      content:"";
      position:absolute;
      left:14px;
      top:112%;
      border:8px solid transparent;
      border-bottom-color:#111827;
      opacity:0;
      transform:translateY(6px);
      transition:opacity .15s ease, transform .15s ease;
      z-index:51;
    }
    .tt:hover::after, .tt:hover::before{
      opacity:1;
      transform:translateY(0);
    }

    /* Responsive */
    @@media (max-width: 980px){
      .sidebar{ position:static; width:100%; height:auto; }
      .main{ margin-left:0; width:100%; }
      .layout{ display:block; }
    }
</style>

