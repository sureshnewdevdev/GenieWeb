@{
    ViewData["Title"] = "C# 10 Features";
    ViewData["ViewportScale"] = "0.1";
}

<style>
:root{
      --w3-green:#04AA6D;
      --dark:#1f2937;
      --dark2:#111827;
      --light:#f7f7f7;
      --border:#e5e7eb;
      --text:#111827;
      --muted:#6b7280;

      --note:#e7f3fe;      --note-border:#2196F3;
      --tip:#e8f5e9;       --tip-border:#2e7d32;
      --warn:#ffebee;      --warn-border:#e53935;

      --example:#f3f4f6;
      --code-bg:#0b1020;
      --code-fg:#e5e7eb;
      --page-zoom:1;
    }

    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background:#ffffff;
      color:var(--text);
      line-height:1.6;
      font-size: calc(16px * var(--page-zoom));
    }

    /* Top bar (W3-like) */
    .topbar{
      position:fixed;
      top:0; left:0; right:0;
      height:56px;
      background:var(--w3-green);
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 16px;
      z-index:1000;
      box-shadow: 0 2px 10px rgba(0,0,0,.12);
      gap:12px;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:700;
      letter-spacing:.2px;
      white-space:nowrap;
    }
    .brand-badge{
      width:34px; height:34px;
      border-radius:50%;
      background:#ffffff;
      color:var(--w3-green);
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-weight:800;
      box-shadow: inset 0 0 0 2px rgba(4,170,109,.25);
    }
    .top-links{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      font-size:13px;
    }
    .top-links a{
      color:#fff;
      text-decoration:none;
      padding:6px 10px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.35);
    }
    .top-links a:hover{ background: rgba(255,255,255,.15); }
    .topbar .spacer{ flex:1; }
    .topbar .topbtn{
      border:1px solid rgba(255,255,255,.35);
      background:rgba(255,255,255,.12);
      color:#fff;
      padding:8px 10px;
      border-radius:999px;
      font-weight:700;
      cursor:pointer;
    }
    .topbar .topbtn:active{ transform:translateY(1px); }
    .zoom-controls{
      display:flex;
      align-items:center;
      gap:6px;
      color:#fff;
      font-size:13px;
      font-weight:700;
      white-space:nowrap;
    }
    .zoom-controls button{
      border:1px solid rgba(255,255,255,.35);
      background:rgba(255,255,255,.12);
      color:#fff;
      padding:4px 8px;
      border-radius:999px;
      cursor:pointer;
      font-weight:800;
    }
    .zoom-controls button:active{ transform:translateY(1px); }

    /* Layout: sidebar + content */
    .layout{
      margin-top:56px; /* topbar height */
      min-height:calc(100vh - 56px);
      width:100%;
    }

    /* REQUIRED SIDEBAR CONTAINER STRUCTURE (kept compatible with your _Layout.cshtml style) */
    nav#sidebarMenu{
      width:280px;
      background:var(--light);
      border-right:1px solid var(--border);
      position:fixed;
      top:56px;
      left:0;
      bottom:0;
      overflow:auto;
      padding:14px 12px;
    }
    .sidecard{
      background:#fff;
      border:1px solid var(--border);
      border-radius:12px;
      padding:12px;
    }
    .sidecard h3{
      margin:0 0 8px 0;
      font-size:15px;
      color:#0b2e1d;
    }
    .sidecard .small{
      font-size:12px;
      color:var(--muted);
      margin-bottom:10px;
    }
    .sidelink{
      display:block;
      padding:8px 10px;
      border-radius:8px;
      color:#0f172a;
      text-decoration:none;
      font-size:14px;
      border:1px solid transparent;
      margin:3px 0;
      font-weight:700;
    }
    .sidelink:hover{
      background:#e9f8f1;
      outline:1px solid rgba(4,170,109,.25);
      color:#0b5c3f;
    }
    .sidelink.active{
      background:#e9fff6;
      border-color:#c9f0de;
      color:#0b5c3f;
      font-weight:800;
    }
    .sidegroup{
      margin:10px 0 6px;
      padding:8px 10px;
      background:#ffffff;
      border:1px solid var(--border);
      border-radius:10px;
      font-weight:800;
      font-size:13px;
      color:#0f172a;
    }
    .subindent{ margin-left:8px; }
    details.menu-details{
      border:1px solid var(--border);
      border-radius:12px;
      padding:10px;
      background:#f8fafc;
    }
    details.menu-details > summary{
      cursor:pointer;
      list-style:none;
      font-weight:800;
      color:#064e3b;
      padding:6px 8px;
      border-radius:8px;
      background:#ffffff;
      border:1px solid var(--border);
      margin-bottom:8px;
    }
    details.menu-details > summary::-webkit-details-marker{ display:none; }
    .submenu{ margin-top:6px; }

    /* Content */
    .content{
      margin-left:280px;
      width:calc(100vw - 280px);
      max-width:none;
      padding:18px 18px 80px;
    }
    .container{
      width:100%;
      max-width:none;
      margin:0;
    }

    /* Section style */
    .section{
      background:#fff;
      border:1px solid var(--border);
      border-radius:14px;
      margin:14px 0;
      overflow:hidden;
      box-shadow: 0 6px 20px rgba(17,24,39,.04);
    }
    .section .head{
      background:linear-gradient(0deg, rgba(4,170,109,.09), rgba(4,170,109,.09)), #fff;
      border-bottom:1px solid rgba(4,170,109,.25);
      padding:12px 14px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      color:#064e3b;
      font-weight:800;
    }
    .section .head .tag{
      font-size:12px;
      padding:4px 10px;
      border-radius:999px;
      background:#f8fafc;
      border:1px solid var(--border);
      font-weight:800;
      color:var(--muted);
      white-space:nowrap;
    }
    .section .body{
      padding:14px 14px 10px;
    }
    .muted{ color:var(--muted); }

    /* W3-like notes */
    .note, .tip, .warning{
      padding:10px 12px;
      border-radius:10px;
      margin:12px 0;
      border-left:6px solid;
      background:#fff;
    }
    .note{ background:var(--note); border-left-color:var(--note-border); }
    .tip{ background:var(--tip); border-left-color:var(--tip-border); }
    .warning{ background:var(--warn); border-left-color:var(--warn-border); }

    /* Example box */
    .example{
      background:var(--example);
      border:1px solid var(--border);
      border-radius:12px;
      padding:12px;
      margin:10px 0;
    }
    .example .ex-title{
      font-weight:900;
      margin-bottom:6px;
    }

    /* Code block */
    pre{
      background:var(--code-bg);
      color:var(--code-fg);
      padding:12px;
      border-radius:12px;
      overflow:auto;
      border:1px solid rgba(255,255,255,.06);
      margin:10px 0;
    }
    code{
      background:#f3f3f3;
      border:1px solid #e9e9e9;
      padding:2px 6px;
      border-radius:8px;
      font-family: Consolas, Menlo, Monaco, "Courier New", monospace;
      font-size: 0.95em;
    }

    /* Try it button */
    .trybtn{
      display:inline-block;
      margin-top:8px;
      padding:10px 14px;
      background:var(--w3-green);
      color:#fff;
      font-weight:900;
      border-radius:10px;
      text-decoration:none;
      border:1px solid rgba(0,0,0,.06);
    }
    .trybtn:hover{ filter:brightness(.98); }

    /* Next/Prev */
    .pager{
      display:flex;
      gap:10px;
      justify-content:space-between;
      margin-top:12px;
      flex-wrap:wrap;
    }
    .pager a{
      text-decoration:none;
      background:var(--w3-green);
      color:#fff;
      font-weight:900;
      padding:10px 14px;
      border-radius:999px;
      display:inline-block;
      border:1px solid rgba(0,0,0,.06);
    }
    .pager a.secondary{
      background:#0b5c3f;
    }
    .pager .placeholders{
      width:100%;
      font-size:12px;
      color:var(--muted);
      margin-top:6px;
    }
    .pager .placeholders a{
      background:transparent;
      color:var(--muted);
      border:none;
      padding:0;
      text-decoration:underline;
      font-weight:700;
    }

    /* Tables */
    table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      overflow:hidden;
      border-radius:12px;
      border:1px solid var(--border);
      margin:10px 0;
    }
    th, td{
      padding:10px 10px;
      border-bottom:1px solid var(--border);
      text-align:left;
      vertical-align:top;
      font-size:14px;
    }
    th{
      background:#fafafa;
      font-weight:900;
    }
    tr:last-child td{ border-bottom:none; }

    /* Tooltip (STRICT: CSS only, span.tt[data-tip="..."]) */
    .tt{
      position:relative;
      border-bottom:2px dotted rgba(4,170,109,.65);
      cursor:help;
      font-weight:800;
      color:#0b5c3f;
    }
    .tt::after{
      content: attr(data-tip);
      position:absolute;
      left:0;
      top: calc(100% + 10px);
      width: min(360px, 70vw);
      background:#111;
      color:#fff;
      padding:10px 10px;
      border-radius:12px;
      box-shadow:0 12px 30px rgba(0,0,0,.22);
      opacity:0;
      pointer-events:none;
      transform:translateY(-6px);
      transition:opacity .15s ease, transform .15s ease;
      font-weight:600;
      font-size:13px;
      line-height:1.35;
      z-index:999;
      white-space:pre-line;
    }
    .tt::before{
      content:"";
      position:absolute;
      left:14px;
      top: calc(100% + 2px);
      border:8px solid transparent;
      border-bottom-color:#111;
      opacity:0;
      transform:translateY(-6px);
      transition:opacity .15s ease, transform .15s ease;
      z-index:999;
    }
    .tt:hover::after,
    .tt:hover::before{
      opacity:1;
      transform:translateY(0);
    }

    /* Simple “hover highlight / zoom” effect for important callouts (CSS only) */
    .hoverzoom{
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .hoverzoom:hover{
      transform: scale(1.01);
      box-shadow:0 10px 30px rgba(0,0,0,.10);
    }

    /* Responsive */
    @@media (max-width: 980px){
      nav#sidebarMenu{
        position:fixed;
        left:-290px;
        transition:left .18s ease;
        z-index:1200;
      }
      nav#sidebarMenu.open{ left:0; }
      .content{
        margin-left:0;
        width:100%;
      }
      .top-links{ display:none; }
      .zoom-controls{ display:none; }
    }

    /* Quiz */
    .quizQ{
      border:1px solid var(--border);
      border-radius:12px;
      padding:12px;
      margin:10px 0;
      background:#fff;
    }
    .quizQ .qtitle{ font-weight:900; }
    .quizQ label{ display:block; margin:6px 0; cursor:pointer; }
    .quiz-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:10px;
    }
    .btn{
      padding:10px 14px;
      border-radius:10px;
      border:1px solid var(--border);
      background:#fff;
      cursor:pointer;
      font-weight:900;
    }
    .btn.primary{
      background:var(--w3-green);
      color:#fff;
      border-color:rgba(0,0,0,.06);
    }
    .btn:active{ transform:translateY(1px); }
    .scorebox{
      padding:12px;
      border-radius:12px;
      background:#f8fffb;
      border:1px solid #c9f0de;
      font-weight:900;
      color:#0b5c3f;
      display:none;
      margin-top:10px;
    }

    /* Anchors offset for fixed topbar */
    .anchor{ scroll-margin-top: 70px; }

    /* Footer */
    .footer{
      margin-top:18px;
      color:var(--muted);
      font-size:13px;
      text-align:center;
    }
</style>

<script>
let zoomLevel = 1;
    const minZoom = 0.8;
    const maxZoom = 1.4;

    function applyZoom(level) {
      zoomLevel = Math.min(maxZoom, Math.max(minZoom, level));
      document.documentElement.style.setProperty("--page-zoom", zoomLevel);
      const label = document.getElementById("zoomValue");
      if (label) {
        label.textContent = `${Math.round(zoomLevel * 100)}%`;
      }
    }

    function adjustZoom(delta) {
      applyZoom(zoomLevel + delta);
    }

    function resetZoom() {
      applyZoom(1);
    }

    function toggleSidebar() {
      const sidebar = document.getElementById("sidebarMenu");
      if (sidebar) {
        sidebar.classList.toggle("open");
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      applyZoom(1);
    });
</script>

