            <!-- G) Common Mistakes + Fixes -->
            <section id="mistakes" class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Common Mistakes + Fixes</h2>

                    <div class="mb-3">
                        <span class="badge bg-danger">Mistake</span>
                        <b>Assuming the browser can execute C# directly</b>
                        <div class="mt-2 alert alert-light border">
                            <b>Fix:</b> C# runs on the server. The browser only receives the output (HTML/JS/CSS).
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-danger">Mistake</span>
                        <b>Mixing database code inside Views</b>
                        <div class="mt-2 alert alert-light border">
                            <b>Fix:</b> Keep Views for UI only. Fetch data in Controller via Service/Repository and pass it as a Model.
                        </div>
                    </div>

                    <div>
                        <span class="badge bg-danger">Mistake</span>
                        <b>Not validating user inputs (security risk)</b>
                        <div class="mt-2 alert alert-light border mb-0">
                            <b>Fix:</b> Validate inputs, use Anti-Forgery for forms, and apply authentication/authorization consistently.
                        </div>
                    </div>
                </div>
            </section>

