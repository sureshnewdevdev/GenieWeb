@model GenieWeb.Models.HubAreaViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/css/hub.css" rel="stylesheet" />
    @if (Model.AdsEnabled)
    {
        <meta name="google-adsense-account" content="@Model.TopAd?.Client">
        <!-- Google AdSense script: only loaded for ad-enabled hub areas -->
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@Model.TopAd?.Client"
                crossorigin="anonymous"></script>
    }
</head>

<body class="hub-body">
    <partial name="_HubAreaNav" model="Model.ActiveArea" />

    <main class="hub-main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-2">&copy; 2025 ItTechGenie. All rights reserved.</p>
            <p class="mb-3">
                <a href="/Home/Privacy" class="text-white text-decoration-none link-hover">Privacy Policy</a>
            </p>
            <div class="d-flex flex-column align-items-center gap-1">
                <span><i class="fas fa-user-shield me-2"></i><strong>Managed by</strong></span>
                <a href="mailto:ittechgenie1@gmail.com" class="text-white text-decoration-none link-hover">
                    <i class="fas fa-envelope me-2"></i>ittechgenie1@gmail.com
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
