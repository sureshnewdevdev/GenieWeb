@model GenieWeb.Models.HubAreaViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ItTechGenie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/css/hub.css" rel="stylesheet" asp-append-version="true" />
    @if (Model.AdsEnabled)
    {
        <meta name="google-adsense-account" content="@Model.TopAd?.Client">
        <!-- Google AdSense script: only loaded for ad-enabled hub areas -->
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@Model.TopAd?.Client"
                crossorigin="anonymous"></script>
    }
</head>

<body class="hub-body">
    <partial name="_HubAreaNav" model="Model.ActiveArea" />

    <main class="hub-main">
        @RenderBody()
    </main>

    <footer class="hub-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center mb-3">
                        <img src="~/css/Images/Vinayaga.jpg" alt="ItTechGenie logo" width="40" height="40" class="me-2 rounded-circle" />
                        <span class="fs-5 fw-bold text-white">ItTechGenie</span>
                    </div>
                    <p class="mb-0" style="max-width: 40ch;">
                        AI consulting, corporate training, and self-paced technology learning —
                        empowering people and teams with practical, production-grade skills.
                    </p>
                </div>
                <div class="col-6 col-lg-4">
                    <h6>Explore</h6>
                    <ul class="list-unstyled hub-footer-links mb-0">
                        <li><a href="/AIConsultant">AI Consultant</a></li>
                        <li><a href="/CorporateTraining">Corporate Training</a></li>
                        <li><a href="/Learners">Learners</a></li>
                        <li><a href="/SocialMessages">Social Messages</a></li>
                        <li><a href="/ProductGallery">Product Gallery</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Contact</h6>
                    <ul class="list-unstyled hub-footer-links mb-0">
                        <li>
                            <a href="mailto:ittechgenie1@gmail.com">
                                <i class="fas fa-envelope me-2"></i>ittechgenie1@gmail.com
                            </a>
                        </li>
                        <li><a href="/Home/Privacy"><i class="fas fa-user-shield me-2"></i>Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="hub-footer-bottom text-center">
                &copy; 2025 ItTechGenie. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
