    @* Scrolls the side bar to the activepage*@
    <script>
        window.alert = function (message) {
                    let snackbar = document.getElementById("snackbar");
                    snackbar.textContent = message;
                    snackbar.classList.add("show");

                    // Hide after 2 seconds
                    setTimeout(() => {
                        snackbar.classList.remove("show");
                    }, 2000);
                };
 
        document.addEventListener("DOMContentLoaded", function () {
            let sidebar = document.getElementById("sidebarMenu");
            let mainBtn = document.getElementById("contentdropdownbtn");

            // Create Floating Button
            let floatingBtn = document.createElement("button");
            floatingBtn.id = "floatingBtn";
            floatingBtn.innerHTML = "☰"; // Sidebar Toggle Icon
            floatingBtn.classList.add("floating-button");
            floatingBtn.style.display = "none"; // Initially hidden
            document.body.appendChild(floatingBtn);

            // Scroll Observer for Floating Button Visibility
            let observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting && window.innerWidth <= 725) {
                        floatingBtn.style.display = "block"; // Show floating button
                    } else {
                        floatingBtn.style.display = "none"; // Hide floating button
                    }
                });
            }, { threshold: 0 });

            observer.observe(mainBtn);

            //function to scroll to active menu
            const container = document.querySelector(".scrollable-navbar");
            const activeLink = container?.querySelector(".nav-link.active");

            if (activeLink) {
                const offsetLeft = activeLink.offsetLeft;
                const scrollAmount = offsetLeft - container.clientWidth / 2 + activeLink.clientWidth / 2;
                container.scrollTo({ left: scrollAmount, behavior: 'smooth' });
            }

            // Function to Scroll Sidebar to Active Page
            function scrollToActivePage() {
                let activeElement = sidebar.querySelector(".nav-link.active");
                if (activeElement) {
                    setTimeout(() => {
                        activeElement.scrollIntoView({ behavior: "smooth", block: "center" });
                    }, 300);
                }
            }
        scrollToActivePage();
            // Function to Toggle Sidebar
            function toggleSidebar() {
                sidebar.classList.toggle("collapse");

                if (!sidebar.classList.contains("collapse")) {
                    // Sidebar Opened
                    document.body.classList.add("sidebar-open");
                    document.body.classList.remove("sidebar-closed");
                    scrollToActivePage(); // Ensure scroll to active item
                } else {
                    // Sidebar Closed
                    document.body.classList.remove("sidebar-open");
                    document.body.classList.add("sidebar-closed");
                }
            }

            // Add Click Listeners
            mainBtn.addEventListener("click", toggleSidebar);
            floatingBtn.addEventListener("click", toggleSidebar);
        });


        // Toggle navbar for mobile view
        function toggleNavbar() {
            var navbar = document.getElementById('navbarNav');

            if (navbar.classList.contains('show')) {
                navbar.classList.remove('show');
                navbar.style.display = "none";
            } else {
                navbar.classList.add('show');
                navbar.style.display = "block";
            }
        }


        // Toggle dropdowns inside the sidebar menu
        function toggleDropdown(menuId, element) {
            var menu = document.getElementById(menuId);
            var icon = element.querySelector(".dropdown-icon");

            if (menu.classList.contains("show")) {
                menu.classList.remove("show"); // Close dropdown
                icon.classList.remove("rotate"); // Reset icon
            } else {
                // Close all other dropdowns before opening the clicked one
                document.querySelectorAll(".collapse.show").forEach(function (openMenu) {
                    openMenu.classList.remove("show");
                    if (openMenu.previousElementSibling) {
                        let prevIcon = openMenu.previousElementSibling.querySelector(".dropdown-icon");
                        if (prevIcon) prevIcon.classList.remove("rotate");
                    }
                });

                menu.classList.add("show"); // Open dropdown
                icon.classList.add("rotate"); // Rotate icon
            }
        }

    </script>

