<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Custom Styles -->
    <style>
        .navbar-nav .nav-link.active-link {
            background-color: yellow !important;
            color: black !important;
            border-radius: 5px;
            padding: 5px 10px;
        }

        /* Sidebar styles */
        .sidebar {
            height: calc(100vh - 56px);
            overflow-y: auto;
            position: fixed;
            top: 56px;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }

        .sidebar .nav-link {
            color: #333;
            font-weight: 500;
        }

        .sidebar .nav-link.active {
            background-color: #e9ecef;
            color: #000;
        }

        /* Ensure main content doesn't overlap with sidebar */
        @@media (min-width: 768px) {
            .main-content {
                margin-left: 16.666667%;
            }
        }

        /* Mobile responsive styles */
        @@media (max-width: 767.98px) {
            .sidebar {
                position: static;
                height: auto;
            }
            .main-content {
                margin-left: 0;
            }
            #sidebarMenu {
                margin-bottom: 1rem;
            }
        }

        /* Style for the nested navigation */
        .nav-section {
            padding-left: 1rem;
        }

        .section-heading {
            font-size: 1rem;
            font-weight: 600;
            margin: 1rem 0 0.5rem 0;
            padding-left: 0.5rem;
        }

        /* Hover effect for navigation links */
        .nav-link:hover {
            background-color: rgba(0,0,0,0.05);
        }
    </style>

    <!-- Google AdSense script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2270827713894017"
            crossorigin="anonymous"></script>
</head>
<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/logo-placeholder.png" alt="Logo" width="40" height="40" class="me-2" />
                ItTechGenie
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Home" ? "active-link" : "")" 
                           href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "CSharp" ? "active-link" : "")" 
                           href="@Url.Action("CSharp", "Home")">C#</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "DotNetCore" ? "active-link" : "")" 
                           href="@Url.Action("DotNetCore", "Home")">.NET Core</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Azure" ? "active-link" : "")" 
                           href="@Url.Action("Azure", "Home")">Azure</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Privacy" ? "active-link" : "")" 
                           href="@Url.Action("Privacy", "Home")">Privacy</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="container-fluid" style="margin-top: 56px;">
        <div class="row">
            <!-- Left Menu - Always visible on desktop -->
            <div id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <h4 class="px-3">Navigate here to Learn</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <div class="px-3 py-2">
                                <h5 class="mb-0">C# Basics</h5>
                                <ul class="nav flex-column nav-section">
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "IntroductionToCSharp" ? "active" : "")" 
                                           href="@Url.Action("IntroductionToCSharp", "CSharp")">
                                            Introduction to C#
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "FeaturesOfCSharp" ? "active" : "")" 
                                           href="@Url.Action("FeatureOfCSharp", "CSharp")">
                                            Features of C#
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "CSharpCompliationAndExecution" ? "active" : "")"
                                           href="@Url.Action("CSharpCompliationAndExecution", "CSharp")">
                                            C# Compilation and Execution
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "GeneralStructureOfCSharp" ? "active" : "")"
                                           href="@Url.Action("GeneralStructureOfCSharp", "CSharp")">
                                            General Structure of a C# Program
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "CreatingAndUsingDLL" ? "active" : "")"
                                           href="@Url.Action("CreatingAndUsingDLL", "CSharp")">
                                            Creating and Using a DLL
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="px-3 py-2">
                                <h5 class="mb-0">Data Types and Arrays</h5>
                                <ul class="nav flex-column nav-section">
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "DataTypesAndArraysInCSharp" ? "active" : "")" 
                                           href="@Url.Action("DataTypesAndArraysInCSharp", "Home")">
                                            Data Types and Arrays in C#
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "DataTypes" ? "active" : "")" 
                                           href="@Url.Action("DataTypes", "Home")">
                                            Data Types in C#
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "ValueReferenceTypes" ? "active" : "")" 
                                           href="@Url.Action("ValueReferenceTypes", "Home")">
                                            Value Types and Reference Types
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "BoxingUnBoxing" ? "active" : "")" 
                                           href="@Url.Action("BoxingUnBoxing", "Home")">
                                            Boxing and UnBoxing
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">@ViewData["Title"]</h1>
                </div>
                <div>
                    @RenderBody()
                </div>

                <!-- Google AdSense ad -->
                <div class="ads-container mt-4">
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2270827713894017"
                         data-ad-slot="3993585551"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>