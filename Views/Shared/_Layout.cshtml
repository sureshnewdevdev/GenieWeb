<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/js/site.js" rel="stylesheet" />

    <!-- Custom Styles for Active Link Highlight -->
    <style>
        .navbar-nav .nav-link.active-link {
            background-color: yellow !important;
            color: black !important;
            border-radius: 5px;
            padding: 5px 10px;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Google AdSense script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2270827713894017"
        crossorigin="anonymous"></script>
</head>

<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container-fluid">
            <!-- Logo and Brand -->
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="@Url.Content("~/images/vinayaga.png")" alt="Logo" width="40" height="40"
                    class="me-2 rounded-circle" />
                <span class="fw-bold">ItTechGenie</span>
            </a>

            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler" type="button" onclick="toggleNavbar()" aria-controls="navbarNav"
                aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <script>
                function toggleNavbar() {
                    var navbar = document.getElementById('navbarNav');
                    if (navbar.classList.contains('show')) {
                        navbar.classList.remove('show');
                    } else {
                        navbar.classList.add('show');
                    }
                }
            </script>

            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Navigation Links -->
                <ul class="navbar-nav ms-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Home" ? "active" : "")" href="/"
                            aria-current="page">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "CSharp" ? "active" : "")"
                            href="@Url.Action("IntroductionToCSharp", "CSharp")">C#</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Azure" ? "active" : "")"
                            href="@Url.Action("Azure", "Home")">Azure</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "DotNetCore" ? "active" : "")"
                            href="@Url.Action("DotNetCore", "Home")">.NET Core</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "React" ? "active" : "")"
                            href="@Url.Action("IntroductionToReact", "React")">React</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "AzureDevOps" ? "active" : "")"
                            href="@Url.Action("WhatIsDevOps", "AzureDevOps")">Azure DevOps</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Privacy" ? "active" : "")"
                            href="@Url.Action("Privacy", "Home")">Privacy</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>


    <div class="container-fluid">
        <div class="row">
            <!-- Dropdown button with contents for mobiles -->
            <button
                class="btn btn-success d-md-none w-100 py-3 my-2 shadow rounded-3 d-flex align-items-center justify-content-center gap-2"
                id="contentdropdownbtn" type="button" onclick="toggleContentmenu()" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
                <span class="fw-semibold">
                    @(string.IsNullOrEmpty(ViewData["ActiveMenu"] as string) ? "☰ Quick Actions" :
                                        ("☰ " + ViewData["ActiveMenu"] as string) + " Items")
                </span>
            </button>
            <!--script to toggle the dropdown content-->
            <script>
                function toggleContentmenu() {
                    var sidebar = document.getElementById('sidebarMenu');
                    sidebar.classList.toggle('collapse'); // Toggle Bootstrap collapse class
                }
            </script>

            <!-- Left Menu with Scrollable Feature -->
            <!-- Sidebar Menu-->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse"
                style="height: auto; overflow-y: auto;">
                <div class="card card-body">
                    <div class="position-sticky pt-3">
                        <h4>Navigate here to Learn</h4>
                        <ul class="nav flex-column">

                            <!-- Show all modules when on Home -->
                            @if (string.IsNullOrEmpty(ViewData["ActiveMenu"] as string))
                            {
                                <li class="nav-item">
                                    <h5 class="mt-2">C#</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link"
                                                href="@Url.Action("IntroductionToCSharp", "CSharp")">Introduction
                                                to C#</a></li>
                                        <li><a class="nav-link" href="@Url.Action("FeaturesOfCSharp", "CSharp")">Features of
                                                C#</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <h5 class="mt-2">Azure</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link" href="@Url.Action("Azure", "Home")">Introduction
                                                to Azure</a></li>
                                        <li><a class="nav-link" href="@Url.Action("AzureDevops", "Home")">Azure Devops
                                                Overview</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <h5 class="mt-2">.NET Core</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link" href="@Url.Action("DotNetCore", "Home")">Introduction to
                                                .NET
                                                Core</a></li>
                                        <li><a class="nav-link" href="@Url.Action("DotNetCoreOverview", "Home")">Features of
                                                .NET Core</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <h5 class="mt-2">Azure DevOps</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "What is DevOps" ? "active" : "")"
                                                href="@Url.Action("WhatIsDevOps", "AzureDevOps")">Introduction to DevOps
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <h5 class="mt-2">Privacy & Security</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link" href="@Url.Action("Privacy", "Home")">Privacy
                                                Policy</a>
                                        </li>
                                        <li><a class="nav-link" href="@Url.Action("TermsAndConditions", "Home")">Terms and
                                                Conditions</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- C# Sidebar (Only shown when ActiveMenu = CSharp) -->
                            @if ((ViewData["ActiveMenu"] as string) == "CSharp")
                            {
                                <li class="nav-item">

                                    <!-- C# Basics Dropdown -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse" href="#csBasicsMenu"
                                            role="button"
                                            aria-expanded="@(new List<string> { "IntroductionToCSharp", "FeaturesOfCSharp", "CSharpCompliationAndExecution", "GeneralStructureOfCSharp", "CreatingAndUsingDLL" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="csBasicsMenu">
                                            C# Basics
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "IntroductionToCSharp", "FeaturesOfCSharp", "CSharpCompliationAndExecution", "GeneralStructureOfCSharp", "CreatingAndUsingDLL" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="csBasicsMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "IntroductionToCSharp" ? "active" : "")"
                                                    href="@Url.Action("IntroductionToCSharp", "CSharp")">Introduction to
                                                    C#</a>
                                            </li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "FeaturesOfCSharp" ? "active" : "")"
                                                    href="@Url.Action("FeaturesOfCSharp", "CSharp")">Features of C#</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "CSharpCompliationAndExecution" ? "active" : "")"
                                                    href="@Url.Action("CSharpCompliationAndExecution", "CSharp")">C#
                                                    Compilation
                                                    and Execution</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "GeneralStructureOfCSharp" ? "active" : "")"
                                                    href="@Url.Action("GeneralStructureOfCSharp", "CSharp")">General
                                                    Structure
                                                    of a C# Program</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "CreatingAndUsingDLL" ? "active" : "")"
                                                    href="@Url.Action("CreatingAndUsingDLL", "CSharp")">Creating and Using a
                                                    DLL</a></li>
                                        </ul>
                                    </div>

                                    <!-- Data Types and Arrays Dropdown -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#dataTypesMenu" role="button"
                                            aria-expanded="@(new List<string> { "DataTypesAndArrays", "ValueAndReferenceType", "BoxingUnBoxing", "TypeOfArrays", "NullableTypes", "ImplicitTypeLocalvariables", "VarvsDynamic", "IsAndAsOperators", "RefVsOutKeywords", "ObjectBaseClass", "EqualsVsEqual", "StringVsStringBuilder", "VariousStringMethods", "DefaultNamedParameters", "ParseTryParseVsConvert" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="dataTypesMenu">
                                            Data Types and Arrays
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "DataTypesAndArrays", "ValueAndReferenceType", "BoxingUnBoxing", "TypeOfArrays", "NullableTypes", "ImplicitTypeLocalvariables", "VarvsDynamic", "IsAndAsOperators", "RefVsOutKeywords", "ObjectBaseClass", "EqualsVsEqual", "StringVsStringBuilder", "VariousStringMethods", "DefaultNamedParameters", "ParseTryParseVsConvert" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="dataTypesMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "DataTypesAndArrays" ? "active" : "")"
                                                    href="@Url.Action("DataTypesAndArrays", "CSharp")">Data Types and Arrays
                                                    in
                                                    C#</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "ValueAndReferenceType" ? "active" : "")"
                                                    href="@Url.Action("ValueAndReferenceType", "CSharp")">Value Types and
                                                    Reference Types</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "BoxingUnBoxing" ? "active" : "")"
                                                    href="@Url.Action("BoxingUnBoxing", "CSharp")">Boxing and UnBoxing</a>
                                            </li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "TypeOfArrays" ? "active" : "")"
                                                    href="@Url.Action("TypeOfArrays", "CSharp")">Single Dimensional,
                                                    Multi-Dimensional & Jagged Arrays</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "NullableTypes" ? "active" : "")"
                                                    href="@Url.Action("NullableTypes", "CSharp")">Nullable Types</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "ImplicitTypeLocalvariables" ? "active" : "")"
                                                    href="@Url.Action("ImplicitTypeLocalvariables", "CSharp")">Implicitly
                                                    Typed
                                                    Local Variables</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "VarvsDynamic" ? "active" : "")"
                                                    href="@Url.Action("VarvsDynamic", "CSharp")">Var vs dynamic</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "IsAndAsOperators" ? "active" : "")"
                                                    href="@Url.Action("IsAndAsOperators", "CSharp")">Is and As Operator</a>
                                            </li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "RefVsOutKeywords" ? "active" : "")"
                                                    href="@Url.Action("RefVsOutKeywords", "CSharp")">Ref vs Out Keywords</a>
                                            </li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "ObjectBaseClass" ? "active" : "")"
                                                    href="@Url.Action("ObjectBaseClass", "CSharp")">The 'object' Base Class
                                                    in
                                                    .NET</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "EqualsVsEqual" ? "active" : "")"
                                                    href="@Url.Action("EqualsVsEqual", "CSharp")">Equals() vs ==</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "StringVsStringBuilder" ? "active" : "")"
                                                    href="@Url.Action("StringVsStringBuilder", "CSharp")">String vs
                                                    StringBuilder</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "VariousStringMethods" ? "active" : "")"
                                                    href="@Url.Action("VariousStringMethods", "CSharp")">Various String
                                                    Class
                                                    Methods</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "DefaultNamedParameters" ? "active" : "")"
                                                    href="@Url.Action("DefaultNamedParameters", "CSharp")">Default
                                                    Parameters,
                                                    Named Parameters</a></li>
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "ParseTryParseVsConvert" ? "active" : "")"
                                                    href="@Url.Action("ParseTryParseVsConvert", "CSharp")">Parse() vs
                                                    TryParse()
                                                    vs Convert Class Methods</a></li>
                                        </ul>
                                    </div>

                                </li>
                            }


                            <!-- .NET Core Sidebar (Only shown when ActiveMenu = DotNetCore) -->
                            @if ((ViewData["ActiveMenu"] as string) == "DotNetCore")
                            {
                                <li class="nav-item">
                                    <h5 class="mt-2">.NET Core Basics</h5>
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link" href="@Url.Action("DotNetCore", "Home")">Introduction to
                                                .NET
                                                Core</a></li>
                                        <li><a class="nav-link" href="@Url.Action("DotnetcoreOverview", "Home")">Features of
                                                .NET Core</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- AzureDevOps Sidebar (Only shown when ActiveMenu = AzureDevOps) -->
                            @if ((ViewData["ActiveMenu"] as string) == "AzureDevOps")
                            {
                                <li class="nav-item">
                                    <!-- Introduction to Azure DevOps -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#IntroductionDevOpsMenu" role="button"
                                            aria-expanded="@(new List<string> { "What is DevOps", "DevOps vs Traditional", "Benefits of DevOps", "DevOps lifecycle" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="IntroductionDevOpsMenu">
                                            Introduction to DevOps
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "What is DevOps", "DevOps vs Traditional", "Benefits of DevOps", "DevOps lifecycle" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="IntroductionDevOpsMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li><a class="nav-link @(ViewData["ActivePage"] as string == "What is DevOps" ? "active" : "")"
                                                    href="@Url.Action("WhatIsDevOps", "AzureDevOps")">What is DevOps
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "DevOps vs Traditional" ? "active" : "")"
                                                    href="@Url.Action("DevOpsvsTraditional", "AzureDevOps")"> DevOps vs
                                                    Traditional IT</a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Benefits of DevOps" ? "active" : "")"
                                                    href="@Url.Action("BenefitsOfDevOps", "AzureDevOps")"> Benefits of
                                                    DevOps</a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "DevOps lifecycle" ? "active" : "")"
                                                    href="@Url.Action("DevOpsLifecycle", "AzureDevOps")"> DevOps
                                                    Lifecycle</a>
                                            </li>

                                        </ul>
                                    </div>

                                    <!-- Introduction to Azure & Azure DevOps -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#IntroductionAzureDevOpsMenu" role="button"
                                            aria-expanded="@(new List<string> { "Overview of Cloud Computing", "Introduction to Microsoft Azure", "What is Azure DevOps?", "Key Azure DevOps Services" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="IntroductionAzureDevOpsMenu">
                                            Introduction to Azure & Azure DevOps
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "Overview of Cloud Computing", "Introduction to Microsoft Azure", "What is Azure DevOps?", "Key Azure DevOps Services" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="IntroductionAzureDevOpsMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Overview of Cloud Computing" ? "active" : "")"
                                                    href="@Url.Action("OverviewCloudComputing", "AzureDevOps")">Overview of
                                                    Cloud Computing
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Introduction to Microsoft Azure" ? "active" : "")"
                                                    href="@Url.Action("IntroductionAzure", "AzureDevOps")">Introduction to
                                                    Microsoft Azure
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "What is Azure DevOps?" ? "active" : "")"
                                                    href="@Url.Action("WhatIsAzureDevOps", "AzureDevOps")">What is Azure
                                                    DevOps?
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Key Azure DevOps Services" ? "active" : "")"
                                                    href="@Url.Action("KeyAzureDevOpsServices", "AzureDevOps")">Key Azure
                                                    DevOps Services
                                                </a>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Setting Up Azure DevOps -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#SettingUpAzureDevOpsMenu" role="button"
                                            aria-expanded="@(new List<string> { "Creating a Microsoft Azure account", "Setting up an Azure DevOps Organization", "Navigating Azure DevOps UI", "Creating and Managing Projects" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="SettingUpAzureDevOpsMenu">
                                            Setting Up Azure DevOps
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "Creating a Microsoft Azure account", "Setting up an Azure DevOps Organization", "Navigating Azure DevOps UI", "Creating and Managing Projects" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="SettingUpAzureDevOpsMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Creating a Microsoft Azure account" ? "active" : "")"
                                                    href="@Url.Action("CreateAzureAccount", "AzureDevOps")">Creating a
                                                    Microsoft Azure account
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Setting up an Azure DevOps Organization" ? "active" : "")"
                                                    href="@Url.Action("SetupAzureDevOpsOrg", "AzureDevOps")">Setting up an
                                                    Azure DevOps Organization
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Navigating Azure DevOps UI" ? "active" : "")"
                                                    href="@Url.Action("NavigateAzureDevOpsUI", "AzureDevOps")">Navigating
                                                    Azure DevOps UI
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Creating and Managing Projects" ? "active" : "")"
                                                    href="@Url.Action("ManageAzureDevOpsProjects", "AzureDevOps")">Creating
                                                    and Managing Projects
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <!-- Version Control with Azure Repos -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#VersionControlAzureReposMenu" role="button"
                                            aria-expanded="@(new List<string> { "Introduction to Azure Repos", "Git vs TFVC", "Creating Repositories", "Cloning, Branching, Merging", "Pull Requests & Code Reviews" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="VersionControlAzureReposMenu">
                                            Version Control with Azure Repos
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "Introduction to Azure Repos", "Git vs TFVC", "Creating Repositories", "Cloning, Branching, Merging", "Pull Requests & Code Reviews" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="VersionControlAzureReposMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Introduction to Azure Repos" ? "active" : "")"
                                                    href="@Url.Action("IntroAzureRepos", "AzureDevOps")">Introduction to
                                                    Azure Repos
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Git vs TFVC" ? "active" : "")"
                                                    href="@Url.Action("GitVsTFVC", "AzureDevOps")">Git vs TFVC
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Creating Repositories" ? "active" : "")"
                                                    href="@Url.Action("CreateAzureRepo", "AzureDevOps")">Creating
                                                    Repositories
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Cloning, Branching, Merging" ? "active" : "")"
                                                    href="@Url.Action("CloningBranchingMerging", "AzureDevOps")">Cloning,
                                                    Branching, Merging
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Pull Requests & Code Reviews" ? "active" : "")"
                                                    href="@Url.Action("PullRequestsCodeReviews", "AzureDevOps")">Pull
                                                    Requests & Code Reviews
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <!-- Agile & Project Management with Azure Boards -->
                                    <h5 class="mt-2">
                                        <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse"
                                            href="#AgileProjectManagementMenu" role="button"
                                            aria-expanded="@(new List<string> { "Introduction to Agile & Scrum", "Work Items, Epics, Features, User Stories", "Sprint Planning & Backlog Management", "Boards, Queries, Charts" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                            aria-controls="AgileProjectManagementMenu">
                                            Agile & Project Management with Azure Boards
                                        </a>
                                    </h5>

                                    <div class="collapse @(new List<string> { "Introduction to Agile & Scrum", "Work Items, Epics, Features, User Stories", "Sprint Planning & Backlog Management", "Boards, Queries, Charts" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                        id="AgileProjectManagementMenu">
                                        <ul class="nav flex-column ms-3">
                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Introduction to Agile & Scrum" ? "active" : "")"
                                                    href="@Url.Action("IntroAgileScrum", "AzureDevOps")">Introduction to
                                                    Agile & Scrum
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Work Items, Epics, Features, User Stories" ? "active" : "")"
                                                    href="@Url.Action("WorkItemsEpicsFeatures", "AzureDevOps")">Work Items,
                                                    Epics, Features, User Stories
                                                </a>
                                            </li>

                                            <li>
                                                <a class="nav-link @(ViewData["ActivePage"] as string == "Sprint Planning & Backlog Management" ? "active" : "")"
                                                    href="@Url.Action("SprintPlanningBacklog", "AzureDevOps")">Sprint
                                                    Planning & Backlog Management
                                                </a>
