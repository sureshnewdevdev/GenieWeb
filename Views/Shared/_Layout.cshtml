    <!-- Custom Styles -->
    <style>
        .navbar-nav .nav-link.active-link {
            background-color: yellow !important;
            color: black !important;
            border-radius: 5px;
            padding: 5px 10px;
        }

        /* Sidebar styles */
        .sidebar {
            height: calc(100vh - 56px);
            overflow-y: auto;
            position: fixed;
            top: 56px;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }

        .sidebar .nav-link {
            color: #333;
            font-weight: 500;
        }

        .sidebar .nav-link.active {
            background-color: #e9ecef;
            color: #000;
        }

        /* Ensure main content doesn't overlap with sidebar */
        @@media (min-width: 768px) {
            .main-content {
                margin-left: 16.666667%;
            }
        }

        /* Mobile responsive styles */
        @@media (max-width: 767.98px) {
            .sidebar {
                position: static;
                height: auto;
            }
            .main-content {
                margin-left: 0;
            }
            #sidebarMenu {
                margin-bottom: 1rem;
            }
        }

        /* Style for the nested navigation */
        .nav-section {
            padding-left: 1rem;
        }

        .section-heading {
            font-size: 1rem;
            font-weight: 600;
            margin: 1rem 0 0.5rem 0;
            padding-left: 0.5rem;
        }

        /* Hover effect for navigation links */
        .nav-link:hover {
            background-color: rgba(0,0,0,0.05);
        }
    </style>

