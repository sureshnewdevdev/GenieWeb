                <span class="navbar-toggler-icon"></span>
                <span class="fw-semibold">
                    @(string.IsNullOrEmpty(ViewData["ActiveMenu"] as string) ? "☰ Quick Actions" : ("☰ " + ViewData["ActiveMenu"] as string) + " Items")
                </span>
            </button>
        </div>
    </div>
            <!--script to toggle the dropdown content active the bottom -->
