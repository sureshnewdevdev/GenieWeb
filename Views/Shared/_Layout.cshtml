<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="itg-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container-xxl">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                    <span class="brand-text">ItTechGenie</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-3 mb-lg-0 gap-lg-1">
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Courses">Courses</a></li>
                        <li class="nav-item"><a class="nav-link" href="/LearningPaths">Learning Paths</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Practice">Practice</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Resources</a>
                            <ul class="dropdown-menu dropdown-menu-lg-end">
                                <li><a class="dropdown-item" href="/Resources">All Resources</a></li>
                                <li><a class="dropdown-item" href="/TopicSelection">MCQs</a></li>
                                <li><a class="dropdown-item" href="/Practice">Assessments</a></li>
                                <li><a class="dropdown-item" href="/Courses/Syllabus">Syllabus</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Contact">Contact</a></li>
                    </ul>

                    <div class="d-grid d-lg-flex gap-2 nav-cta-group">
                        <a href="/Courses/Demo" class="btn btn-itg-primary">Join Free Demo</a>
                        <a href="/Courses/Syllabus" class="btn btn-itg-outline">View Syllabus</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="itg-main">
        @RenderBody()
    </main>

    <footer class="itg-footer">
        <div class="container-xxl py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="footer-title">ItTechGenie</h5>
                    <p class="footer-text mb-3">Premium technical training platform for students, job seekers, working professionals, and corporate teams.</p>
                    <a href="https://wa.me/910000000000" class="btn btn-sm btn-itg-primary"><i class="bi bi-whatsapp me-1"></i> Join Community</a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Courses">Courses</a></li>
                        <li><a href="/LearningPaths">Learning Paths</a></li>
                        <li><a href="/Practice">Practice</a></li>
                        <li><a href="/Contact">Contact</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="footer-heading">Categories</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/DotNet">.NET Core</a></li>
                        <li><a href="/AzureDevOps">Azure DevOps</a></li>
                        <li><a href="/React">React</a></li>
                        <li><a href="/DataBricks">Databricks</a></li>
                        <li><a href="/CSharp/CSharpAdvanced">C# Advanced</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="footer-heading">Practice Zone</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/TopicSelection">MCQs</a></li>
                        <li><a href="/Practice">Assessments</a></li>
                        <li><a href="/Practice">Coding Exercises</a></li>
                        <li><a href="/Practice">Interview Questions</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h6 class="footer-heading">Resources</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/Courses/Syllabus">Syllabus</a></li>
                        <li><a href="/Home/Privacy">Privacy Policy</a></li>
                        <li><a href="mailto:ittechgenie1@gmail.com">ittechgenie1@gmail.com</a></li>
                    </ul>
                    <div class="d-flex gap-2 mt-2">
                        <a href="#" aria-label="LinkedIn" class="social-link"><i class="bi bi-linkedin"></i></a>
                        <a href="#" aria-label="YouTube" class="social-link"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="Telegram" class="social-link"><i class="bi bi-telegram"></i></a>
                    </div>
                </div>
            </div>

            <hr class="footer-divider" />
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small text-secondary">
                <span>© @DateTime.UtcNow.Year ItTechGenie. All rights reserved.</span>
                <a href="/Home/Privacy" class="text-decoration-none text-secondary">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
