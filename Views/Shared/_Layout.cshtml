    @* Scrolls the side bar to the activepage*@
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            let sidebar = document.getElementById("sidebarMenu");
            let activeElement = sidebar.querySelector(".nav-link.active");

            if (activeElement) {
                // Scroll to the active element when the sidebar opens
                function scrollToActivePage() {
                    if (window.innerWidth <= 426) { // Only apply this on small screens
                        activeElement.scrollIntoView({ behavior: "smooth", block: "center" });
                    }
                }

                // Call this when the sidebar is toggled
                document.getElementById("contentdropdownbtn").addEventListener("click", function () {
                    setTimeout(scrollToActivePage, 300); // Small delay for smooth transition
                });

                activeElement.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        });

        // Toggle navbar for mobile view
        function toggleNavbar() {
            var navbar = document.getElementById('navbarNav');
            navbar.classList.toggle('show');
        }

        // Toggle sidebar for mobile view
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebarMenu');
            sidebar.classList.toggle('collapse'); // Toggle Bootstrap collapse class
        }

        // Toggle dropdowns inside the sidebar menu
        function toggleDropdown(menuId, element) {
            var menu = document.getElementById(menuId);
            var icon = element.querySelector(".dropdown-icon");

            if (menu.classList.contains("show")) {
                menu.classList.remove("show"); // Close dropdown
                icon.classList.remove("rotate"); // Reset icon
            } else {
                // Close all other dropdowns before opening the clicked one
                document.querySelectorAll(".collapse.show").forEach(function (openMenu) {
                    openMenu.classList.remove("show");
                    if (openMenu.previousElementSibling) {
                        let prevIcon = openMenu.previousElementSibling.querySelector(".dropdown-icon");
                        if (prevIcon) prevIcon.classList.remove("rotate");
                    }
                });

                menu.classList.add("show"); // Open dropdown
                icon.classList.add("rotate"); // Rotate icon
            }
        }

    </script>
    

<style>
        .dropdown-icon {
            transition: transform 0.3s ease;
        }

            .dropdown-icon.rotate {
                transform: rotate(90deg);
            }

    </style>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
