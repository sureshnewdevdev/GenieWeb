                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "CSharp" ? "active" : "")" href="@Url.Action("IntroductionToCSharp", "CSharp")">C#</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Azure" ? "active" : "")" href="@Url.Action("Azure", "Home")">Azure</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "DotNetCore" ? "active" : "")" href="@Url.Action("DotNetCore", "Home")">.NET Core</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "React" ? "active" : "")" href="@Url.Action("IntroductionToReact", "React")">React</a>
                    </li>
