<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Custom Styles for Active Link Highlight -->
    <style>
        .navbar-nav .nav-link.active-link {
            background-color: yellow !important;
            color: black !important;
            border-radius: 5px;
            padding: 5px 10px;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Google AdSense script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2270827713894017"
        crossorigin="anonymous"></script>
</head>

<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <!-- Logo Placeholder -->
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/logo-placeholder.png" alt="Logo" width="40" height="40" class="me-2" />
                ItTechGenie
            </a>
            <!-- Navigation Links directly next to brand -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-3">
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "Home" ? "active-link" : "")"
                            href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "CSharp" ? "active-link" : "")"
                            href="@Url.Action("CSharp", "Home")">C#</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "DotNetCore" ? "active-link" : "")"
                            href="@Url.Action("DotNetCore", "Home")">.NET Core</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "React" ? "active-link" : "")"
                            href="@Url.Action("IntroductionToReact", "React")">React</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "Azure" ? "active-link" : "")"
                            href="@Url.Action("Azure", "Home")">Azure</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewData["ActiveMenu"] as string) == "Privacy" ? "active-link" : "")"
                            href="@Url.Action("Privacy", "Home")">Privacy</a>
                    </li>
                </ul>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Left Menu with Scrollable Feature -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse"
                style="height: 100vh; overflow-y: auto;">
                <div class="position-sticky pt-3">
                    <h4>Navigate here to Learn</h4>
                    <ul class="nav flex-column">

                        <!-- Show all modules when on Home -->
                        @if (string.IsNullOrEmpty(ViewData["ActiveMenu"] as string))
                        {
                            <li class="nav-item">
                                <h5 class="mt-2">C#</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link"
                                            href="@Url.Action("IntroductionToCSharp", "CSharp")">Introduction
                                            to C#</a></li>
                                    <li><a class="nav-link" href="@Url.Action("FeaturesOfCSharp", "CSharp")">Features of
                                            C#</a></li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <h5 class="mt-2">.NET Core</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link"
                                            href="@Url.Action("IntroductionToDotNetCore", "Home")">Introduction to .NET
                                            Core</a></li>
                                    <li><a class="nav-link" href="@Url.Action("DotNetCoreFeatures", "Home")">Features of
                                            .NET Core</a></li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <h5 class="mt-2">Azure</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link" href="@Url.Action("IntroductionToAzure", "Home")">Introduction
                                            to Azure</a></li>
                                    <li><a class="nav-link" href="@Url.Action("AzureServices", "Home")">Azure Services
                                            Overview</a></li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <h5 class="mt-2">Privacy & Security</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link" href="@Url.Action("PrivacyPolicy", "Home")">Privacy Policy</a>
                                    </li>
                                    <li><a class="nav-link" href="@Url.Action("TermsAndConditions", "Home")">Terms and
                                            Conditions</a></li>
                                </ul>
                            </li>
                        }

                        <!-- C# Sidebar (Only shown when ActiveMenu = CSharp) -->
                        @if ((ViewData["ActiveMenu"] as string) == "CSharp")
                        {
                            <li class="nav-item">

                                <!-- C# Basics Dropdown -->
                                <h5 class="mt-2">
                                    <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse" href="#csBasicsMenu"
                                        role="button"
                                        aria-expanded="@(new List<string> { "IntroductionToCSharp", "FeaturesOfCSharp", "CSharpCompliationAndExecution", "GeneralStructureOfCSharp", "CreatingAndUsingDLL" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                        aria-controls="csBasicsMenu">
                                        C# Basics
                                    </a>
                                </h5>

                                <div class="collapse @(new List<string> { "IntroductionToCSharp", "FeaturesOfCSharp", "CSharpCompliationAndExecution", "GeneralStructureOfCSharp", "CreatingAndUsingDLL" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                    id="csBasicsMenu">
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "IntroductionToCSharp" ? "active" : "")"
                                                href="@Url.Action("IntroductionToCSharp", "CSharp")">Introduction to C#</a>
                                        </li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "FeaturesOfCSharp" ? "active" : "")"
                                                href="@Url.Action("FeaturesOfCSharp", "CSharp")">Features of C#</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "CSharpCompliationAndExecution" ? "active" : "")"
                                                href="@Url.Action("CSharpCompliationAndExecution", "CSharp")">C# Compilation
                                                and Execution</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "GeneralStructureOfCSharp" ? "active" : "")"
                                                href="@Url.Action("GeneralStructureOfCSharp", "CSharp")">General Structure
                                                of a C# Program</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "CreatingAndUsingDLL" ? "active" : "")"
                                                href="@Url.Action("CreatingAndUsingDLL", "CSharp")">Creating and Using a
                                                DLL</a></li>
                                    </ul>
                                </div>

                                <!-- Data Types and Arrays Dropdown -->
                                <h5 class="mt-2">
                                    <a class="nav-link text-dark fw-bold" data-bs-toggle="collapse" href="#dataTypesMenu"
                                        role="button"
                                        aria-expanded="@(new List<string> { "DataTypesAndArrays", "ValueAndReferenceType", "BoxingUnBoxing", "TypeOfArrays", "NullableTypes", "ImplicitTypeLocalvariables", "VarvsDynamic", "IsAndAsOperators", "RefVsOutKeywords", "ObjectBaseClass", "EqualsVsEqual", "StringVsStringBuilder", "VariousStringMethods", "DefaultNamedParameters", "ParseTryParseVsConvert" }.Contains(ViewData["ActivePage"] as string ?? "") ? "true" : "false")"
                                        aria-controls="dataTypesMenu">
                                        Data Types and Arrays
                                    </a>
                                </h5>

                                <div class="collapse @(new List<string> { "DataTypesAndArrays", "ValueAndReferenceType", "BoxingUnBoxing", "TypeOfArrays", "NullableTypes", "ImplicitTypeLocalvariables", "VarvsDynamic", "IsAndAsOperators", "RefVsOutKeywords", "ObjectBaseClass", "EqualsVsEqual", "StringVsStringBuilder", "VariousStringMethods", "DefaultNamedParameters", "ParseTryParseVsConvert" }.Contains(ViewData["ActivePage"] as string ?? "") ? "show" : "")"
                                    id="dataTypesMenu">
                                    <ul class="nav flex-column ms-3">
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "DataTypesAndArrays" ? "active" : "")"
                                                href="@Url.Action("DataTypesAndArrays", "CSharp")">Data Types and Arrays in
                                                C#</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "ValueAndReferenceType" ? "active" : "")"
                                                href="@Url.Action("ValueAndReferenceType", "CSharp")">Value Types and
                                                Reference Types</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "BoxingUnBoxing" ? "active" : "")"
                                                href="@Url.Action("BoxingUnBoxing", "CSharp")">Boxing and UnBoxing</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "TypeOfArrays" ? "active" : "")"
                                                href="@Url.Action("TypeOfArrays", "CSharp")">Single Dimensional,
                                                Multi-Dimensional & Jagged Arrays</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "NullableTypes" ? "active" : "")"
                                                href="@Url.Action("NullableTypes", "CSharp")">Nullable Types</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "ImplicitTypeLocalvariables" ? "active" : "")"
                                                href="@Url.Action("ImplicitTypeLocalvariables", "CSharp")">Implicitly Typed
                                                Local Variables</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "VarvsDynamic" ? "active" : "")"
                                                href="@Url.Action("VarvsDynamic", "CSharp")">Var vs dynamic</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "IsAndAsOperators" ? "active" : "")"
                                                href="@Url.Action("IsAndAsOperators", "CSharp")">Is and As Operator</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "RefVsOutKeywords" ? "active" : "")"
                                                href="@Url.Action("RefVsOutKeywords", "CSharp")">Ref vs Out Keywords</a>
                                        </li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "ObjectBaseClass" ? "active" : "")"
                                                href="@Url.Action("ObjectBaseClass", "CSharp")">The 'object' Base Class in
                                                .NET</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "EqualsVsEqual" ? "active" : "")"
                                                href="@Url.Action("EqualsVsEqual", "CSharp")">Equals() vs ==</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "StringVsStringBuilder" ? "active" : "")"
                                                href="@Url.Action("StringVsStringBuilder", "CSharp")">String vs
                                                StringBuilder</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "VariousStringMethods" ? "active" : "")"
                                                href="@Url.Action("VariousStringMethods", "CSharp")">Various String Class
                                                Methods</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "DefaultNamedParameters" ? "active" : "")"
                                                href="@Url.Action("DefaultNamedParameters", "CSharp")">Default Parameters,
                                                Named Parameters</a></li>
                                        <li><a class="nav-link @(ViewData["ActivePage"] as string == "ParseTryParseVsConvert" ? "active" : "")"
                                                href="@Url.Action("ParseTryParseVsConvert", "CSharp")">Parse() vs TryParse()
                                                vs Convert Class Methods</a></li>
                                    </ul>
                                </div>

                            </li>
                        }


                        <!-- .NET Core Sidebar (Only shown when ActiveMenu = DotNetCore) -->
                        @if ((ViewData["ActiveMenu"] as string) == "DotNetCore")
                        {
                            <li class="nav-item">
                                <h5 class="mt-2">.NET Core Basics</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link"
                                            href="@Url.Action("IntroductionToDotNetCore", "Home")">Introduction to .NET
                                            Core</a></li>
                                    <li><a class="nav-link" href="@Url.Action("DotNetCoreFeatures", "Home")">Features of
                                            .NET Core</a></li>
                                </ul>
                            </li>
                        }

                        <!-- .NET Core Sidebar (Only shown when ActiveMenu = DotNetCore) -->
                        @if ((ViewData["ActiveMenu"] as string) == "React")
                        {
                            <li class="nav-item">
                                <h5 class="mt-2">React Basics</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link" href="@Url.Action("IntroductionToReact", "React")">Introduction
                                            to .NET
                                            Core</a></li>
                                </ul>
                            </li>
                        }

                        <!-- Azure Sidebar (Only shown when ActiveMenu = Azure) -->
                        @if ((ViewData["ActiveMenu"] as string) == "Azure")
                        {
                            <li class="nav-item">
                                <h5 class="mt-2">Azure Basics</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link" href="@Url.Action("IntroductionToAzure", "Home")">Introduction
                                            to Azure</a></li>
                                    <li><a class="nav-link" href="@Url.Action("AzureServices", "Home")">Azure Services
                                            Overview</a></li>
                                </ul>
                            </li>
                        }

                        <!-- Privacy Sidebar (Only shown when ActiveMenu = Privacy) -->
                        @if ((ViewData["ActiveMenu"] as string) == "Privacy")
                        {
                            <li class="nav-item">
                                <h5 class="mt-2">Privacy & Security</h5>
                                <ul class="nav flex-column ms-3">
                                    <li><a class="nav-link" href="@Url.Action("PrivacyPolicy", "Home")">Privacy Policy</a>
                                    </li>
                                    <li><a class="nav-link" href="@Url.Action("TermsAndConditions", "Home")">Terms and
                                            Conditions</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">@ViewData["Title"]</h1>
                </div>
                <div>
                    @RenderBody()
                </div>

                <!-- Google AdSense ad -->
                <div class="ads-container">
                    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2270827713894017"
                        data-ad-slot="3993585551" data-ad-format="auto" data-full-width-responsive="true"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
