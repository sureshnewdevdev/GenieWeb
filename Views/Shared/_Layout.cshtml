<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ItTechGenie</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Custom Styles -->
    <style>
        .navbar-nav .nav-link.active-link {
            background-color: yellow !important;
            color: black !important;
            border-radius: 5px;
            padding: 5px 10px;
        }

        /* Sidebar styles */
        .sidebar {
            height: calc(100vh - 56px);
            overflow-y: auto;
            position: fixed;
            top: 56px;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }

        .sidebar .nav-link {
            color: #333;
            font-weight: 500;
        }

        .sidebar .nav-link.active {
            background-color: #e9ecef;
            color: #000;
        }

        /* Ensure main content doesn't overlap with sidebar */
        @@media (min-width: 768px) {
            .main-content {
                margin-left: 16.666667%;
            }
        }

        /* Mobile responsive styles */
        @@media (max-width: 767.98px) {
            .sidebar {
                position: static;
                height: auto;
            }
            .main-content {
                margin-left: 0;
            }
            #sidebarMenu {
                margin-bottom: 1rem;
            }
        }

        /* Hover effect for navigation links */
        .nav-link:hover {
            background-color: rgba(0,0,0,0.05);
        }
    </style>

    <!-- Google AdSense script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2270827713894017"
            crossorigin="anonymous"></script>
</head>
<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/css/Images/logo.png" alt="Logo" width="40" height="40" class="me-2" />
                ItTechGenie
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Home" ? "active-link" : "")"
                           href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "CSharp" ? "active-link" : "")"
                           href="@Url.Action("CSharp", "Home")">C#</a>
                    </li>
                    @* <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Cassendra" ? "active-link" : "")"
                               href="@Url.Action("CSharp", "Home")">C#</a>
                        </li> *@
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Privacy" ? "active-link" : "")"
                           href="@Url.Action("Privacy", "Privacy")">Privacy</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="container-fluid" style="margin-top: 56px;">
        <div class="row">
            <!-- Left Menu - Always visible on desktop -->
            <div id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <h4 class="px-3">Navigate here to Learn</h4>
                    <ul class="nav flex-column">

                        <!-- C# Basics Section -->
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#collapseCSharpBasics" role="button" aria-expanded="false" aria-controls="collapseCSharpBasics">
                                C# Basics
                            </a>
                            <div @* class="collapse" *@ id="collapseCSharpBasics">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("IntroductionToCSharp", "CSharp")">Introduction to C#</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("FeatureOfCSharp", "CSharp")">Features of C#</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("CSharpCompliationAndExecution", "CSharp")">C# Compilation and Execution</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("GeneralStructureOfCSharp", "CSharp")">General Structure of a C# Program</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("CreatingAndUsingDLL", "CSharp")">Creating and Using a DLL</a></li>
                                </ul>
                            </div>
                        </li>

                        <!-- Data Types and Arrays Section -->
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#collapseDataTypes" role="button" aria-expanded="false" aria-controls="collapseDataTypes">
                                Data Types and Arrays
                            </a>
                            <div class="collapse" id="collapseDataTypes">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("DataTypesAndArrays", "CSharp")">Data Types and Arrays in C#</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ValueAndReferenceType", "CSharp")">Value Types and Reference Types</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("BoxingUnBoxing", "CSharp")">Boxing and UnBoxing</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("TypeOfArrays", "CSharp")">Type of Arrays</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("NullableTypes", "CSharp")">Nullable Types</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ImplicitTypeLocalvariables", "CSharp")">Implicitly Typed Local Variables</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("VarvsDynamic", "CSharp")">Var vs Dynamic</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("IsAndAsOperator", "CSharp")">Is and As Operator</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("RefVsOutKeywords", "CSharp")">Ref vs Out Keywords</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ObjectBaseClass", "CSharp")">The ‘Object’ Base Class in .NET</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("EqualsVsEqual", "CSharp")">Equals() vs ==</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("StringVsStringBuilder", "CSharp")">String vs StringBuilder</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("VariousStringMethods", "CSharp")">Various String Class Methods</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("DefaultNamedParameters", "CSharp")">Default Parameters, Named Parameters</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ParseTryParseVsConvert", "CSharp")">Parse() vs TryParse() vs Convert</a></li>
                                </ul>
                            </div>
                        </li>

                        <!-- OOPS in C# Section -->
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#collapseOOPSCSharp" role="button" aria-expanded="false" aria-controls="collapseOOPSCSharp">
                                OOPS in C#
                            </a>
                            <div class="collapse" id="collapseOOPSCSharp">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("OOPWithCSharp", "CSharp")">OOP with C#</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("StructuresAndEnums", "CSharp")">Structures and Enums</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ArchitectureOfClass", "CSharp")">The Architecture of a Class</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("InstanceClassReference", "CSharp")">Instance, Class & Reference Variables</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AccessModifier", "CSharp")">Access Modifier</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AbstractClasses", "CSharp")">Abstract Classes</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ResultAfterCallingFunction", "CSharp")">Delegates Example</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("BaseClassLibrary", "CSharp")">.NET Base Class Library</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("InheritanceinCSharp", "CSharp")">Inheritance in C#</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MethodOverloading", "CSharp")">Method Overloading</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MethodOverriding", "CSharp")">Method Overriding</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("OperatorOverloading", "CSharp")">Operator Overloading</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MethodHiding", "CSharp")">Method Hiding</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AccessModifiers", "CSharp")">Access Modifiers</a></li>
                                </ul>
                            </div>
                        </li>

                        <!-- Advanced C# Concepts Section -->
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#collapseAdvancedCSharp" role="button" aria-expanded="false" aria-controls="collapseAdvancedCSharp">
                                Advanced C# Concepts
                            </a>
                            <div class="collapse" id="collapseAdvancedCSharp">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AnonymousTypes", "CSharp")">Anonymous Types</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AbstractClasses", "CSharp")">Abstract Classes</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("SealedClasses", "CSharp")">Sealed Classes</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("CreatingInterfaces", "CSharp")">Creating Interfaces</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ImplementingInterfaceInheritance", "CSharp")">Interface Inheritance</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("DeclaringpropeWithinInterfaces", "CSharp")">Properties in Interfaces</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Namespaces", "CSharp")">Namespaces</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("CreatingAndUsingGeneric", "CSharp")">Generics</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("IndexersAndProperties", "CSharp")">Indexers & Properties</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("AutoImplementedproperties", "CSharp")">Auto-Implemented Properties</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("StaticClasses", "CSharp")">Static Classes</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("PropertyAccessors", "CSharp")">Property Accessors</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("PartialTypes", "CSharp")">Partial Types</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ExtensionMethods", "CSharp")">Extension Methods</a></li>
                                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ObjectInitializer", "CSharp")">Object Initializer</a></li>
                                    @* <li class="nav-item"><a class="nav-link" href="@Url.Action("ObjectInitializer", "CSharp")">Object Initializer</a></li> *@
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div>
                    @RenderBody()
                </div>

                <!-- Google AdSense ad -->
                <div class="ads-container mt-4">
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2270827713894017"
                         data-ad-slot="3993585551"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>
            </main>
        </div>
    </div>

    @* <script src="https://maxcdn.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            alert("Main");
            document.querySelectorAll(".sidebar .nav-item .collapse .nav-link").forEach((submenuLink) => {
                submenuLink.addEventListener("click", function (event) {
