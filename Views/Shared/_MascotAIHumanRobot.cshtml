<div class="mascot mascot-ai-human" aria-hidden="true">
    <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" role="img">
        <ellipse cx="110" cy="196" rx="58" ry="10" fill="#0d1b2a" opacity="0.15" />

        <!-- ambient AI halo behind the head -->
        <circle cx="110" cy="60" r="50" fill="url(#haloGradient)" class="mascot-ai-halo" />

        <g class="mascot-anim mascot-bob">
            <!-- torso / suit -->
            <rect x="64" y="96" width="92" height="78" rx="26" fill="#1a4e8a" />
            <rect x="64" y="96" width="92" height="78" rx="26" fill="url(#bodyGradient2)" opacity="0.3" />

            <!-- collar + tie -->
            <path d="M100 96l10 14 10-14" fill="none" stroke="#0d1b2a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="106" y="108" width="8" height="22" rx="3" fill="#f6ad55" />

            <!-- AI core badge on chest -->
            <circle cx="110" cy="148" r="14" fill="#0d1b2a" />
            <circle cx="110" cy="148" r="9" fill="#63b3ed" class="mascot-ai-core" />

            <!-- neck -->
            <rect x="100" y="80" width="20" height="18" rx="6" fill="#e7a978" />

            <!-- head -->
            <ellipse cx="110" cy="50" rx="33" ry="35" fill="#f2b98a" />
            <path d="M78 44a32 24 0 0 1 64 0" fill="#2b6cb0" />
            <ellipse cx="98" cy="52" rx="3.6" ry="4.6" fill="#1a4e8a" class="mascot-eye" />
            <ellipse cx="122" cy="52" rx="3.6" ry="4.6" fill="#1a4e8a" class="mascot-eye" />
            <path d="M98 66c4 5 20 5 24 0" stroke="#a35c34" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <circle cx="136" cy="46" r="4" fill="#f6ad55" class="mascot-antenna" />

            <!-- resting arm -->
            <rect x="40" y="112" width="30" height="12" rx="6" fill="#1a4e8a" />

            <!-- waving arm, grouped so it rotates together -->
            <g class="mascot-arm-wave-human">
                <rect x="150" y="106" width="30" height="12" rx="6" fill="#1a4e8a" />
                <circle cx="182" cy="112" r="9" fill="#f2b98a" />
            </g>
        </g>

        <!-- floating AI sparks -->
        <circle cx="48" cy="70" r="3" fill="#63b3ed" class="mascot-spark-1" />
        <circle cx="172" cy="42" r="2.6" fill="#f6ad55" class="mascot-spark-2" />
        <circle cx="42" cy="120" r="2.2" fill="#bee3f8" class="mascot-spark-3" />

        <defs>
            <radialGradient id="haloGradient" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#63b3ed" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#63b3ed" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="bodyGradient2" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="1" stop-color="#000000" />
            </linearGradient>
        </defs>
    </svg>
</div>
