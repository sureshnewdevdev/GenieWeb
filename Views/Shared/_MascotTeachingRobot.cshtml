@model string
@{
    // variant: "corporate" (points at a whiteboard) or "learners" (points at a course catalog)
    var variant = Model ?? "corporate";
    var propLabel = variant == "learners" ? "Courses" : "Q1 Roadmap";
}
<div class="mascot mascot-teaching-robot mascot-teaching-@variant" aria-hidden="true">
    <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" role="img">
        <ellipse cx="110" cy="196" rx="60" ry="10" fill="#0d1b2a" opacity="0.15" />

        <!-- board / catalog panel -->
        <g class="mascot-board">
            <rect x="130" y="40" width="76" height="56" rx="6" fill="#ffffff" stroke="#2f855a" stroke-width="3" />
            <text x="168" y="72" font-size="12" text-anchor="middle" fill="#2f855a" font-family="Arial, sans-serif">@propLabel</text>
            <line x1="140" y1="80" x2="196" y2="80" stroke="#2f855a" stroke-width="2" class="mascot-board-line" />
        </g>

        <g class="mascot-anim mascot-bob">
            <!-- body -->
            <rect x="44" y="96" width="92" height="74" rx="18" fill="#2f855a" />
            <!-- head -->
            <rect x="56" y="42" width="68" height="58" rx="18" fill="#276749" />
            <circle cx="76" cy="70" r="4" fill="#c6f6d5" class="mascot-eye" />
            <circle cx="104" cy="70" r="4" fill="#c6f6d5" class="mascot-eye" />
            <rect x="87" y="26" width="6" height="18" fill="#276749" />
            <circle cx="90" cy="24" r="6" fill="#f6ad55" class="mascot-antenna" />

            <!-- pointing arm -->
            <rect x="118" y="104" width="46" height="10" rx="5" fill="#276749" class="mascot-point-arm" />
        </g>
    </svg>
</div>
