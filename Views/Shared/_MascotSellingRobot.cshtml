<div class="mascot mascot-selling-robot" aria-hidden="true">
    <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" role="img">
        <ellipse cx="110" cy="196" rx="60" ry="10" fill="#0d1b2a" opacity="0.15" />

        <!-- spotlight sweep -->
        <path d="M110 10 L40 130 L180 130 Z" fill="#fff3c4" class="mascot-spotlight" />

        <g class="mascot-anim mascot-bob">
            <!-- body -->
            <rect x="58" y="94" width="96" height="76" rx="18" fill="#dd6b20" />
            <!-- head -->
            <rect x="70" y="40" width="72" height="60" rx="18" fill="#c05621" />
            <circle cx="90" cy="68" r="4" fill="#fffaf0" class="mascot-eye" />
            <circle cx="118" cy="68" r="4" fill="#fffaf0" class="mascot-eye" />
            <rect x="102" y="24" width="6" height="18" fill="#c05621" />
            <circle cx="105" cy="22" r="6" fill="#f6ad55" class="mascot-antenna" />

            <!-- raised arm holding product -->
            <rect x="146" y="80" width="12" height="40" rx="6" fill="#c05621" class="mascot-raise-arm" />
            <rect x="140" y="60" width="34" height="26" rx="4" fill="#38a169" class="mascot-product-box" />

            <!-- other arm -->
            <rect x="36" y="112" width="30" height="10" rx="5" fill="#c05621" />
        </g>
    </svg>
</div>
