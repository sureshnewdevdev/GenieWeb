@model string
@{
    var areas = new (string Key, string Label, string Route)[]
    {
        ("AIConsultant", "AI Consultant", "/AIConsultant"),
        ("CorporateTraining", "Corporate Training", "/CorporateTraining"),
        ("Learners", "Learners", "/Learners"),
        ("SocialMessages", "Social Messages", "/SocialMessages"),
        ("ProductGallery", "Product Gallery", "/ProductGallery"),
    };
}
<nav class="navbar navbar-expand-lg hub-area-nav">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="~/css/Images/Vinayaga.jpg" alt="ItTechGenie logo" width="36" height="36" class="me-2 rounded-circle" />
            <span class="fw-bold">ItTechGenie</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hubAreaNavCollapse"
                aria-controls="hubAreaNavCollapse" aria-expanded="false" aria-label="Toggle areas">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="hubAreaNavCollapse">
            <ul class="nav hub-area-tabs flex-column flex-lg-row ms-lg-auto">
                @foreach (var area in areas)
                {
                    <li class="nav-item">
                        <a class="nav-link @(Model == area.Key ? "active" : "")" href="@area.Route">@area.Label</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
