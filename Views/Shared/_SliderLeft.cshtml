@*
  File: Views/Shared/_SliderLeft.cshtml
  Purpose: Master layout for ItTechGenie course pages (Sidebar + Breadcrumb + Center Content + Ads)
  How to use in any view:
    @{
        Layout = "_SliderLeft";
        ViewData["Title"] = "Selenium";      // becomes ItTechGenie-Selenium
        ViewData["HeroTitle"] = "Selenium – Course Home";
        ViewData["HeroIntroHtml"] = "<b>Welcome!</b> Use the left menu to pick a topic.";
        ViewData["HeroTags"] = "Navigation Guide,Clickable Breadcrumb,Right + In-content Ads";
    }
  Optional sections:
    @section CourseData { <script>window.COURSE_DATA = ...;</script> }
    @section HeadExtras { ... }  (extra CSS links etc.)
    @section Scripts { ... }     (extra JS)
*@
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>ItTechGenie-@(ViewData["Title"] ?? "Subject")</title>

  @* Optional extra head items (page-specific CSS etc.) *@
  @RenderSection("HeadExtras", required: false)

  <style>
    :root{
      --bg:#f6f7fb;
      --panel:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --border:rgba(17,24,39,.10);
      --shadow:0 12px 28px rgba(0,0,0,.08);
      --accent:#0f766e;
      --accent2:#22c55e;

      --header-h:64px;
      --sidebar-w: 320px;
      --sidebar-mini-w: 78px;
      --ad-w: 320px;

      --radius:18px;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:var(--bg);
      color:var(--text);
      overflow-x:hidden;
    }
    a{color:inherit;text-decoration:none}
    a.link{ color:#fff; text-decoration:none; }
    a.link:hover{ text-decoration:underline; }

    /* ===== App Shell ===== */
    .app{
      display:grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      min-height:100vh;
      transition:grid-template-columns .18s ease;
    }
    .app.collapsed{ grid-template-columns: var(--sidebar-mini-w) 1fr; }

    /* ===== Sidebar ===== */
    .sidebar{
      position:fixed;
      left:0; top:0; bottom:0;
      width:var(--sidebar-w);
      background:var(--panel);
      border-right:1px solid var(--border);
      z-index:60;
      display:flex;
      flex-direction:column;
      transition:width .18s ease, transform .18s ease;
    }
    .app.collapsed .sidebar{ width:var(--sidebar-mini-w); }

    .sidebar-top{
      height:var(--header-h);
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
      border-bottom:1px solid var(--border);
      background:linear-gradient(180deg,#fff 0%,#fbfbff 100%);
      flex: 0 0 auto;
    }
    .icon-btn{
      width:40px;height:40px;
      border-radius:14px;
      border:1px solid var(--border);
      background:#fff;
      cursor:pointer;
      display:grid;
      place-items:center;
    }
    .icon-btn:hover{ box-shadow:0 8px 18px rgba(0,0,0,.08); }
    .hamburger{ width:18px;height:12px; position:relative; }
    .hamburger span{
      position:absolute;left:0;right:0;height:2px;background:#111827;border-radius:2px;
    }
    .hamburger span:nth-child(1){top:0}
    .hamburger span:nth-child(2){top:5px;opacity:.85}
    .hamburger span:nth-child(3){bottom:0;opacity:.7}

    .stack{display:flex;flex-direction:column;min-width:0}
    .title{font-weight:900;letter-spacing:.3px;line-height:1.1}
    .subtitle{font-size:12px;color:var(--muted);margin-top:2px}
    .app.collapsed .stack{display:none;}

    .search{
      padding:10px 14px;
      border-bottom:1px solid var(--border);
      flex: 0 0 auto;
    }
    .search input{
      width:100%;
      border:1px solid var(--border);
      border-radius:14px;
      padding:10px 12px;
      outline:none;
      font-size:13px;
      background:#fff;
    }
    .app.collapsed .search{display:none;}

    /* Menu scroll area */
    .menu{
      padding:10px 8px 10px 8px;
      overflow:auto;
      flex: 1 1 auto;
      min-height: 140px;
    }

    details.group{
      border-radius:14px;
      margin:8px 6px;
      border:1px solid transparent;
      transition:background .12s ease,border-color .12s ease;
    }
    details.group[open]{ background:#f8fafc;border-color:var(--border); }
    summary.group-title{
      list-style:none;
      cursor:pointer;
      display:flex;
      align-items:center;
      gap:10px;
      padding:10px 10px;
      border-radius:14px;
      user-select:none;
    }
    summary.group-title::-webkit-details-marker{display:none}
    .badge{
      width:26px;height:26px;border-radius:10px;
      display:grid;place-items:center;
      font-size:12px;
      background:rgba(15,118,110,.10);
      color:var(--accent);
      border:1px solid rgba(15,118,110,.20);
      flex:0 0 auto;
    }
    .gtext{display:flex;flex-direction:column;min-width:0}
    .gtext b{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .gtext small{font-size:12px;color:var(--muted)}
    .caret{
      margin-left:auto;
      width:10px;height:10px;
      border-right:2px solid rgba(17,24,39,.55);
      border-bottom:2px solid rgba(17,24,39,.55);
      transform:rotate(-45deg);
      transition:transform .14s ease;
    }
    details[open] .caret{transform:rotate(45deg)}
    .app.collapsed .gtext, .app.collapsed .caret{display:none}

    .submenu{
      padding:0 10px 10px 10px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }
    .item{
      display:flex;
      align-items:center;
      gap:10px;
      padding:9px 10px;
      border-radius:12px;
      font-size:13px;
      border:1px solid transparent;
      transition:background .12s ease,border-color .12s ease;
    }
    .item:hover{ background:#fff;border-color:var(--border); }
    .item.active{
      background:rgba(15,118,110,.10);
      border-color:rgba(15,118,110,.22);
      color:var(--accent);
      font-weight:800;
    }
    .dot{
      width:8px;height:8px;border-radius:999px;background:rgba(17,24,39,.35);
      flex:0 0 auto;
    }
    .item.active .dot{ background:var(--accent); }
    .app.collapsed .submenu{ padding:0 6px 10px 6px; }
    .app.collapsed .item{ justify-content:center; padding:10px; }
    .app.collapsed .item span.label{display:none}
    .app.collapsed .item .dot{width:12px;height:12px}

    /* Sidebar "space ad": shows only if there's free space */
    .side-ad{
      margin:10px 14px 12px 14px;
      border:1px dashed rgba(0,0,0,.22);
      background:#fff;
      border-radius:14px;
      padding:12px;
      display:none; /* auto-enabled by JS when space exists */
      flex: 0 0 auto;
    }
    .side-ad h4{ margin:0 0 6px 0; font-size:13px; color:var(--accent); }
    .side-ad p{ margin:0 0 10px 0; font-size:12px; color:var(--muted); }
    .side-ad .box{
      height:160px;
      border-radius:12px;
      display:flex;align-items:center;justify-content:center;
      color: rgba(15,118,110,.75);
      font-weight:800;
      background: repeating-linear-gradient(
        45deg,
        rgba(15,118,110,.10),
        rgba(15,118,110,.10) 10px,
        rgba(15,118,110,.04) 10px,
        rgba(15,118,110,.04) 20px
      );
    }
    .app.collapsed .side-ad{ display:none !important; } /* avoid cramping in mini mode */

    .sidebar-footer{
      padding:12px 14px;
      border-top:1px solid var(--border);
      font-size:12px;
      color:var(--muted);
      flex: 0 0 auto;
    }
    .app.collapsed .sidebar-footer{display:none}

    /* ===== Header (breadcrumb links) ===== */
    .header{
      position:fixed;
      top:0; right:0;
      left:var(--sidebar-w);
      height:var(--header-h);
      background:#0b1324;
      color:#fff;
      z-index:50;
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 14px;
      border-bottom:1px solid rgba(255,255,255,.08);
      transition:left .18s ease;
    }
    .app.collapsed .header{ left:var(--sidebar-mini-w); }

    .brand{
      display:flex;align-items:center;gap:10px;
      font-weight:900;letter-spacing:.3px;white-space:nowrap;
    }
    .brand .dot2{
      width:10px;height:10px;border-radius:999px;background:var(--accent2);display:inline-block;
    }

    .crumb{
      display:flex;align-items:center;gap:8px;
      min-width:0;flex:1;
      font-size:14px;opacity:.95;
    }
    .crumb .sep{opacity:.5}

    .header-actions{display:flex;align-items:center;gap:10px;margin-left:auto}
    .pill{
      font-size:12px;
      padding:6px 10px;
      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.16);
      border-radius:999px;
      white-space:nowrap;
    }
    .btn{
      border:1px solid rgba(255,255,255,.18);
      background:rgba(255,255,255,.08);
      color:#fff;
      padding:8px 10px;
      border-radius:12px;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:13px;
    }
    .btn:hover{background:rgba(255,255,255,.14)}

    /* ===== Main Layout: Center content + right ad rail ===== */
    .main{
      grid-column:2/3;
      padding-top:calc(var(--header-h) + 16px);
    }
    .container{
      max-width: 1280px;
      margin:0 auto;
      padding:0 14px 34px 14px;
    }
    .page-grid{
      display:grid;
      grid-template-columns: 1fr var(--ad-w);
      gap:14px;
      align-items:start;
      margin-top:14px;
    }

    .content-col{ min-width:0; }
    .card{
      background:var(--panel);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:16px;
      margin-bottom:14px;
      border-left:6px solid transparent;
      transition: background .14s ease, box-shadow .14s ease, transform .14s ease, border-left-color .14s ease;
    }
    .card:hover{
      background:#f8fafc;
      border-left-color:var(--accent);
      box-shadow:0 16px 34px rgba(0,0,0,.10);
      transform:translateY(-1px);
    }
    .hero h1{ margin:0; font-size:22px; }
    .hero p{ margin:8px 0 0 0; color:var(--muted); }

    .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .tag{
      font-size:12px;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid var(--border);
      background:#fff;
    }

    .section-title{ margin:0 0 8px 0; font-size:18px; }
    .muted{ color:var(--muted); }

    .split{
      display:grid;
      grid-template-columns: 1.1fr .9fr;
      gap:12px;
      margin-top:10px;
    }
    .panel{
      border:1px solid var(--border);
      border-radius:14px;
      padding:12px;
      background:#fff;
    }
    pre{
      margin:0;
      padding:12px;
      border-radius:14px;
      border:1px solid var(--border);
      background:#0b1324;
      color:#e5e7eb;
      overflow:auto;
      font-family:var(--mono);
      font-size:12.5px;
    }
    .copy-row{
      display:flex; justify-content:space-between; align-items:center;
      gap:10px; margin-bottom:8px;
    }
    .copy{
      border:1px solid var(--border);
      background:#fff;
      border-radius:12px;
      padding:8px 10px;
      cursor:pointer;
      font-size:12px;
    }
    .copy:hover{ box-shadow:0 10px 22px rgba(0,0,0,.08); }

    /* In-content Ad */
    .ad-inline{
      border:1px dashed rgba(0,0,0,.22);
      background:#fff;
      border-radius:14px;
      padding:14px;
      margin:14px 0;
    }
    .ad-box{
      height:250px;
      border-radius:12px;
      background: repeating-linear-gradient(
        45deg,
        rgba(15,118,110,.10),
        rgba(15,118,110,.10) 10px,
        rgba(15,118,110,.04) 10px,
        rgba(15,118,110,.04) 20px
      );
      display:flex; align-items:center; justify-content:center;
      color: rgba(15,118,110,.75);
      font-weight:800;
    }

    /* Right Ad Rail */
    .ad-col{ min-width:0; }
    .ad-sticky{ position:sticky; top: calc(var(--header-h) + 16px); }
    .ad-rail{
      background:#fff;
      border:1px dashed rgba(0,0,0,.22);
      border-radius:14px;
      padding:14px;
    }
    .ad-rail h4{ margin:0 0 8px 0; font-size:14px; color:var(--accent); }
    .ad-rail p{ margin:0 0 12px 0; color:var(--muted); font-size:12px; }

    /* Tooltips */
    .tt{
      position:relative;
      border-bottom:1px dotted rgba(15,118,110,.55);
      cursor:help;
      color:var(--accent);
      font-weight:700;
    }
    .tt::after{
      content:attr(data-tip);
      position:absolute;
      left:0;
      top:calc(100% + 10px);
      width:min(340px,70vw);
      background:#111827;
      color:#fff;
      padding:10px 12px;
      border-radius:12px;
      font-size:12px;
      line-height:1.35;
      box-shadow:0 12px 26px rgba(0,0,0,.28);
      opacity:0;
      pointer-events:none;
      transform:translateY(-4px);
      transition:opacity .12s ease,transform .12s ease;
      z-index:99;
    }
    .tt::before{
      content:"";
      position:absolute;
      left:14px;
      top:calc(100% + 2px);
      border:8px solid transparent;
      border-bottom-color:#111827;
      opacity:0;
      transform:translateY(-4px);
      transition:opacity .12s ease,transform .12s ease;
      z-index:99;
    }
    .tt:hover::after, .tt:hover::before{ opacity:1; transform:translateY(0); }

    /* Responsive */
    @@media (max-width: 1100px){
      .page-grid{ grid-template-columns: 1fr; }
      .ad-col{ display:none; }
      :root{ --ad-w: 0px; }
    }
    @@media (max-width: 720px){
      .sidebar{ transform:translateX(-100%); }
      body.mobile-open .sidebar{ transform:translateX(0); }
      body.mobile-open::before{
        content:"";
        position:fixed; inset:0;
        background:rgba(0,0,0,.35);
        z-index:55;
      }
      .header{ left:0 !important; }
      .app{ grid-template-columns: 1fr; }
      .main{ grid-column:1/-1; }
    }
  </style>
</head>

<body>
  <div class="app" id="appShell">
    <!-- Sidebar -->
    <aside class="sidebar" aria-label="Left navigation menu">
      <div class="sidebar-top">
        <button class="icon-btn" id="toggleSidebar" title="Toggle sidebar">
          <div class="hamburger" aria-hidden="true"><span></span><span></span><span></span></div>
        </button>
        <div class="stack">
          <div class="title">ItTechGenie</div>
          <div class="subtitle">Course Navigation</div>
        </div>
      </div>

      <div class="search">
        <input id="menuSearch" type="text" placeholder="Search topics (XPath, NUnit, ADO.NET)"/>
      </div>

      <nav class="menu" id="menu">
        <!-- populated by JS -->
      </nav>

      <!-- Sidebar "space ad" -->
      <div class="side-ad" id="sideAd">
        <h4>Menu Area Ad</h4>
        <p>Shown only when there is free space below the menu.</p>

        @* Replace this placeholder with AdSense block *@
        <div class="box">LEFT AREA AD</div>
      </div>

      <div class="sidebar-footer">
        Home shows how to use this navigation. Click a topic → center content loads. Breadcrumb items are clickable.
      </div>
    </aside>

    <!-- Header -->
    <header class="header">
      <div class="brand"><span class="dot2"></span> ItTechGenie</div>

      <!-- Breadcrumb -->
      <div class="crumb">
        <a class="link" href="#home" id="crumbHome">Home</a>
        <span class="sep">›</span>
        <a class="link" href="#" id="crumbModule">Module</a>
        <span class="sep">›</span>
        <a class="link" href="#" id="crumbTopic">Topic</a>
      </div>

      <div class="header-actions">
        <div class="pill" id="viewMode">Sidebar: Expanded</div>
        <button class="btn" id="mobileMenuBtn" style="display:none;">☰ Menu</button>
      </div>
    </header>

    <!-- Main -->
    <main class="main">
      <div class="container">
        <div class="page-grid">
          <!-- Center content -->
          <div class="content-col">
            <section class="card hero" id="hero">
              <h1 id="pageTitle">@((ViewData["HeroTitle"] ?? "ItTechGenie – Course Home"))</h1>
              <p id="pageIntro" class="muted">
                @if (ViewData["HeroIntroHtml"] != null)
                {
                  @Html.Raw(ViewData["HeroIntroHtml"])
                }
              </p>
              <div class="meta" id="pageTags"></div>
            </section>

            @* If you want to render MVC content (Razor views) under the hero, use RenderBody() *@
            @RenderBody()

            @* If you keep SPA-style course rendering, it will render into this container *@
            <div id="contentArea"></div>
          </div>

          <!-- Right ad rail (desktop) -->
          <aside class="ad-col">
            <div class="ad-sticky">
              <div class="ad-rail">
                <h4>Right Rail Ad</h4>
                <p>Sticky on desktop. Hidden on smaller screens.</p>

                @* Replace this placeholder with AdSense block *@
                <div class="ad-box" style="height:600px;">RIGHT AD (300×600)</div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </main>
  </div>

  @* Page can override course data by defining @section CourseData with window.COURSE_DATA = [...] *@
  @RenderSection("CourseData", required: false)

  <script>
    // If page didn't provide CourseData section, fall back to a small sample.
    window.COURSE_DATA = window.COURSE_DATA || [
      {
        id:"m1", badge:"1",
        title:"Module 1: Automation + Selenium",
        desc:"Basics & setup",
        topics:[
          { id:"m1-a1", title:"Introduction to Automation Testing", tags:["Regression","Smoke","CI"],
            intro:"Automation testing means running test steps using tools/scripts instead of manual work.",
            blocks:[
              { heading:"Why Automation?", html:`<p>Automation improves speed, repeatability, and coverage for repetitive scenarios.</p>` },
              { heading:"Mini Example", html:`<pre>Open("https://site.com")\nClick("#login")\nAssertText(".title","Dashboard")</pre>` }
            ]
          }
        ]
      }
    ];

    // Hero tags from ViewData["HeroTags"] (comma-separated)
    (function hydrateHeroTags(){
      const tagStr = "@(ViewData["HeroTags"] ?? "Navigation Guide,Clickable Breadcrumb,Right + In-content Ads")";
      const tags = tagStr.split(",").map(x=>x.trim()).filter(Boolean);
      const pageTags = document.getElementById("pageTags");
      pageTags.innerHTML = tags.map(t=>`<span class="tag">${t}</span>`).join("");
    })();

    // ===== DOM refs =====
    const app = document.getElementById('appShell');
    const menu = document.getElementById('menu');
    const viewMode = document.getElementById('viewMode');
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const search = document.getElementById('menuSearch');

    const crumbHome = document.getElementById('crumbHome');
    const crumbModule = document.getElementById('crumbModule');
    const crumbTopic = document.getElementById('crumbTopic');

    const pageTitle = document.getElementById('pageTitle');
    const pageIntro = document.getElementById('pageIntro');
    const pageTags = document.getElementById('pageTags');
    const contentArea = document.getElementById('contentArea');

    const sideAd = document.getElementById('sideAd');

    const mqMobile = window.matchMedia('(max-width: 720px)');

    // ===== Helpers =====
    const COURSE = window.COURSE_DATA;

    function flatten(){
      const map = new Map();
      COURSE.forEach(m=>{
        (m.topics || []).forEach(t=>{
          map.set(t.id, {module:m, topic:t});
        });
      });
      return map;
    }
    const INDEX = flatten();

    function setDocTitle(subject){
      document.title = `ItTechGenie-${subject || "Subject"}`;
    }

    function setBreadcrumb(module, topic){
      crumbModule.textContent = module ? module.title : "Module";
      crumbTopic.textContent = topic ? topic.title : "Topic";

      crumbModule.href = module ? `#${module.id}` : "#home";
      crumbTopic.href  = topic  ? `#${topic.id}`  : "#home";
    }

    function renderInContentAd(){
      return `
        <div class="ad-inline">
          <b>In-content Ad</b>
          <p class="muted" style="margin:6px 0 12px 0;">Place this between content blocks.</p>
          <!-- Replace placeholder with your AdSense <ins> -->
          <div class="ad-box">IN-CONTENT AD (responsive)</div>
        </div>
      `;
    }

    function renderHome(){
      setBreadcrumb(null, null);
      setDocTitle("@(ViewData["Title"] ?? "Subject")");

      // Keep current hero title/intro set by ViewData for MVC pages.
      // If you want JS to overwrite, uncomment below lines.
      // pageTitle.textContent = "ItTechGenie – Course Home";
      // pageIntro.innerHTML = "Use the left menu to pick a module and topic.";

      contentArea.innerHTML = `
        <article class="card">
          <h2 class="section-title">How to Navigate</h2>
          <p class="muted">Click any topic from the left menu. The content loads in the center panel.</p>
          <ul>
            <li>Breadcrumb items are clickable: Home › Module › Topic</li>
            <li>Hover highlighted words to see tooltips</li>
          </ul>
        </article>
        ${renderInContentAd()}
        <article class="card">
          <h2 class="section-title">About This Course</h2>
          <p class="muted">
            This layout is a reusable master page. You can plug your course modules/topics into <code>window.COURSE_DATA</code>
            using the <b>CourseData</b> section.
          </p>
        </article>
      `;
      ensureSidebarAdVisibility();
      clearActive();
    }

    function renderTopic(module, topic){
      // Title + breadcrumb
      setBreadcrumb(module, topic);
      setDocTitle(topic.title || "@(ViewData["Title"] ?? "Subject")");

      // If you want JS to control hero, you can set these:
      pageTitle.textContent = topic.title || "";
      pageIntro.textContent = topic.intro || "";

      // Tags
      pageTags.innerHTML = (topic.tags || []).map(x=>`<span class="tag">${x}</span>`).join("");

      const blocks = [];
      (topic.blocks || []).forEach((b, i)=>{
        blocks.push(`
          <article class="card">
            <h2 class="section-title">${b.heading || ""}</h2>
            ${b.html || ""}
          </article>
        `);
        if(i === 0) blocks.push(renderInContentAd());
      });

      contentArea.innerHTML = blocks.join("");
      ensureSidebarAdVisibility();
      activateItem(topic.id);
    }

    function clearActive(){
      menu.querySelectorAll("a.item").forEach(a=>a.classList.remove("active"));
    }
    function activateItem(topicId){
      clearActive();
      const el = menu.querySelector(`a.item[data-topicid="${topicId}"]`);
      if(el) el.classList.add("active");
    }

    function renderMenu(){
      menu.innerHTML = COURSE.map(m=>{
        const topicLinks = (m.topics || []).map(t=>`
          <a class="item" href="#${t.id}" data-moduleid="${m.id}" data-topicid="${t.id}">
            <span class="dot"></span><span class="label">${t.title}</span>
          </a>
        `).join("");

        return `
          <details class="group" open>
            <summary class="group-title">
              <div class="badge">${m.badge || ""}</div>
              <div class="gtext">
                <b>${m.title || ""}</b>
                <small>${m.desc || ""}</small>
              </div>
              <div class="caret"></div>
            </summary>
            <div class="submenu">${topicLinks}</div>
          </details>
        `;
      }).join("");
    }

    function autoCollapseAfterSelection(){
      if(!mqMobile.matches && !app.classList.contains("collapsed")){
        app.classList.add("collapsed");
        viewMode.textContent = "Sidebar: Shrunk";
      }
    }

    function navigate(hash){
      const h = (hash || "#home").replace("#","");
      if(!h || h === "home"){
        renderHome();
        return;
      }
      const module = COURSE.find(x=>x.id === h);
      if(module && module.topics && module.topics.length){
        renderTopic(module, module.topics[0]);
        return;
      }
      const found = INDEX.get(h);
      if(found){
        renderTopic(found.module, found.topic);
      }else{
        renderHome();
      }
    }

    // Sidebar ad visible only if there is free space
    function ensureSidebarAdVisibility(){
      if(app.classList.contains("collapsed") || mqMobile.matches){
        sideAd.style.display = "none";
        return;
      }
      const sidebar = document.querySelector(".sidebar");
      const top = document.querySelector(".sidebar-top");
      const searchBar = document.querySelector(".search");
      const footer = document.querySelector(".sidebar-footer");
      const menuEl = document.querySelector(".menu");
      const used = top.offsetHeight + searchBar.offsetHeight + menuEl.offsetHeight + footer.offsetHeight + 34;
      const free = sidebar.clientHeight - used;
      sideAd.style.display = free >= 230 ? "block" : "none";
    }

    // ===== UI wiring =====
    document.getElementById("toggleSidebar").addEventListener("click", ()=>{
      app.classList.toggle("collapsed");
      viewMode.textContent = app.classList.contains("collapsed") ? "Sidebar: Shrunk" : "Sidebar: Expanded";
      ensureSidebarAdVisibility();
    });

    function setMobileUI(){
      mobileBtn.style.display = mqMobile.matches ? "inline-flex" : "none";
      if(!mqMobile.matches) document.body.classList.remove("mobile-open");
      ensureSidebarAdVisibility();
    }
    setMobileUI();
    mqMobile.addEventListener("change", setMobileUI);

    mobileBtn.addEventListener("click", ()=> document.body.classList.toggle("mobile-open"));

    document.addEventListener("click", (e)=>{
      if(!mqMobile.matches) return;
      if(document.body.classList.contains("mobile-open")){
        const sb = document.querySelector(".sidebar");
        if(!sb.contains(e.target) && e.target !== mobileBtn){
          document.body.classList.remove("mobile-open");
        }
      }
    });

    function bindMenuClicks(){
      menu.querySelectorAll("a.item").forEach(a=>{
        a.addEventListener("click", (e)=>{
          e.preventDefault();
          const topicId = a.getAttribute("data-topicid");
          location.hash = topicId;
          document.body.classList.remove("mobile-open");
          autoCollapseAfterSelection();
        });
      });
    }

    search.addEventListener("input", ()=>{
      const q = search.value.trim().toLowerCase();
      menu.querySelectorAll("a.item").forEach(a=>{
        const txt = (a.textContent || "").toLowerCase();
        a.style.display = txt.includes(q) ? "flex" : "none";
      });
      menu.querySelectorAll("details.group").forEach(d=>{
        const visibleChild = Array.from(d.querySelectorAll("a.item")).some(x=>x.style.display !== "none");
        d.style.display = visibleChild ? "block" : "none";
        if(q && visibleChild) d.open = true;
      });
      if(!q) menu.querySelectorAll("details.group").forEach(d=> d.style.display = "block");
      ensureSidebarAdVisibility();
    });

    window.addEventListener("hashchange", ()=> navigate(location.hash));
    window.addEventListener("resize", ()=> ensureSidebarAdVisibility());

    // Init
    renderMenu();
    bindMenuClicks();
    navigate(location.hash || "#home");
  </script>

  @RenderSection("Scripts", required: false)
</body>
</html>
