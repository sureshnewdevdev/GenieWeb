<div class="mascot mascot-coding-robot" aria-hidden="true">
    <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" role="img">
        <ellipse cx="110" cy="196" rx="60" ry="10" fill="#0d1b2a" opacity="0.15" />

        <g class="mascot-anim mascot-bob">
            <!-- body -->
            <rect x="60" y="90" width="100" height="80" rx="18" fill="#2b6cb0" />
            <rect x="60" y="90" width="100" height="80" rx="18" fill="url(#bodyGradient)" opacity="0.35" />

            <!-- head -->
            <rect x="70" y="34" width="80" height="64" rx="20" fill="#1a4e8a" />
            <rect x="86" y="54" width="48" height="24" rx="8" fill="#bee3f8" class="mascot-screen" />
            <circle cx="98" cy="66" r="3.5" fill="#1a4e8a" class="mascot-eye" />
            <circle cx="122" cy="66" r="3.5" fill="#1a4e8a" class="mascot-eye" />
            <rect x="104" y="18" width="6" height="18" fill="#1a4e8a" />
            <circle cx="107" cy="16" r="6" fill="#f6ad55" class="mascot-antenna" />

            <!-- arms typing -->
            <rect x="38" y="108" width="30" height="10" rx="5" fill="#1a4e8a" class="mascot-arm-left" />
            <rect x="152" y="108" width="30" height="10" rx="5" fill="#1a4e8a" class="mascot-arm-right" />

            <!-- laptop -->
            <rect x="78" y="150" width="64" height="8" rx="2" fill="#0d1b2a" />
            <rect x="86" y="128" width="48" height="24" rx="3" fill="#0d1b2a" />
            <rect x="90" y="132" width="40" height="16" rx="2" fill="#63b3ed" class="mascot-code-lines" />
        </g>

        <defs>
            <linearGradient id="bodyGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="1" stop-color="#000000" />
            </linearGradient>
        </defs>
    </svg>
</div>
