@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Social Messages";
}

<section class="hub-hero theme-social">
    <div class="hub-hero-text">
        <span class="hub-eyebrow"><i class="fas fa-comments"></i> Knowledge Community</span>
        <h1 class="display-5">Bite-sized knowledge, worth sharing</h1>
        <p class="lead">
            A general-knowledge corner covering science facts and student learning programs —
            shareable snippets for curious minds.
        </p>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotSocialPeople" />
    </div>
</section>

@if (Model.TopAd is not null)
{
    <partial name="_AdUnit" model="Model.TopAd" />
}

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">Fresh picks</div>
        <h2>Knowledge feed</h2>
        <p>Science snippets and learning-program highlights, refreshed regularly.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-chip">Science</span>
                <h5>Did you know?</h5>
                <p class="text-muted mb-0">Light from the Sun takes about 8 minutes and 20 seconds to reach Earth.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-chip">Student Program</span>
                <h5>Problem-solving circles</h5>
                <p class="text-muted mb-0">Weekly problem-solving circles help students build algorithmic thinking early.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-chip">Science</span>
                <h5>Water is weird</h5>
                <p class="text-muted mb-0">Water is one of the few substances that is less dense as a solid than as a liquid.</p>
            </div>
        </div>
    </div>
</section>

@if (Model.BottomAd is not null)
{
    <partial name="_AdUnit" model="Model.BottomAd" />
}
