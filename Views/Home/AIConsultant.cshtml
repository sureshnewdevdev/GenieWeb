@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "AI Consultant";
}

<section class="hub-hero theme-ai">
    <div class="hub-hero-text">
        <span class="hub-eyebrow"><i class="fas fa-robot"></i> Generative &amp; Agentic AI</span>
        <h1 class="display-5">Generative AI and agentic systems that reach production</h1>
        <p class="lead">
            Ittechgenie is a technology consulting company focused on Generative AI and Agentic AI —
            from strategy and architecture to production-grade model deployment, MLOps, and the data
            engineering pipelines that keep it all running reliably.
        </p>
        <div class="hub-hero-actions">
            <a class="btn hub-btn-light" href="mailto:ittechgenie1@gmail.com">
                <i class="fas fa-paper-plane me-2"></i>Talk to us
            </a>
            <a class="btn hub-btn-ghost" href="/CorporateTraining">Explore training</a>
        </div>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotAIHumanRobot" />
    </div>
</section>

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">How we work</div>
        <h2>Our capability</h2>
        <p>
            Our experience spans enterprise AI platforms, RAG and multi-agent workflows, MLOps and cloud
            data engineering. We design solutions around measurable business outcomes, secure integration
            and maintainable delivery.
        </p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-briefcase"></i></span>
                <h5>Business-first</h5>
                <p class="text-muted mb-0">Start with the use case, users, risk and value.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-shield-halved"></i></span>
                <h5>Governed by design</h5>
                <p class="text-muted mb-0">Apply deterministic controls, security, evaluation and human oversight.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-graduation-cap"></i></span>
                <h5>Built for adoption</h5>
                <p class="text-muted mb-0">Pair implementation with labs, mentoring and reusable learning assets.</p>
            </div>
        </div>
    </div>
</section>

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">What we do</div>
        <h2>Services</h2>
        <p>End-to-end AI enablement, from the first roadmap workshop to models running reliably in production.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-chess"></i></span>
                <h5>AI Strategy</h5>
                <p class="text-muted mb-0">Roadmaps that connect AI initiatives to measurable business outcomes.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-database"></i></span>
                <h5>Data Engineering</h5>
                <p class="text-muted mb-0">Databricks lakehouse, Delta Lake, Spark and streaming pipelines that turn raw data into reliable, AI-ready assets.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-brain"></i></span>
                <h5>ML Model Development</h5>
                <p class="text-muted mb-0">From experimentation to production-grade, evaluated models.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-arrows-spin"></i></span>
                <h5>MLOps</h5>
                <p class="text-muted mb-0">CI/CD, monitoring, and governance for models running in production.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-plug"></i></span>
                <h5>AI Integration</h5>
                <p class="text-muted mb-0">LLM applications and tool-using agents, embedded directly into existing products and workflows with guardrails.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon"><i class="fas fa-magnifying-glass"></i></span>
                <h5>RAG &amp; Knowledge Systems</h5>
                <p class="text-muted mb-0">Hybrid retrieval, vector search, reranking and grounded generation for enterprise knowledge.</p>
            </div>
        </div>
    </div>
</section>

<section class="hub-content">
    <div class="hub-cta-banner">
        <div>
            <h3>Have an AI initiative in mind?</h3>
            <p>Tell us where you are today — we'll help you map the path to production.</p>
        </div>
        <a class="btn hub-btn-light" href="mailto:ittechgenie1@gmail.com">
            <i class="fas fa-envelope me-2"></i>Get in touch
        </a>
    </div>
</section>

@* No ad markup or ad scripts anywhere on this page by design — AI Consultant is an ad-free area. *@
