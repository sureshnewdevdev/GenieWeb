@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "AI Consultant";
}

<section class="hub-hero theme-ai">
    <div class="hub-hero-text">
        <h1 class="display-5 fw-bold">AI Consultant</h1>
        <p class="lead">
            We provide all kinds of AI enablement with data engineering — from strategy and architecture
            to model deployment, MLOps, and production-grade data pipelines.
        </p>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotCodingRobot" />
    </div>
</section>

<section class="hub-content">
    <h2 class="h4 mb-4">Services</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card">
                <h5>AI Strategy</h5>
                <p class="text-muted mb-0">Roadmaps that connect AI initiatives to measurable business outcomes.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <h5>Data Engineering</h5>
                <p class="text-muted mb-0">Reliable, scalable pipelines that turn raw data into AI-ready assets.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <h5>ML Model Development</h5>
                <p class="text-muted mb-0">From experimentation to production-grade, evaluated models.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <h5>MLOps</h5>
                <p class="text-muted mb-0">CI/CD, monitoring, and governance for models running in production.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <h5>AI Integration</h5>
                <p class="text-muted mb-0">Embedding AI capabilities directly into existing products and workflows.</p>
            </div>
        </div>
    </div>
</section>

@* No ad markup or ad scripts anywhere on this page by design — AI Consultant is an ad-free area. *@
