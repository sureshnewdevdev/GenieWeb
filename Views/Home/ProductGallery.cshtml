@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Product Gallery";
}

<section class="hub-hero theme-product">
    <div class="hub-hero-text">
        <span class="hub-eyebrow"><i class="fas fa-store"></i> Curated Products</span>
        <h1 class="display-5">Tools and kits for developers</h1>
        <p class="lead">
            A showcase of products and resources curated for developers and learners.
        </p>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotSellingRobot" />
    </div>
</section>

@if (Model.TopAd is not null)
{
    <partial name="_AdUnit" model="Model.TopAd" />
}

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">Storefront</div>
        <h2>Featured products</h2>
        <p>Placeholder listings — real products and pricing coming soon.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card hub-product-card">
                <div class="hub-product-thumb"><i class="fas fa-toolbox"></i></div>
                <span class="hub-chip">Toolkit</span>
                <h5>Starter Toolkit</h5>
                <p class="text-muted">A curated set of developer productivity tools.</p>
                <p class="hub-price mb-0">$0 <span class="text-muted fw-normal">(placeholder)</span></p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card hub-product-card">
                <div class="hub-product-thumb"><i class="fas fa-layer-group"></i></div>
                <span class="hub-chip">Bundle</span>
                <h5>Pro Course Bundle</h5>
                <p class="text-muted">Everything you need for the certification path.</p>
                <p class="hub-price mb-0">$0 <span class="text-muted fw-normal">(placeholder)</span></p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card hub-product-card">
                <div class="hub-product-thumb"><i class="fas fa-clipboard-question"></i></div>
                <span class="hub-chip">Prep Kit</span>
                <h5>Interview Prep Kit</h5>
                <p class="text-muted">Practice questions and MCQs, packaged for review.</p>
                <p class="hub-price mb-0">$0 <span class="text-muted fw-normal">(placeholder)</span></p>
            </div>
        </div>
    </div>
</section>

@if (Model.BottomAd is not null)
{
    <partial name="_AdUnit" model="Model.BottomAd" />
}
