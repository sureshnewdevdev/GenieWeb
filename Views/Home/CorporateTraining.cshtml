@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Corporate Training";
}

<section class="hub-hero theme-corporate">
    <div class="hub-hero-text">
        <span class="hub-eyebrow"><i class="fas fa-chalkboard-user"></i> Enterprise Programs</span>
        <h1 class="display-5">Upskill whole teams, not just individuals</h1>
        <p class="lead">
            Custom cohorts for your engineering teams — tailored curricula, on-site or remote delivery,
            and hands-on upskilling designed around your stack and your timelines.
        </p>
        <div class="hub-hero-actions">
            <a class="btn hub-btn-light" href="mailto:ittechgenie1@gmail.com">
                <i class="fas fa-calendar-check me-2"></i>Plan a cohort
            </a>
            <a class="btn hub-btn-ghost" href="/Learners">Individual courses</a>
        </div>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotTeachingRobot" model="@("corporate")" />
    </div>
</section>

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">How we deliver</div>
        <h2>What we offer</h2>
        <p>Every engagement is shaped around your team's stack, skill level, and delivery goals.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="hub-card">
                <span class="hub-card-icon icon-corp"><i class="fas fa-users"></i></span>
                <h5>Custom Cohorts</h5>
                <p class="text-muted mb-0">Programs built around your team's current skill level and goals.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <span class="hub-card-icon icon-corp"><i class="fas fa-globe"></i></span>
                <h5>On-site / Remote Delivery</h5>
                <p class="text-muted mb-0">Flexible delivery formats that fit distributed and in-office teams alike.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <span class="hub-card-icon icon-corp"><i class="fas fa-diagram-project"></i></span>
                <h5>Tailored Curricula</h5>
                <p class="text-muted mb-0">Content mapped to your technology choices and delivery practices.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <span class="hub-card-icon icon-corp"><i class="fas fa-ranking-star"></i></span>
                <h5>Team Upskilling</h5>
                <p class="text-muted mb-0">Structured learning paths that raise the whole team's baseline together.</p>
            </div>
        </div>
    </div>
</section>

<section class="hub-content">
    <div class="hub-cta-banner">
        <div>
            <h3>Ready to build your team's program?</h3>
            <p>Share your goals and stack — we'll draft a curriculum proposal.</p>
        </div>
        <a class="btn hub-btn-light" href="mailto:ittechgenie1@gmail.com">
            <i class="fas fa-envelope me-2"></i>Contact us
        </a>
    </div>
</section>

@* No ad markup or ad scripts anywhere on this page by design — Corporate Training is an ad-free area. *@
