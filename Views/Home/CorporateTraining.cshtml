@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Corporate Training";
}

<section class="hub-hero theme-corporate">
    <div class="hub-hero-text">
        <h1 class="display-5 fw-bold">Corporate Training</h1>
        <p class="lead">
            Custom cohorts for your engineering teams — tailored curricula, on-site or remote delivery,
            and hands-on upskilling designed around your stack and your timelines.
        </p>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotTeachingRobot" model="@("corporate")" />
    </div>
</section>

<section class="hub-content">
    <h2 class="h4 mb-4">What we offer</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="hub-card">
                <h5>Custom Cohorts</h5>
                <p class="text-muted mb-0">Programs built around your team's current skill level and goals.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <h5>On-site / Remote Delivery</h5>
                <p class="text-muted mb-0">Flexible delivery formats that fit distributed and in-office teams alike.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <h5>Tailored Curricula</h5>
                <p class="text-muted mb-0">Content mapped to your technology choices and delivery practices.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hub-card">
                <h5>Team Upskilling</h5>
                <p class="text-muted mb-0">Structured learning paths that raise the whole team's baseline together.</p>
            </div>
        </div>
    </div>
</section>

@* No ad markup or ad scripts anywhere on this page by design — Corporate Training is an ad-free area. *@
