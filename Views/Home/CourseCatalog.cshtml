@{
    ViewData["Title"] = "Course Catalog";
    ViewData["FullWidthContent"] = true;

    var categories = new List<(string Slug, string Name, string Icon, string Color, string Description,
        List<(string Title, string Icon, string Description, string Url, string Cta, bool NewTab)> Courses)>
    {
        ("languages", "Programming Languages", "fa-solid fa-code", "#2b6cb0",
            "Build strong fundamentals in the languages powering modern software.", new()
        {
            ("C# Fundamentals", "fa-solid fa-hashtag", "Start from scratch and learn core C# concepts with real-world examples.", Url.Action("IntroductionToCSharp", "CSharp")!, "Start learning", false),
            ("C# Advanced", "fa-solid fa-layer-group", "Go beyond the basics with advanced language features and design patterns.", Url.Action("CSharpAdvanced", "CSharp")!, "Start learning", false),
            ("Java Essentials", "fa-solid fa-mug-hot", "Build a solid foundation in Java syntax, strings, and core concepts.", Url.Action("JavaStrings", "Java")!, "Start learning", false),
        }),
        ("genai", "GenAI & AI Engineering", "fa-solid fa-brain", "#6b46c1",
            "From prompt engineering to production-grade agentic .NET applications.", new()
        {
            ("GenAI-Powered .NET", "fa-solid fa-robot", "A complete 27-part path from Azure OpenAI basics to production-grade agentic .NET apps.", Url.Action("Index", "Tutorials")!, "View course", false),
            ("Prompt Engineering & GenAI", "fa-solid fa-wand-magic-sparkles", "Master prompting techniques — few-shot, chain-of-thought, and more.", Url.Action("PromptEngineeringMessageTypes", "GenAI")!, "Start learning", false),
            ("AI Syllabus", "fa-solid fa-list-check", "A structured curriculum outline for AI and GenAI learning tracks.", Url.Action("Index", "AISyllabus")!, "View syllabus", false),
        }),
        ("cloud", "Cloud & Azure", "fa-solid fa-cloud", "#0ea5e9",
            "Design, deploy, and operate solutions on Microsoft Azure.", new()
        {
            ("Azure Essentials", "fa-solid fa-cloud", "Understand cloud computing and Microsoft Azure fundamentals step-by-step.", Url.Action("Azure", "Home")!, "Start learning", false),
            ("Azure DevOps", "fa-solid fa-infinity", "Master CI/CD pipelines, repos, boards, and more with Azure DevOps.", Url.Action("WhatIsDevOps", "AzureDevOps")!, "Start learning", false),
            ("Azure Service Fabric", "fa-solid fa-diagram-project", "Build and manage scalable microservices on Service Fabric.", Url.Action("WhatIsServiceFabric", "AzureServiceFabric")!, "Start learning", false),
            ("Azure Data Storage", "fa-solid fa-database", "Work with Azure Blob Storage and other cloud data services.", Url.Action("AzureBlobStorage", "DataStorage")!, "Start learning", false),
        }),
        ("devops", "DevOps & Infrastructure", "fa-solid fa-gears", "#0d9488",
            "Automate, containerize, and version everything you ship.", new()
        {
            ("Docker Fundamentals", "fa-solid fa-box", "Get hands-on with containerization, images, volumes, and networking.", Url.Action("DockerInstallation", "Docker")!, "Start learning", false),
            ("Terraform on Azure", "fa-solid fa-cubes", "Learn Infrastructure as Code to automate your cloud setup.", Url.Action("IntroductionToTerraform", "Terraform")!, "Start learning", false),
            ("Git Essentials", "fa-solid fa-code-branch", "Version control commands and workflows every developer needs.", Url.Action("GitCommandsTutorial", "Git")!, "Start learning", false),
        }),
        ("dotnetweb", ".NET & Web Development", "fa-solid fa-window-restore", "#dd6b20",
            "Cross-platform applications and modern web front ends.", new()
        {
            (".NET Core Guide", "fa-solid fa-microchip", "Dive into cross-platform .NET development with modern tools and frameworks.", Url.Action("WhatIsDotNet", "DotNet")!, "Start learning", false),
            ("React for Beginners", "fa-solid fa-atom", "Build fast, dynamic web apps using React and modern JavaScript.", Url.Action("IntroductionToReact", "React")!, "Start learning", false),
            ("Microservices Architecture", "fa-solid fa-diagram-project", "Design, build, and deploy independently scalable services.", Url.Action("Index", "Microservices")!, "Start learning", false),
        }),
        ("data", "Data Engineering", "fa-solid fa-server", "#2f855a",
            "Process and move data at scale.", new()
        {
            ("DataBricks", "fa-solid fa-server", "Process big data at scale with Apache Spark on Databricks.", Url.Action("IntroductionToDataBricks", "DataBricks")!, "Start learning", false),
            ("Python & PySpark Training", "fa-brands fa-python", "Build strong Python fundamentals and process big data using PySpark pipelines.", Url.Action("Syllabus", "Courses", new { fileName = "PythonSparkSyllabus" })!, "View syllabus", true),
        }),
        ("practice", "Assessments & Practice", "fa-solid fa-clipboard-check", "#d53f8c",
            "Prove what you know and fill the gaps.", new()
        {
            ("Practice Questions", "fa-solid fa-pen-to-square", "Sharpen your skills with hands-on coding challenges and explanations.", Url.Action("CSharpBasics", "PracticeQuestions")!, "Try now", false),
            ("Tech MCQs", "fa-solid fa-square-poll-vertical", "Test your knowledge with multiple-choice questions across major topics.", Url.Action("Index", "TopicSelection")!, "Start quiz", false),
            ("C# & .NET Corporate Syllabus", "fa-solid fa-file-lines", "A structured corporate training syllabus from fundamentals to advanced.", Url.Action("Syllabus", "Courses", new { fileName = "CSharpDotNetSyllabus" })!, "View syllabus", true),
        }),
    };

    int totalCourses = categories.Sum(c => c.Courses.Count);
}

<style>
    /* This page renders full-width via ViewData["FullWidthContent"]; the left ad rail
       has no equivalent flag, so it's hidden explicitly here. */
    #sidebarMenu, #contentdropdownbtn, #floatingBtn {
        display: none !important;
    }

    html {
        scroll-behavior: smooth;
    }

    .catalog {
        --catalog-ink: #0f172a;
        --catalog-muted: #64748b;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1rem 4rem;
    }

    /* ---------- Hero ---------- */
    .catalog-hero {
        margin-top: 1.5rem;
        padding: 3.25rem 2rem;
        border-radius: 24px;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, #071d35 0%, #0b2a49 55%, #12335f 100%);
        box-shadow: 0 20px 45px -20px rgba(7, 29, 53, 0.55);
    }

    .catalog-hero h1 {
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
    }

    .catalog-hero p {
        color: #c9d8e6;
        max-width: 640px;
        margin: 0 auto 1.75rem;
        font-size: 1.05rem;
    }

    .catalog-hero-stats {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
        font-size: 0.85rem;
        color: #aeeef4;
    }

    .catalog-hero-stats span {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
    }

    .catalog-search {
        max-width: 520px;
        margin: 0 auto;
        position: relative;
    }

    .catalog-search i {
        position: absolute;
        left: 1.1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #7c93aa;
    }

    .catalog-search input {
        width: 100%;
        border: none;
        border-radius: 14px;
        padding: 0.9rem 1.1rem 0.9rem 2.6rem;
        font-size: 1rem;
        box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.4);
    }

    .catalog-search input:focus {
        outline: 3px solid rgba(53, 215, 230, 0.45);
    }

    /* ---------- Category quick-nav (wraps -- never scrolls) ---------- */
    .catalog-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin: 1.75rem 0 3rem;
    }

    .catalog-chip {
        --chip-color: #2b6cb0;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--chip-color) 10%, white);
        color: var(--chip-color);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        border: 1px solid color-mix(in srgb, var(--chip-color) 25%, white);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .catalog-chip:hover {
        color: #fff;
        background: var(--chip-color);
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px var(--chip-color);
    }

    /* ---------- Category sections ---------- */
    .catalog-category {
        scroll-margin-top: 6.5rem;
        margin-bottom: 3rem;
    }

    .catalog-category-head {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .catalog-category-icon {
        flex: 0 0 auto;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 1.25rem;
        box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.35);
    }

    .catalog-category-head h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--catalog-ink);
        margin: 0 0 0.25rem;
    }

    .catalog-count {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--catalog-muted);
        background: #f1f5f9;
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
        margin-left: 0.5rem;
        vertical-align: middle;
    }

    .catalog-category-head p {
        margin: 0;
        color: var(--catalog-muted);
        font-size: 0.92rem;
    }

    /* ---------- Course cards ---------- */
    .catalog-card {
        --cat-color: #2b6cb0;
        height: 100%;
        padding: 1.5rem;
        border-radius: 18px;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .catalog-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--cat-color) 35%, white);
        box-shadow: 0 18px 34px -18px rgba(15, 23, 42, 0.28);
    }

    .catalog-card-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        background: color-mix(in srgb, var(--cat-color) 12%, white);
        color: var(--cat-color);
    }

    .catalog-card h5 {
        font-weight: 700;
        color: var(--catalog-ink);
        margin-bottom: 0.4rem;
    }

    .catalog-card p {
        color: var(--catalog-muted);
        font-size: 0.9rem;
        margin-bottom: 1.1rem;
        min-height: 2.6rem;
    }

    .catalog-card-btn {
        display: inline-flex;
        align-items: center;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--cat-color);
        text-decoration: none;
    }

    .catalog-card-btn:hover {
        text-decoration: underline;
    }

    .catalog-no-results {
        display: none;
        text-align: center;
        padding: 3rem 1rem;
        color: var(--catalog-muted);
    }

    .catalog-no-results i {
        font-size: 2rem;
        margin-bottom: 0.75rem;
        display: block;
    }

    /* ---------- Footer ---------- */
    .catalog-footer {
        margin-top: 1rem;
        border-radius: 20px;
        overflow: hidden;
    }

    .catalog-footer a.link-hover:hover {
        color: #35d7e6;
        text-decoration: underline;
    }

    @@media (max-width: 576px) {
        .catalog-hero {
            padding: 2.25rem 1.25rem;
        }

        .catalog-category-head {
            flex-direction: column;
        }
    }
</style>

<div class="catalog">
    <section class="catalog-hero">
        <h1 class="display-5">Course Catalog</h1>
        <p>
            @totalCourses hands-on courses across @categories.Count categories — programming languages, cloud,
            DevOps, GenAI engineering, and more. Search by name or jump straight to a category below.
        </p>
        <div class="catalog-hero-stats">
            <span><i class="fa-solid fa-graduation-cap me-1"></i> @totalCourses courses</span>
            <span><i class="fa-solid fa-layer-group me-1"></i> @categories.Count categories</span>
            <span><i class="fa-solid fa-infinity me-1"></i> Self-paced</span>
        </div>
        <div class="catalog-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="catalogSearch" placeholder="Search courses e.g. Docker, React, GenAI..." aria-label="Search courses">
        </div>
    </section>

    <nav class="catalog-chips" aria-label="Jump to a category">
        @foreach (var cat in categories)
        {
            <a href="#cat-@cat.Slug" class="catalog-chip" style="--chip-color:@cat.Color">
                <i class="@cat.Icon"></i> @cat.Name
            </a>
        }
    </nav>

    @foreach (var cat in categories)
    {
        <section class="catalog-category" id="cat-@cat.Slug" data-category-section>
            <div class="catalog-category-head">
                <span class="catalog-category-icon" style="background:@cat.Color"><i class="@cat.Icon"></i></span>
                <div>
                    <h2>@cat.Name<span class="catalog-count">@cat.Courses.Count course@(cat.Courses.Count == 1 ? "" : "s")</span></h2>
                    <p>@cat.Description</p>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var course in cat.Courses)
                {
                    <div class="col-md-6 col-lg-4" data-course-card>
                        <div class="catalog-card" style="--cat-color:@cat.Color">
                            <span class="catalog-card-icon"><i class="@course.Icon"></i></span>
                            <h5>@course.Title</h5>
                            <p>@course.Description</p>
                            <a href="@course.Url" class="catalog-card-btn"
                               target="@(course.NewTab ? "_blank" : "_self")"
                               rel="@(course.NewTab ? "noopener" : null)">
                                @course.Cta <i class="fa-solid fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="catalog-no-results" id="catalogNoResults">
        <i class="fa-solid fa-magnifying-glass"></i>
        No courses match your search. Try a different keyword.
    </div>
</div>

<footer class="catalog-footer bg-dark text-white text-center py-4">
    <div class="container">
        <p class="mb-2">&copy; @DateTime.Now.Year ItTechGenie. All rights reserved.</p>
        <p class="mb-3">
            <a href="/Home/Privacy" class="text-white text-decoration-none link-hover">Privacy Policy</a>
        </p>
        <div class="d-flex flex-column align-items-center gap-1">
            <span><i class="fas fa-user-shield me-2"></i><strong>Managed by</strong></span>
            <a href="mailto:ittechgenie1@gmail.com" class="text-white text-decoration-none link-hover">
                <i class="fas fa-envelope me-2"></i>ittechgenie1@gmail.com
            </a>
        </div>
    </div>
</footer>

<script>
    (function () {
        var input = document.getElementById('catalogSearch');
        if (!input) return;

        var cards = Array.prototype.slice.call(document.querySelectorAll('[data-course-card]'));
        var sections = Array.prototype.slice.call(document.querySelectorAll('[data-category-section]'));
        var noResults = document.getElementById('catalogNoResults');

        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            var anyVisible = false;

            cards.forEach(function (card) {
                var match = q === '' || card.textContent.toLowerCase().indexOf(q) !== -1;
                card.style.display = match ? '' : 'none';
                if (match) anyVisible = true;
            });

            sections.forEach(function (section) {
                var visibleCount = section.querySelectorAll('[data-course-card]:not([style*="display: none"])').length;
                section.style.display = (q === '' || visibleCount > 0) ? '' : 'none';
            });

            if (noResults) {
                noResults.style.display = (q !== '' && !anyVisible) ? 'block' : 'none';
            }
        });
    })();
</script>
