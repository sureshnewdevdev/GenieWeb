@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Learners";
}

<section class="hub-hero theme-learners">
    <div class="hub-hero-text">
        <span class="hub-eyebrow"><i class="fas fa-graduation-cap"></i> Self-paced Learning</span>
        <h1 class="display-5">Learn by doing, at your own pace</h1>
        <p class="lead">
            Individual courses across C#, .NET, Azure, DevOps, Docker, Terraform, React, and more —
            hands-on tutorials, MCQs, and practice questions.
        </p>
        <div class="hub-hero-actions">
            <a class="btn hub-btn-light" href="@Url.Action("CourseCatalog", "Home")">
                <i class="fas fa-book-open me-2"></i>Browse all courses
            </a>
        </div>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotTeachingRobot" model="@("learners")" />
    </div>
</section>

@if (Model.TopAd is not null)
{
    <partial name="_AdUnit" model="Model.TopAd" />
}

<section class="hub-content">
    <div class="hub-section-head">
        <div class="hub-section-eyebrow">Ways to learn</div>
        <h2>Pick your path</h2>
        <p>Tutorials for depth, MCQs for recall, and practice questions to prove it to yourself.</p>
    </div>
    <!-- TODO: replace these entry-point cards with a real in-hub course catalog; they currently link to the existing course listing and quiz pages. -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon icon-learn"><i class="fas fa-book"></i></span>
                <h5>Tutorials</h5>
                <p class="text-muted">Step-by-step guides across the full catalog — C#, Azure, Docker, React, and more.</p>
                <a class="fw-semibold" href="@Url.Action("CourseCatalog", "Home")">Browse courses <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon icon-learn"><i class="fas fa-list-check"></i></span>
                <h5>Tech MCQs</h5>
                <p class="text-muted">Timed multiple-choice quizzes with explanations, across every major topic.</p>
                <a class="fw-semibold" href="@Url.Action("McqEntry", "TopicSelection")">Start a quiz <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="hub-card">
                <span class="hub-card-icon icon-learn"><i class="fas fa-code"></i></span>
                <h5>Practice Questions</h5>
                <p class="text-muted">Hands-on coding challenges with worked answers and time targets.</p>
                <a class="fw-semibold" href="@Url.Action("CSharpBasics", "PracticeQuestions")">Try one now <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</section>

@if (Model.BottomAd is not null)
{
    <partial name="_AdUnit" model="Model.BottomAd" />
}
