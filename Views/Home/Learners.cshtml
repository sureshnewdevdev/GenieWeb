@model GenieWeb.Models.HubAreaViewModel
@{
    Layout = "_HubLayout";
    ViewData["Title"] = "Learners";
}

<section class="hub-hero theme-learners">
    <div class="hub-hero-text">
        <h1 class="display-5 fw-bold">Learners</h1>
        <p class="lead">
            Individual courses across C#, .NET, Azure, DevOps, Docker, Terraform, React, and more —
            learn at your own pace with hands-on tutorials and practice questions.
        </p>
    </div>
    <div class="hub-hero-mascot">
        <partial name="_MascotTeachingRobot" model="@("learners")" />
    </div>
</section>

@if (Model.TopAd is not null)
{
    <partial name="_AdUnit" model="Model.TopAd" />
}

<section class="hub-content">
    <!-- TODO: replace this CTA with a real in-hub course catalog; for now it links out to the existing course listing. -->
    <div class="hub-card text-center py-5">
        <h2 class="h4 mb-3">Browse all courses</h2>
        <p class="text-muted">Our full catalog of tutorials, MCQs, and practice questions lives on the existing course listing page.</p>
        <a class="btn btn-success btn-lg mt-2" href="@Url.Action("CourseCatalog", "Home")">Browse All Courses</a>
    </div>
</section>

@if (Model.BottomAd is not null)
{
    <partial name="_AdUnit" model="Model.BottomAd" />
}
