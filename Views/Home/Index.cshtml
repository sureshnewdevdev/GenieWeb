@page
@{
    // ViewData["Title"] = "Home";
}

<div class="text-center">
    <img src="~/css/images/vinayaga.jpg" width="50" height="50" />
</div>

<div class="container mt-4 d-flex justify-content-between">
    <!-- Boot Camp Partial View -->
    <div class="col-md-6 col-lg-6 col-sm-12 p-1">
        @await Html.PartialAsync("_AWSBootCampPartial")
    </div>

    <!-- Other Training Partial View -->
    <div class="col-md-6 col-lg-6 col-sm-12 p-1">
        @await Html.PartialAsync("_OtherTrainingPartial")
