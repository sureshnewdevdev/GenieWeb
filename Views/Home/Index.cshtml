@{
    // ViewData["Title"] = "Home";
}
<style>
    @@media (min-width: 992px) {
    .col-lg-10 {
        flex: 0 0 auto;
        width: 100%;
    }
}
    @@media (min-width: 768px) {
    .col-md-9 {
        flex: 0 0 auto;
        width: 100%;
    }
}
    .main{
        margin: 0% !important;
    }
    #sidebarMenu {
        display: none !important;
        width: 0 !important;
    }
    #rightAdSection {
        display: none !important;
        width: 0 !important;
    }
    /* Make main content full width */
    main.col-md-9,
    main.ms-sm-auto,
    main.col-lg-10,
    main.px-md-4 {
        width: auto !important;
        max-width: 100vw;
        margin: 2vw !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    #floatingBtn {
        display: none !important;
    }

    #contentdropdownbtn {
        display: none !important;
    }

    .card-img-top {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        margin: 20px auto 0 auto;
        display: block;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        border: 4px solid #f8f9fa;
    }

    .card-body {
        text-align: center;
    }

    .card {
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

    .card-title {
        font-weight: 600;
    }
</style>
<div class="container-fluid">
    <!-- Hero Section -->
    <section class="row bg-primary text-white text-center py-5" style="border-radius:20px;margin-left:1vw;margin-right:1vw">
        <div class="col-12">
            <h1 class="display-4">Welcome to ITTechGenie!</h1>
            <p class="lead">Empowering learners with cutting-edge technology training.</p>
        </div>
    </section>

    <!-- About Us Section -->
    <section class="row bg-light py-5">
        <div class="col-md-8 offset-md-2 text-center">
            <h2>About Us</h2>
            <p>At ITTechGenie, we are dedicated to providing top-notch technology education in areas like C#, Azure, .NET Core, React, Azure DevOps, Docker, and Terraform. Our mission is to equip learners with the skills needed to excel in the tech industry.</p>
        </div>
    </section>

    <!-- Featured Courses Section -->
    <section class="row py-5">
        <div class="col-12 text-center">
            <h2>Featured Courses</h2>
            <p class="lead">Master essential technologies with our expertly crafted tutorials and hands-on guides.</p>
        </div>

        <!-- C# -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/CSharp.svg" class="card-img-top" alt="C# Course">
                <div class="card-body">
                    <h5 class="card-title">C# Fundamentals</h5>
                    <p class="card-text">Start from scratch and learn core C# concepts with real-world examples.</p>
                    <a href="@Url.Action("IntroductionToCSharp", "CSharp")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Azure -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/Azure.png" class="card-img-top" alt="Azure Course">
                <div class="card-body">
                    <h5 class="card-title">Azure Essentials</h5>
                    <p class="card-text">Understand cloud computing and Microsoft Azure fundamentals step-by-step.</p>
                    <a href="@Url.Action("Azure", "Home")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- .NET Core -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/DotNet.png" class="card-img-top" alt=".NET Core Course">
                <div class="card-body">
                    <h5 class="card-title">.NET Core Guide</h5>
                    <p class="card-text">Dive into cross-platform .NET development with modern tools and frameworks.</p>
                    <a href="@Url.Action("WhatIsDotNet", "DotNet")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- React -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/React.svg" class="card-img-top" alt="React Course">
                <div class="card-body">
                    <h5 class="card-title">React for Beginners</h5>
                    <p class="card-text">Learn to build fast, dynamic web apps using React and modern JavaScript.</p>
                    <a href="@Url.Action("IntroductionToReact", "React")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Azure DevOps -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/AzureDevOps.png" class="card-img-top" alt="Azure DevOps Course">
                <div class="card-body">
                    <h5 class="card-title">Azure DevOps Overview</h5>
                    <p class="card-text">Master CI/CD pipelines, repos, boards, and more with Azure DevOps services.</p>
                    <a href="@Url.Action("WhatIsDevOps", "AzureDevOps")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Docker -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/Docker.png" class="card-img-top" alt="Docker Course">
                <div class="card-body">
                    <h5 class="card-title">Docker Fundamentals</h5>
                    <p class="card-text">Get hands-on with containerization, images, volumes, and networking in Docker.</p>
                    <a href="@Url.Action("DockerInstallation", "Docker")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Terraform -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/Terraform.png" class="card-img-top" alt="Terraform Course">
                <div class="card-body">
                    <h5 class="card-title">Terraform on Azure</h5>
                    <p class="card-text">Learn Infrastructure as Code (IaC) with Terraform to automate your cloud setup.</p>
                    <a href="@Url.Action("IntroductionToTerraform", "Terraform")" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Practice Questions -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/PracticeQuestions.png" class="card-img-top" alt="Practice Questions">
                <div class="card-body">
                    <h5 class="card-title">Practice Questions</h5>
                    <p class="card-text">Sharpen your skills with hands-on coding challenges and explanations.</p>
                    <a href="@Url.Action("CSharpBasics", "PracticeQuestions")" class="btn btn-primary">Try Now</a>
                </div>
            </div>
        </div>

        <!-- MCQs -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="~/css/Images/Logos/mcq's.png" class="card-img-top" alt="MCQ Practice">
                <div class="card-body">
                    <h5 class="card-title">Tech MCQs</h5>
                    <p class="card-text">Test your knowledge with multiple-choice questions across all major topics.</p>
                    <a href="@Url.Action("Index", "ChoiceQuestions")" class="btn btn-primary">Start Quiz</a>
                </div>
            </div>
        </div>
    </section>



</div>

<footer class="bg-dark text-white text-center py-3">
    <div class="container">
        <p>© 2025 ITTechGenie. All rights reserved.</p>
        <p>
            <a href="/privacy-policy" class="text-white">Privacy Policy</a> |
            <a href="/terms-of-service" class="text-white">Terms of Service</a>
        </p>
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
