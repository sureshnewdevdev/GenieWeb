@{
    ViewData["Title"] = "React MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "React";
}

<div class="container mt-5">
    <h2 class="text-warning mb-4">React Quiz Topics</h2>
    <p class="text-muted">Choose a level to explore subtopics and test your knowledge.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- React Introduction -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">React Introduction</h5>
                    <p class="card-text text-muted">What is React, Virtual DOM, benefits & architecture.</p>
                    <a href="@Url.Action("ReactIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- JSX Syntax -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">JSX Syntax</h5>
                    <p class="card-text text-muted">JSX rules, expressions, fragments, rendering.</p>
                    <a href="@Url.Action("ReactJSX", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Components -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Components</h5>
                    <p class="card-text text-muted">Functional and class components, structure, nesting.</p>
                    <a href="@Url.Action("ReactComponents", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Props -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Props</h5>
                    <p class="card-text text-muted">Passing data, prop drilling, PropTypes.</p>
                    <a href="@Url.Action("ReactProps", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- State -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">State</h5>
                    <p class="card-text text-muted">State usage in class & functional components.</p>
                    <a href="@Url.Action("ReactStateBasics", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Events -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Events</h5>
                    <p class="card-text text-muted">Synthetic events, event handlers, binding.</p>
                    <a href="@Url.Action("ReactEvents", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Hooks -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">React Hooks</h5>
                    <p class="card-text text-muted">useState, useEffect, useRef, lifecycle patterns.</p>
                    <a href="@Url.Action("ReactHooks", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Forms -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Forms</h5>
                    <p class="card-text text-muted">Controlled/uncontrolled forms, validation logic.</p>
                    <a href="@Url.Action("ReactForms", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Conditional Rendering -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Conditional Rendering</h5>
                    <p class="card-text text-muted">Ternary operator, logical &&, inline conditions.</p>
                    <a href="@Url.Action("ReactConditional", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- List Rendering -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">List Rendering</h5>
                    <p class="card-text text-muted">map(), keys, nested lists in React.</p>
                    <a href="@Url.Action("ReactListRendering", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Lifting State Up -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Lifting State Up</h5>
                    <p class="card-text text-muted">Sharing state across components via callbacks.</p>
                    <a href="@Url.Action("ReactLiftingState", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- React Router -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">React Router</h5>
                    <p class="card-text text-muted">Routing, navigation, dynamic & nested routes.</p>
                    <a href="@Url.Action("ReactRouter", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Context API -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Context API</h5>
                    <p class="card-text text-muted">Global state, providers, consumers, no prop drilling.</p>
                    <a href="@Url.Action("ReactContext", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Memoization -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Memoization & Performance</h5>
                    <p class="card-text text-muted">React.memo, useMemo, useCallback optimizations.</p>
                    <a href="@Url.Action("ReactMemo", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Custom Hooks -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Custom Hooks</h5>
                    <p class="card-text text-muted">Reusable hook patterns and abstraction logic.</p>
                    <a href="@Url.Action("ReactCustomHooks", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Redux -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Redux & State Libraries</h5>
                    <p class="card-text text-muted">Store, actions, reducers, middleware, Redux Toolkit.</p>
                    <a href="@Url.Action("ReactRedux", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Testing -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Testing with Jest & RTL</h5>
                    <p class="card-text text-muted">Unit testing components, hooks, mock functions.</p>
                    <a href="@Url.Action("ReactTesting", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Integration & API -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">API Integration</h5>
                    <p class="card-text text-muted">Fetching data using Axios, fetch API, and React Query.</p>
                    <a href="@Url.Action("ReactAPI", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>
</div>
