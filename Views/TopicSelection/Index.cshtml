@{
    ViewData["Title"] = "MCQ Topics";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
}

<div class="container mt-5">
    <h2 class="text-secondary mb-4">Choose a Topic</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">

        <!-- Azure Storage -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-cloud-fill fs-3 text-primary me-2"></i>
                            <h5 class="card-title mb-0 text-primary">Azure Storage</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Explore Azure Blob, File, Queue, and replication strategies.</p>
                    </div>
                    <a href="@Url.Action("AzureSubtopics", "TopicSelection")" class="btn btn-outline-primary mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- C# Programming -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-code-slash fs-3 text-success me-2"></i>
                            <h5 class="card-title mb-0 text-success">C# Programming</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Test your skills in OOP, async, delegates, and more.</p>
                    </div>
                    <a href="@Url.Action("CSharpSubtopics", "TopicSelection")" class="btn btn-outline-success mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- .NET Core -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-box-fill fs-3 text-info me-2"></i>
                            <h5 class="card-title mb-0 text-info">.NET Core</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Dive into middleware, routing, DI, and cross-platform logic.</p>
                    </div>
                    <a href="@Url.Action("DotNetSubtopics", "TopicSelection")" class="btn btn-outline-info mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- React -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-file-code-fill fs-3 text-warning me-2"></i>
                            <h5 class="card-title mb-0 text-warning">React</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">JSX, hooks, components, state, props, and lifecycle.</p>
                    </div>
                    <a href="@Url.Action("ReactSubtopics", "TopicSelection")" class="btn btn-outline-warning mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- Azure DevOps -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-diagram-3-fill fs-3 text-danger me-2"></i>
                            <h5 class="card-title mb-0 text-danger">Azure DevOps</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Pipelines, repos, boards, artifacts, and CI/CD practices.</p>
                    </div>
                    <a href="@Url.Action("AzureDevOpsSubtopics", "TopicSelection")" class="btn btn-outline-danger mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- Docker -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-box-seam fs-3 text-secondary me-2"></i>
                            <h5 class="card-title mb-0 text-secondary">Docker</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Containers, images, volumes, networking, Dockerfile.</p>
                    </div>
                    <a href="@Url.Action("DockerSubtopics", "TopicSelection")" class="btn btn-outline-secondary mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- Terraform -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-terminal-fill fs-3 text-dark me-2"></i>
                            <h5 class="card-title mb-0 text-dark">Terraform</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">IaC syntax, providers, modules, state, and deployments.</p>
                    </div>
                    <a href="@Url.Action("TerraformSubtopics", "TopicSelection")" class="btn btn-outline-dark mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- Databricks -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-bar-chart-line-fill fs-3 text-primary me-2"></i>
                            <h5 class="card-title mb-0 text-primary">Databricks</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Workspaces, clusters, notebooks, Spark, and Delta Lake.</p>
                    </div>
                    <a href="@Url.Action("DatabricksSubtopics", "TopicSelection")" class="btn btn-outline-primary mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

        <!-- Git -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 hover-shadow">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-git fs-3 text-danger me-2"></i>
                            <h5 class="card-title mb-0 text-danger">Git</h5>
                        </div>
                        <p class="card-text mt-2 text-muted">Branching, merging, stash, rebase, commit, push, pull.</p>
                    </div>
                    <a href="@Url.Action("GitSubtopics", "TopicSelection")" class="btn btn-outline-danger mt-3 w-100">View Subtopics</a>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    #sidebarMenu {
        display: none !important; /* Hide the sidebar menu by default */
    }

    .hover-shadow:hover {
        transform: scale(1.02);
        transition: all 0.2s ease-in-out;
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.15);
    }
</style>
