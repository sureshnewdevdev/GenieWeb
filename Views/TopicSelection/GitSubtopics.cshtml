@{
    ViewData["Title"] = "Git MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Git";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4">Git Quiz Topics</h2>
    <p class="text-muted">Explore Git concepts by choosing a subtopic below.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Git Basics -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Git Basics</h5>
                    <p class="card-text text-muted">What is Git, local vs remote repo, Git workflow.</p>
                    <a href="@Url.Action("GitBasics", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Configuration -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Git Configuration</h5>
                    <p class="card-text text-muted">git config, setting username/email, global vs local.</p>
                    <a href="@Url.Action("GitConfig", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Init/Add/Commit -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Init/Add/Commit</h5>
                    <p class="card-text text-muted">Creating repos, staging, committing changes.</p>
                    <a href="@Url.Action("GitInitAddCommit", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Git Branching -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Branching</h5>
                    <p class="card-text text-muted">Creating, switching, merging, deleting branches.</p>
                    <a href="@Url.Action("GitBranching", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Stash -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Stash</h5>
                    <p class="card-text text-muted">Saving, listing, applying, and dropping stashes.</p>
                    <a href="@Url.Action("GitStash", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Log & Diff -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Log & Diff</h5>
                    <p class="card-text text-muted">git log formats, filtering, and diff commands.</p>
                    <a href="@Url.Action("GitLogDiff", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Git Rebase -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Git Rebase</h5>
                    <p class="card-text text-muted">Rebase vs merge, interactive rebase, squash.</p>
                    <a href="@Url.Action("GitRebase", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Remote -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Git Remote</h5>
                    <p class="card-text text-muted">Adding, removing remotes, fetch, pull, push.</p>
                    <a href="@Url.Action("GitRemote", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Git Reset/Revert -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Reset & Revert</h5>
                    <p class="card-text text-muted">Undoing changes safely, soft/mixed/hard reset.</p>
                    <a href="@Url.Action("GitResetRevert", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
