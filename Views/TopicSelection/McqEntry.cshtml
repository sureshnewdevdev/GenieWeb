@{
    ViewData["Title"] = "Choose MCQ Flow";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="mb-3">MCQs</h2>
                    <p class="text-muted mb-4">Choose where you want to go next.</p>

                    <div class="d-grid gap-3 d-md-flex">
                        <a class="btn btn-primary" href="@Url.Action("CompanyMcqs", "TopicSelection")">Go to Company MCQs</a>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "TopicSelection")">Continue Normal Flow</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
