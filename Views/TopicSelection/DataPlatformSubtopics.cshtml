@{
    ViewData["Title"] = "Data Platform MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "DataPlatform";
}

<div class="container mt-5">
    <p class="text-muted">Select a subtopic from each level to test your knowledge of data engineering and analytics in Azure.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Data Storage Essentials -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Data Storage Essentials</h5>
                    <p class="card-text text-muted">Data types, storage services, Azure Blob, and Data Lake Gen2 basics.</p>
                    <a href="@Url.Action("DataPlatform_DataStorageBasics", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure SQL and T-SQL -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure SQL & T-SQL Basics</h5>
                    <p class="card-text text-muted">Create and query databases using T-SQL in Azure SQL Database.</p>
                    <a href="@Url.Action("DataPlatform_AzureSQLBasics", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Data Factory Intro -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure Data Factory Intro</h5>
                    <p class="card-text text-muted">Basics of ADF pipelines, copy data, and transformation flows.</p>
                    <a href="@Url.Action("DataPlatform_ADFIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- ADF Advanced Operations -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">ADF Advanced Operations</h5>
                    <p class="card-text text-muted">Debugging, GitHub integration, self-hosted runtime, triggers.</p>
                    <a href="@Url.Action("DataPlatform_ADFAdvanced", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Stream Analytics & Event Hubs -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Stream Analytics & Event Hubs</h5>
                    <p class="card-text text-muted">Stream processing, windows, real-time queries, diagnostics.</p>
                    <a href="@Url.Action("DataPlatform_StreamProcessing", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Spark & Notebooks -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Spark & Notebooks</h5>
                    <p class="card-text text-muted">Use Python/Scala, DataFrames, and notebooks in Apache Spark.</p>
                    <a href="@Url.Action("DataPlatform_SparkNotebooks", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Delta Lake & Databricks -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Delta Lake & Databricks</h5>
                    <p class="card-text text-muted">Delta format, Lakehouse architecture, jobs, and clusters.</p>
                    <a href="@Url.Action("DataPlatform_DeltaDatabricks", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Synapse & ADF Integration -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Synapse & ADF Integration</h5>
                    <p class="card-text text-muted">Data pipelines, Spark pools, COPY INTO, notebooks, automation.</p>
                    <a href="@Url.Action("DataPlatform_SynapseADF", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>
</div>
