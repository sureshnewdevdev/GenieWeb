@{
    ViewData["Title"] = "Python MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Python";
}

<div class="container mt-5">
    <h2 class="text-dark mb-4">Python Quiz Topics</h2>
    <p class="text-muted">Select a subtopic from each level to test your Python knowledge.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Introduction</h5>
                    <p class="card-text text-muted">History, features, installation, and basics.</p>
                    <a href="@Url.Action("Python-Introduction", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Variables & Data Types</h5>
                    <p class="card-text text-muted">Dynamic typing, primitive types, type casting.</p>
                    <a href="@Url.Action("Python_Variables_and_Data_Types", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Operators</h5>
                    <p class="card-text text-muted">Arithmetic, logical, comparison, bitwise.</p>
                    <a href="@Url.Action("Python_Operators", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Loops</h5>
                    <p class="card-text text-muted">For, while, nested loops, break and continue.</p>
                    <a href="@Url.Action("Python_Loops", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Conditional Statements</h5>
                    <p class="card-text text-muted">If, elif, else, nested conditions.</p>
                    <a href="@Url.Action("Python_Conditional_Statements", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Functions</h5>
                    <p class="card-text text-muted">Defining, calling, arguments, return values.</p>
                    <a href="@Url.Action("Python_Functions", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">File Handling</h5>
                    <p class="card-text text-muted">Read, write, open, with, file methods.</p>
                    <a href="@Url.Action("Python_File_Handling", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Lambda Functions</h5>
                    <p class="card-text text-muted">Anonymous functions, filter, map, reduce.</p>
                    <a href="@Url.Action("Python_Lambda_Function", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Sets</h5>
                    <p class="card-text text-muted">Set operations, add/remove, unions, intersections.</p>
                    <a href="@Url.Action("Python_Sets", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Constants</h5>
                    <p class="card-text text-muted">Defining, naming conventions, immutability.</p>
                    <a href="@Url.Action("Python_Constants", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Exception Handling</h5>
                    <p class="card-text text-muted">Try, except, finally, raise, custom exceptions.</p>
                    <a href="@Url.Action("Python_Exception_Handling", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Object-Oriented Programming</h5>
                    <p class="card-text text-muted">Classes, objects, inheritance, polymorphism.</p>
                    <a href="@Url.Action("Python_Object_Oriented_Programming", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
