@{
    ViewData["Title"] = "C# Programming MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "CSharp";
}

<div class="container mt-5">
    <h2 class="text-success mb-4">C# Quiz Topics</h2>
    <p>Select a subtopic below to begin the quiz.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- C# Basics -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">C# Basics</h5>
                        <p class="card-text text-muted">Variables, data types, operators, control flow.</p>
                    </div>
                    <a href="@Url.Action("CSharpBasics", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Inheritance -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Inheritance</h5>
                        <p class="card-text text-muted">OOP inheritance concepts, base/derived classes.</p>
                    </div>
                    <a href="@Url.Action("CSharpInheritance", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Polymorphism -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">Polymorphism</h5>
                        <p class="card-text text-muted">Method overriding, overloading, interfaces.</p>
                    </div>
                    <a href="@Url.Action("CSharpPolymorphism", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Async & Await -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning">Async & Await</h5>
                        <p class="card-text text-muted">Asynchronous programming, task-based async pattern.</p>
                    </div>
                    <a href="@Url.Action("CSharpAsyncAwait", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Encapsulation -->
        <div class="col">
            <div class="card h-100 border-danger shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-danger">Encapsulation</h5>
                        <p class="card-text text-muted">Access modifiers, properties, and data hiding.</p>
                    </div>
                    <a href="@Url.Action("CSharpEncapsulation", "ChoiceQuestions")" class="btn btn-outline-danger mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Abstraction -->
        <div class="col">
            <div class="card h-100 border-secondary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-secondary">Abstraction</h5>
                        <p class="card-text text-muted">Abstract classes, interfaces, and method abstraction.</p>
                    </div>
                    <a href="@Url.Action("CSharpAbstraction", "ChoiceQuestions")" class="btn btn-outline-secondary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Exception Handling -->
        <div class="col">
            <div class="card h-100 border-dark shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-dark">Exception Handling</h5>
                        <p class="card-text text-muted">try-catch blocks, finally, custom exceptions.</p>
                    </div>
                    <a href="@Url.Action("CSharpExceptionHandling", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Delegates & Events -->
        <div class="col">
            <div class="card h-100 border-light shadow rounded-4 bg-light">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-dark">Delegates & Events</h5>
                        <p class="card-text text-muted">Delegates, multicast, anonymous methods, events.</p>
                    </div>
                    <a href="@Url.Action("CSharpDelegatesEvents", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- LINQ -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">LINQ</h5>
                        <p class="card-text text-muted">Query syntax, method syntax, filtering, projection.</p>
                    </div>
                    <a href="@Url.Action("CSharpLINQ", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Collections -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Collections</h5>
                        <p class="card-text text-muted">Lists, dictionaries, stacks, queues, generic collections.</p>
                    </div>
                    <a href="@Url.Action("CSharpCollections", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- File Handling -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">File Handling</h5>
                        <p class="card-text text-muted">FileStream, StreamReader, StreamWriter, reading/writing files.</p>
                    </div>
                    <a href="@Url.Action("CSharpFileHandling", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Threading -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning">Threading</h5>
                        <p class="card-text text-muted">Multithreading, Thread class, synchronization.</p>
                    </div>
                    <a href="@Url.Action("CSharpThreading", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
