@{
    ViewData["Title"] = "Databricks MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Databricks";
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">Databricks Quiz Topics</h2>
    <p class="text-muted">Select a subtopic from each level to test your Databricks understanding.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Databricks Overview -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Databricks Overview</h5>
                    <p class="card-text text-muted">What is Databricks? UI, platform components, workspace.</p>
                    <a href="@Url.Action("DatabricksIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Clusters -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Clusters</h5>
                    <p class="card-text text-muted">Types of clusters, autoscaling, termination settings.</p>
                    <a href="@Url.Action("DatabricksClusters", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Notebooks -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Notebooks</h5>
                    <p class="card-text text-muted">Creating, running cells, markdown, and languages support.</p>
                    <a href="@Url.Action("DatabricksNotebooks", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Databricks File System -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">DBFS (File System)</h5>
                    <p class="card-text text-muted">Working with Databricks File System, mounts, paths.</p>
                    <a href="@Url.Action("DatabricksDBFS", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Jobs and Scheduling -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Jobs & Scheduling</h5>
                    <p class="card-text text-muted">Running jobs, scheduling, job clusters.</p>
                    <a href="@Url.Action("DatabricksJobs", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Spark Basics -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Spark Basics</h5>
                    <p class="card-text text-muted">RDD, DataFrames, lazy evaluation, transformations.</p>
                    <a href="@Url.Action("DatabricksSparkBasics", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Delta Lake -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Delta Lake</h5>
                    <p class="card-text text-muted">ACID transactions, schema enforcement, time travel.</p>
                    <a href="@Url.Action("DatabricksDeltaLake", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Databricks SQL -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Databricks SQL</h5>
                    <p class="card-text text-muted">Running SQL queries, visualizations, dashboards.</p>
                    <a href="@Url.Action("DatabricksSQL", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- ML & Workflows -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">ML & Workflows</h5>
                    <p class="card-text text-muted">MLflow tracking, models, experiments, pipelines.</p>
                    <a href="@Url.Action("DatabricksML", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
