@{
    ViewData["Title"] = "Docker MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Docker";
}

<div class="container mt-5">
    <h2 class="text-secondary mb-4">Docker Quiz Topics</h2>
    <p class="text-muted">Choose a subtopic below to test your Docker knowledge.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Docker Introduction -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Docker Introduction</h5>
                    <p class="card-text text-muted">What is Docker, containers vs VMs, Docker Engine.</p>
                    <a href="@Url.Action("DockerIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Docker CLI Commands -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Docker CLI Commands</h5>
                    <p class="card-text text-muted">Basic commands: run, ps, stop, rm, exec, logs.</p>
                    <a href="@Url.Action("DockerCommands", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Images and Containers -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Images & Containers</h5>
                    <p class="card-text text-muted">Building, pulling, tagging, and removing images.</p>
                    <a href="@Url.Action("DockerImagesContainers", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Dockerfile -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Dockerfile</h5>
                    <p class="card-text text-muted">Syntax, instructions (FROM, RUN, CMD, COPY, etc.).</p>
                    <a href="@Url.Action("Dockerfile", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Docker Volumes -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Volumes</h5>
                    <p class="card-text text-muted">Mounting, named volumes, volume drivers.</p>
                    <a href="@Url.Action("DockerVolumes", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Docker Networking -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Networking</h5>
                    <p class="card-text text-muted">Bridge, host, overlay, custom networks.</p>
                    <a href="@Url.Action("DockerNetworking", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Docker Compose -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Docker Compose</h5>
                    <p class="card-text text-muted">docker-compose.yml syntax, services, volumes, networks.</p>
                    <a href="@Url.Action("DockerCompose", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Docker Registry -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Docker Registry</h5>
                    <p class="card-text text-muted">Docker Hub, private registries, image tagging & pushing.</p>
                    <a href="@Url.Action("DockerRegistry", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Docker Security -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Docker Security</h5>
                    <p class="card-text text-muted">Image scanning, container isolation, least privilege.</p>
                    <a href="@Url.Action("DockerSecurity", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
