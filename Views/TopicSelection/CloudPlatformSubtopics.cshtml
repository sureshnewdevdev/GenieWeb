@{
    ViewData["Title"] = "Cloud Platform MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "CloudPlatform";
}

<div class="container mt-5">
    <p class="text-muted">Select a subtopic from each level to test your knowledge of cloud computing and infrastructure.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Cloud Fundamentals -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Cloud Computing Fundamentals</h5>
                    <p class="card-text text-muted">Introduction to Azure, cloud service models, and portal setup.</p>
                    <a href="@Url.Action("CloudFundamentals", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Core Services -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure Core Services</h5>
                    <p class="card-text text-muted">Explore compute, storage, networking, and identity basics in Azure.</p>
                    <a href="@Url.Action("AzureCoreServices", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- IaC Overview -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Infrastructure as Code (IaC)</h5>
                    <p class="card-text text-muted">Learn IaC principles and Azure automation tools overview.</p>
                    <a href="@Url.Action("IaCOverview", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Terraform in Azure -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Terraform in Azure</h5>
                    <p class="card-text text-muted">Configure infrastructure using Terraform, modules, and state files.</p>
                    <a href="@Url.Action("TerraformAzure", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- ARM Templates -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">ARM Templates</h5>
                    <p class="card-text text-muted">Deploy and manage Azure resources using JSON templates.</p>
                    <a href="@Url.Action("ARMTemplates", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- CI/CD in Azure -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">CI/CD in Azure</h5>
                    <p class="card-text text-muted">Build and release pipelines using Azure DevOps, GitHub Actions.</p>
                    <a href="@Url.Action("AzureCICD", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Monitoring & Logging -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Monitoring & Logging</h5>
                    <p class="card-text text-muted">Use Azure Monitor, Application Insights, and log analytics.</p>
                    <a href="@Url.Action("MonitoringLogging", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Platform Engineering & SRE -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Platform Engineering & SRE</h5>
                    <p class="card-text text-muted">Kubernetes, SLIs/SLOs, automation, and reliability practices.</p>
                    <a href="@Url.Action("PlatformSRE", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>
    </div>
</div>
