@{
    ViewData["Title"] = "Azure MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Azure";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">Azure Quiz Topics</h2>
    <p>Select a subtopic below to begin the quiz.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Core Concepts -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-primary">Azure Fundamentals</h5>
                    <p class="card-text text-muted">Regions, subscriptions, resource groups, Azure portal.</p>
                    <a href="@Url.Action("AzureFundamentals", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Storage -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure Storage</h5>
                    <p class="card-text text-muted">Account types, replication, Blob, Queue, File, Table.</p>
                    <a href="@Url.Action("AzureStorage", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Compute -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-warning">Azure Compute</h5>
                    <p class="card-text text-muted">Virtual Machines, App Services, Azure Functions.</p>
                    <a href="@Url.Action("AzureCompute", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Networking -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-info">Azure Networking</h5>
                    <p class="card-text text-muted">VNets, NSGs, load balancers, VPN gateways.</p>
                    <a href="@Url.Action("AzureNetworking", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Identity & Access -->
        <div class="col">
            <div class="card h-100 border-danger shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-danger">Azure Identity & Access</h5>
                    <p class="card-text text-muted">Azure AD, RBAC, MFA, managed identities.</p>
                    <a href="@Url.Action("AzureIdentity", "ChoiceQuestions")" class="btn btn-outline-danger mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Security -->
        <div class="col">
            <div class="card h-100 border-secondary shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-secondary">Azure Security</h5>
                    <p class="card-text text-muted">Security Center, Defender, Key Vault, compliance.</p>
                    <a href="@Url.Action("AzureSecurity", "ChoiceQuestions")" class="btn btn-outline-secondary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure DevOps -->
        <div class="col">
            <div class="card h-100 border-dark shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-dark">Azure DevOps</h5>
                    <p class="card-text text-muted">Repos, Pipelines, Boards, Artifacts.</p>
                    <a href="@Url.Action("AzureDevOps", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Monitoring -->
        <div class="col">
            <div class="card h-100 border-light shadow rounded-4 bg-light">
                <div class="card-body">
                    <h5 class="card-title text-dark">Monitoring & Insights</h5>
                    <p class="card-text text-muted">Log Analytics, Application Insights, Alerts.</p>
                    <a href="@Url.Action("AzureMonitoring", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure Data Services -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-primary">Azure Data Services</h5>
                    <p class="card-text text-muted">Azure SQL, Cosmos DB, Synapse, Data Lake.</p>
                    <a href="@Url.Action("AzureData", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Azure AI & Machine Learning -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure AI & ML</h5>
                    <p class="card-text text-muted">Azure ML Studio, Cognitive Services, Bot Framework.</p>
                    <a href="@Url.Action("AzureAI", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
