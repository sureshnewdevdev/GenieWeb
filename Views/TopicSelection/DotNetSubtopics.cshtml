@{
    ViewData["Title"] = ".NET Core MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "DotNet";
}

<div class="container mt-5">
    <h2 class="text-info mb-4">.NET Core Quiz Topics</h2>
    <p>Select a subtopic below to begin the quiz.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- .NET Core Basics -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">.NET Core Basics</h5>
                        <p class="card-text text-muted">Core concepts, SDK, CLI tools, and architecture.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreBasics", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Middleware -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">Middleware</h5>
                        <p class="card-text text-muted">Request pipeline, custom middleware, use/next logic.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreMiddleware", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Routing -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Routing</h5>
                        <p class="card-text text-muted">Endpoint routing, attribute routing, route templates.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreRouting", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Dependency Injection -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning">Dependency Injection</h5>
                        <p class="card-text text-muted">Services, lifetimes (Transient, Scoped, Singleton).</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreDI", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Configuration & Settings -->
        <div class="col">
            <div class="card h-100 border-secondary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-secondary">Configuration & Settings</h5>
                        <p class="card-text text-muted">appsettings.json, IOptions pattern, user secrets.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreConfig", "ChoiceQuestions")" class="btn btn-outline-secondary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Entity Framework Core -->
        <div class="col">
            <div class="card h-100 border-danger shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-danger">Entity Framework Core</h5>
                        <p class="card-text text-muted">DbContext, migrations, LINQ, CRUD operations.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreEFCore", "ChoiceQuestions")" class="btn btn-outline-danger mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Web API -->
        <div class="col">
            <div class="card h-100 border-dark shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-dark">Web API</h5>
                        <p class="card-text text-muted">Controllers, actions, attributes, JSON formatting.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreWebAPI", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Logging & Monitoring -->
        <div class="col">
            <div class="card h-100 border-light shadow rounded-4 bg-light">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-dark">Logging & Monitoring</h5>
                        <p class="card-text text-muted">ILogger, Serilog, log levels, built-in providers.</p>
                    </div>
                    <a href="@Url.Action("DotNetCoreLogging", "ChoiceQuestions")" class="btn btn-outline-dark mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
