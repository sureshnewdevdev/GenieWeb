@{
    ViewData["Title"] = "Terraform MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Terraform";
}

<div class="container mt-5">
    <h2 class="text-dark mb-4">Terraform Quiz Topics</h2>
    <p class="text-muted">Select a subtopic from each level to test your Terraform knowledge.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Terraform Introduction -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Terraform Introduction</h5>
                    <p class="card-text text-muted">IaC overview, Terraform vs ARM, use cases, workflow.</p>
                    <a href="@Url.Action("TerraformIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform CLI Basics -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Terraform CLI Basics</h5>
                    <p class="card-text text-muted">init, plan, apply, destroy, validate, fmt, taint.</p>
                    <a href="@Url.Action("TerraformCLI", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform Configuration Files -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Configuration Files</h5>
                    <p class="card-text text-muted">.tf files, main.tf, variables.tf, outputs.tf structure.</p>
                    <a href="@Url.Action("TerraformConfigs", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Variables and Outputs -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Variables & Outputs</h5>
                    <p class="card-text text-muted">Variable types, default values, outputs, interpolation.</p>
                    <a href="@Url.Action("TerraformVariables", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Providers and Resources -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Providers & Resources</h5>
                    <p class="card-text text-muted">Azure, AWS, Google providers, defining resources.</p>
                    <a href="@Url.Action("TerraformProviders", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- State Management -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">State Management</h5>
                    <p class="card-text text-muted">Terraform.tfstate, remote backends, state locking.</p>
                    <a href="@Url.Action("TerraformState", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform Lifecycle -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Resource Lifecycle</h5>
                    <p class="card-text text-muted">create_before_destroy, prevent_destroy, lifecycle blocks.</p>
                    <a href="@Url.Action("TerraformLifecycle", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Terraform Modules -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Terraform Modules</h5>
                    <p class="card-text text-muted">Reusable modules, local vs remote, module inputs/outputs.</p>
                    <a href="@Url.Action("TerraformModules", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform Workspaces -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Workspaces</h5>
                    <p class="card-text text-muted">Managing environments: dev, test, prod isolation.</p>
                    <a href="@Url.Action("TerraformWorkspaces", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform with Azure -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Terraform with Azure</h5>
                    <p class="card-text text-muted">Deploying VMs, networks, storage to Azure using Terraform.</p>
                    <a href="@Url.Action("TerraformAzure", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Terraform Best Practices -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Best Practices</h5>
                    <p class="card-text text-muted">Code organization, versioning, automation & secrets.</p>
                    <a href="@Url.Action("TerraformBestPractices", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
