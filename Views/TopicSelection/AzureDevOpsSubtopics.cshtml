@{
    ViewData["Title"] = "Azure DevOps MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "AzureDevOps";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4">Azure DevOps Quiz Topics</h2>
    <p class="text-muted">Select a level and topic to begin your assessment.</p>

    <!-- BEGINNER LEVEL -->
    <h4 class="text-success mt-5">🟢 Beginner Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Azure DevOps Overview -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Azure DevOps Overview</h5>
                    <p class="card-text text-muted">Azure DevOps features, services, and workflow.</p>
                    <a href="@Url.Action("AzureDevOpsIntro", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Projects and Boards -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Projects & Boards</h5>
                    <p class="card-text text-muted">Work items, epics, user stories, sprints, Kanban.</p>
                    <a href="@Url.Action("AzureBoards", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Repos (Git) -->
        <div class="col">
            <div class="card border-success shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Repos (Git)</h5>
                    <p class="card-text text-muted">Code versioning, branching, pull requests.</p>
                    <a href="@Url.Action("AzureRepos", "ChoiceQuestions")" class="btn btn-outline-success w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- INTERMEDIATE LEVEL -->
    <h4 class="text-primary mt-5">🟡 Intermediate Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Pipelines (CI) -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Pipelines (CI)</h5>
                    <p class="card-text text-muted">Build pipelines, triggers, YAML vs classic editors.</p>
                    <a href="@Url.Action("AzurePipelinesCI", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Pipelines (CD) -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Pipelines (CD)</h5>
                    <p class="card-text text-muted">Release pipelines, approvals, deployment groups.</p>
                    <a href="@Url.Action("AzurePipelinesCD", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Artifacts -->
        <div class="col">
            <div class="card border-primary shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Artifacts</h5>
                    <p class="card-text text-muted">Package feeds, publishing, consuming packages.</p>
                    <a href="@Url.Action("AzureArtifacts", "ChoiceQuestions")" class="btn btn-outline-primary w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ADVANCED LEVEL -->
    <h4 class="text-danger mt-5">🔴 Advanced Level</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- YAML Pipelines -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">YAML Pipelines</h5>
                    <p class="card-text text-muted">Multi-stage builds, templates, conditional steps.</p>
                    <a href="@Url.Action("AzureYAMLPipelines", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Service Connections & Integrations -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Service Connections</h5>
                    <p class="card-text text-muted">Connecting to Azure, GitHub, Docker Hub, etc.</p>
                    <a href="@Url.Action("AzureServiceConnections", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

        <!-- DevOps Security -->
        <div class="col">
            <div class="card border-danger shadow rounded-4 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">DevOps Security</h5>
                    <p class="card-text text-muted">Permissions, RBAC, secrets, secure variables.</p>
                    <a href="@Url.Action("AzureDevOpsSecurity", "ChoiceQuestions")" class="btn btn-outline-danger w-100">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
