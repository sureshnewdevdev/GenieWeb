@{
    ViewData["Title"] = "C# Fundamentals Company MCQ Test";
    ViewData["FullWidthContent"] = true;
}

<div class="container-fluid py-4 bg-light min-vh-100 mcq-prompt-preview-page">
    <div class="row g-4">
        <main class="col-12 mcq-preview-container">
            <section class="card border-0 shadow mb-4 overflow-hidden">
                <div class="card-body p-4 text-white" style="background:linear-gradient(135deg,#111827,#1d4ed8,#7c3aed);">
                    <span class="badge text-bg-warning mb-2">Company MCQs · C#/.NET Expert Track</span>
                    <h1 class="h4 mb-2">C# Fundamentals - 20 Question Test</h1>
                    <p class="mb-0">Professional one-by-one assessment with <b>5 normal questions</b> and <b>15 scenario-based code snippet questions</b>. Each question has 4 options. Answers and explanations are revealed only at the end.</p>
                </div>
            </section>

            <section id="quizSection" class="card border-0 shadow-sm w-100 mcq-question-card">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h2 class="h5 mb-1">MCQ Test</h2>
                            <p class="text-muted small mb-0">Question shown one by one for focused evaluation.</p>
                        </div>
                        <span class="badge text-bg-info" id="progressText">Question 1 of 20</span>
                    </div>
                    <div class="progress mb-3" style="height:8px;">
                        <div id="progressBar" class="progress-bar" role="progressbar" style="width:5%"></div>
                    </div>

                    <div id="questionCard" class="card border-0 bg-body-tertiary">
                        <div class="card-body" id="questionBody"></div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <button class="btn btn-outline-secondary" id="prevBtn" onclick="prevQuestion()">Previous</button>
                        <button class="btn btn-primary" id="nextBtn" onclick="nextQuestion()">Next</button>
                        <button class="btn btn-success d-none" id="finishBtn" onclick="submitQuiz()">Finish Test</button>
                    </div>
                </div>
            </section>

            <section id="resultSection" class="card border-0 shadow mt-4 d-none">
                <div class="card-body p-4">
                    <h3 class="h5 mb-3">Final Result</h3>
                    <div id="resultSummary" class="alert alert-primary"></div>


                    <h4 class="h6">Correct Answers with Explanations</h4>
                    <div id="reviewSection"></div>
                </div>
            </section>
        </main>

    </div>
</div>

<style>

    .mcq-prompt-preview-page,
    .mcq-prompt-preview-page .row,
    .mcq-prompt-preview-page .mcq-preview-container,
    .mcq-prompt-preview-page .mcq-question-card,
    .mcq-prompt-preview-page #questionCard,
    .mcq-prompt-preview-page #resultSection {
        width: 100%;
        max-width: none;
    }
    .snippet-block {
        background: #000;
        color: #f8f9fa;
        border-radius: .5rem;
        padding: .85rem 1rem;
        font-family: Consolas, Monaco, "Courier New", monospace;
        font-size: .9rem;
        margin-top: .75rem;
        white-space: pre-wrap;
    }
</style>

<script>
const questions = [
{ qType:"normal", q:"In a payroll microservice, a developer uses `var salary = 25000m;`. What is true in this real project scenario?", o:["`salary` becomes dynamic at runtime","`salary` is inferred as decimal at compile time","`salary` can later become string automatically","`var` makes the variable globally scoped"], a:1, e:"In production code, `var` only asks the compiler to infer the type from the right-hand side. Here `25000m` makes the variable `decimal`, which remains strongly typed and safe for financial operations." },
{ qType:"normal", q:"Your team built a custom `EmployeeBatch` class and `foreach` is required in audit processing. Which interface is mandatory?", o:["IComparable","ICloneable","IEnumerable","IDisposable"], a:2, e:"`foreach` requires an enumerator contract. In corporate projects, implementing `IEnumerable` (or `IEnumerable<T>`) gives predictable iteration and integration with LINQ pipelines." },
{ qType:"normal", q:"A high-traffic API opens SQL connections per request. Why should you wrap connections in `using`?", o:["To avoid null references","To force garbage collection immediately","To guarantee deterministic release of connection resources","To make queries faster automatically"], a:2, e:"Enterprise systems must release scarce resources quickly. `using` ensures `Dispose` runs even during exceptions, preventing pool exhaustion and random production outages." },
{ qType:"normal", q:"Your platform team wants to stop inheritance of a security-sensitive class. Which keyword fits this governance policy?", o:["sealed","readonly","static","partial"], a:0, e:"`sealed` prevents subclassing. This is common in enterprise libraries where behavior must not be overridden for compliance, stability, or security reasons." },
{ qType:"normal", q:"In a console-based deployment utility, an exception escapes all handlers. What should you expect in production?", o:["It is silently ignored","Process terminates after stack unwinding","CLR retries the operation automatically","Only a warning log appears and app continues"], a:1, e:"Unhandled exceptions bubble up and terminate the process. Mature teams add global exception handling plus structured logging to capture root cause before termination." },

{ qType:"snippet", q:"What is the output?\n\nint x = 5;\nint y = x++;\nConsole.WriteLine($\"x={x}, y={y}\");", o:["x=5, y=6","x=6, y=5","x=6, y=6","Compilation error"], a:1, e:"Post-increment returns old value then increments `x`." },
{ qType:"snippet", q:"What is printed?\n\nstring s = null;\nConsole.WriteLine(s?.Length ?? -1);", o:["0","null","-1","Throws NullReferenceException"], a:2, e:"Null-conditional returns null, then null-coalescing picks -1." },
{ qType:"snippet", q:"Choose the output:\n\nvar nums = new List<int>{1,2,3};\nnums.ForEach(n => n *= 2);\nConsole.WriteLine(string.Join(\",\", nums));", o:["2,4,6","1,2,3","Runtime error","Compilation error"], a:1, e:"Lambda parameter `n` is a copy; list values are unchanged." },
{ qType:"snippet", q:"What happens?\n\nobject o = \"42\";\nint n = (int)o;", o:["n becomes 42","Compilation error","InvalidCastException at runtime","n becomes 0"], a:2, e:"Direct cast from boxed string to int is invalid and throws at runtime." },
{ qType:"snippet", q:"Output?\n\nint[] a = {1,2,3};\nvar q = a.Where(x => x > 1);\na[1] = 10;\nConsole.WriteLine(string.Join(\",\", q));", o:["2,3","10,3","1,10,3","Compilation error"], a:1, e:"LINQ query is deferred; after mutation it evaluates as 10 and 3." },
{ qType:"snippet", q:"Result?\n\nConsole.WriteLine(10 / 4);\nConsole.WriteLine(10 / 4.0);", o:["2 and 2","2 and 2.5","2.5 and 2.5","Compilation error"], a:1, e:"Integer division truncates; double division preserves fraction." },
{ qType:"snippet", q:"What is output?\n\nvar set = new HashSet<int>{1,1,2,3};\nConsole.WriteLine(set.Count);", o:["2","3","4","Compilation error"], a:1, e:"HashSet stores unique values only." },
{ qType:"snippet", q:"What is printed?\n\nstring text = \"DotNet\";\nConsole.WriteLine(text[^1]);", o:["D","t","N","Runtime error"], a:1, e:"`^1` indexes from end, so last character is `t`." },
{ qType:"snippet", q:"Output?\n\nint? n = null;\nConsole.WriteLine(n.GetValueOrDefault(99));", o:["0","99","null","InvalidOperationException"], a:1, e:"GetValueOrDefault returns provided fallback when nullable is null." },
{ qType:"snippet", q:"What is output?\n\nvar dict = new Dictionary<string,int>{{\"a\",1}};\nConsole.WriteLine(dict.ContainsKey(\"A\"));", o:["True","False","Compilation error","KeyNotFoundException"], a:1, e:"Default string comparer is case-sensitive." },
{ qType:"snippet", q:"What is printed?\n\nTask<int> t = Task.FromResult(7);\nConsole.WriteLine(t.Result);", o:["0","7","Compilation error","Deadlock always"], a:1, e:"FromResult creates completed task; Result is immediately 7." },
{ qType:"snippet", q:"Choose output:\n\nvar arr = new[] {\"a\", \"b\"};\nConsole.WriteLine(string.Join(\"-\", arr.Select(x => x.ToUpper())));", o:["a-b","A-B","AB","Compilation error"], a:1, e:"Select transforms both items to uppercase before join." },
{ qType:"snippet", q:"Output?\n\nint x = 1;\nvoid Inc(ref int v) => v++;\nInc(ref x);\nConsole.WriteLine(x);", o:["0","1","2","Compilation error"], a:2, e:"`ref` passes variable by reference so increment updates original value." },
{ qType:"snippet", q:"What happens here?\n\nSpan<int> s = stackalloc int[3] {1,2,3};\nConsole.WriteLine(s[2]);", o:["1","2","3","Compilation error"], a:2, e:"Valid stack allocation for Span; third element is 3." },
{ qType:"snippet", q:"Output?\n\nvar people = new[]{ new {Name=\"Ana\",Age=20}, new {Name=\"Ben\",Age=30} };\nConsole.WriteLine(people.OrderByDescending(p=>p.Age).First().Name);", o:["Ana","Ben","Compilation error","Null"], a:1, e:"Descending by age puts Ben first." },
{ qType:"snippet", q:"What is printed?\n\nint total = Enumerable.Range(1,4).Aggregate((acc, n) => acc + n);\nConsole.WriteLine(total);", o:["9","10","11","Compilation error"], a:1, e:"Aggregate sums 1+2+3+4 = 10." }
];

let currentIndex = 0;
const selected = new Array(questions.length).fill(-1);
let scorePct = 0;
let audioCtx;

function ensureAudio(){ if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
function stopAllAudio(){ if(audioCtx && audioCtx.state !== 'closed'){ audioCtx.close(); audioCtx = null; } }

function playPattern(type, seconds = 2){
    ensureAudio();
    const now = audioCtx.currentTime;
    const duration = Math.max(1, seconds);
    const patterns = {
        fail: [196,174,155,130],
        good: [262,330,392,330],
        distinct: [392,494,659,784],
        special: [523,659,784,1046,1318]
    };
    const notes = patterns[type] || patterns.good;
    const step = duration / notes.length;
    notes.forEach((freq, i) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type === 'fail' ? 'sawtooth' : 'triangle';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.0001, now + i * step);
        gain.gain.exponentialRampToValueAtTime(0.06, now + i * step + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + (i + 1) * step);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start(now + i * step);
        osc.stop(now + (i + 1) * step);
    });
}

function updateProgress(){
    document.getElementById('progressText').textContent = `Question ${currentIndex + 1} of ${questions.length}`;
    document.getElementById('progressBar').style.width = `${((currentIndex + 1) / questions.length) * 100}%`;
}

function renderQuestion(){
    const q = questions[currentIndex];
    const questionText = q.q.replace(/\n/g, '<br>');
    const questionHtml = q.qType === 'snippet'
        ? `<h4 class="h6 mb-3">Q${currentIndex + 1}. ${questionText.split('<br><br>')[0]}</h4><pre class="snippet-block">${questionText.split('<br><br>')[1] || ''}</pre>`
        : `<h4 class="h6 mb-3">Q${currentIndex + 1}. ${questionText}</h4>`;
    const html = `
    <p class="mb-2 text-secondary"><span class="badge text-bg-secondary">${q.qType === 'normal' ? 'Conceptual' : 'Code Scenario'}</span></p>
    ${questionHtml}
    <div class="d-grid gap-2">
        ${q.o.map((opt, i) => `
            <label class="btn btn-outline-dark text-start ${selected[currentIndex] === i ? 'active' : ''}">
                <input class="d-none" type="radio" name="opt" value="${i}" ${selected[currentIndex] === i ? 'checked' : ''} onchange="selectOption(${i})">
                <strong>${String.fromCharCode(65 + i)}.</strong> ${opt}
            </label>
        `).join('')}
    </div>`;

    document.getElementById('questionBody').innerHTML = html;
    document.getElementById('prevBtn').disabled = currentIndex === 0;
    document.getElementById('nextBtn').classList.toggle('d-none', currentIndex === questions.length - 1);
    document.getElementById('finishBtn').classList.toggle('d-none', currentIndex !== questions.length - 1);
    updateProgress();
}

function selectOption(i){ selected[currentIndex] = i; renderQuestion(); }
function nextQuestion(){ if(currentIndex < questions.length - 1){ currentIndex++; renderQuestion(); } }
function prevQuestion(){ if(currentIndex > 0){ currentIndex--; renderQuestion(); } }

function submitQuiz(){
    if(!confirm('Are you sure you want to finish this test and submit your answers?')) return;

    let score = 0;
    const review = questions.map((q, i) => {
        const yourIndex = selected[i];
        const correct = q.a === yourIndex;
        if (correct) score++;
        return {
            q: q.q,
            your: yourIndex >= 0 ? q.o[yourIndex] : 'Not Answered',
            ans: q.o[q.a],
            exp: q.e,
            ok: correct
        };
    });

    scorePct = (score / questions.length) * 100;
    const band = scorePct < 50 ? 'fail' : scorePct < 75 ? 'good' : scorePct < 100 ? 'distinct' : 'special';
    const performance = scorePct < 50 ? 'Needs improvement' : scorePct < 75 ? 'Good effort' : scorePct < 100 ? 'Distinct performance' : 'Perfect score';

    document.getElementById('resultSummary').innerHTML = `
        <div><strong>Score:</strong> ${score}/${questions.length} (${scorePct.toFixed(1)}%)</div>
        <div><strong>Performance:</strong> ${performance}</div>
        <div><strong>Sound Theme:</strong> ${band.toUpperCase()}</div>`;

    document.getElementById('reviewSection').innerHTML = review.map((r, i) => `
        <div class="border rounded p-3 mb-2 ${r.ok ? 'border-success' : 'border-danger'}">
            <div class="fw-semibold">Q${i + 1}: ${r.q}</div>
            <div>Your answer: <span class="${r.ok ? 'text-success' : 'text-danger'}">${r.your}</span></div>
            <div>Correct answer: <b>${r.ans}</b></div>
            <div class="small text-muted">Trainer Note: ${r.exp}</div>
        </div>
    `).join('');

    document.getElementById('resultSection').classList.remove('d-none');
    playPattern(band, 5);
}

renderQuestion();
</script>
