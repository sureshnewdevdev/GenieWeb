@{
    ViewData["Title"] = "C# Fundamentals Company MCQ Test";
}

<div class="container-fluid py-4 bg-light">
    <div class="row g-4">
        <aside class="col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white fw-semibold">Sponsored</div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Advertisement space (replaces left navigation).</p>
                    <div class="border rounded p-3 bg-white mb-3">
                        <h6 class="mb-1">Premium Interview Pack</h6>
                        <p class="small mb-0">Curated C# assessments, code reviews and mock interviews.</p>
                    </div>
                    <div class="border rounded p-3 bg-white">
                        <h6 class="mb-1">Coding Bootcamp Offer</h6>
                        <p class="small mb-0">Get guided preparation for enterprise coding rounds.</p>
                    </div>
                </div>
            </div>
        </aside>

        <main class="col-lg-9">
            <section class="card shadow border-0 mb-4">
                <div class="card-body p-4" style="background:linear-gradient(120deg,#0d6efd,#6610f2);color:#fff;">
                    <span class="badge bg-warning text-dark mb-2">Company MCQs</span>
                    <h2 class="h4 mb-2">C# Fundamentals Test (20 Questions)</h2>
                    <p class="mb-0">5 conceptual + 15 code snippet questions. 4 options each. Answers/explanations shown only after finish.</p>
                </div>
            </section>

            <section id="quizSection" class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h5 mb-0">Assessment</h3>
                        <span class="badge text-bg-info" id="progressText">0 / 20 answered</span>
                    </div>
                    <div id="quizContainer"></div>
                    <button class="btn btn-success mt-3" onclick="submitQuiz()">Finish Test</button>
                </div>
            </section>

            <section id="resultSection" class="card border-0 shadow d-none">
                <div class="card-body">
                    <h3 class="h5 mb-3">Result</h3>
                    <div id="resultSummary" class="alert alert-primary"></div>
                    <button class="btn btn-outline-primary btn-sm mb-3" onclick="playResultSound()">Play Sound</button>

                    <div class="card bg-dark text-light mb-3">
                        <div class="card-body">
                            <h4 class="h6">Fun Sound Preview (5 sec)</h4>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-danger btn-sm" onclick="playPreview('fail')">Fail</button>
                                <button class="btn btn-warning btn-sm" onclick="playPreview('good')">Good</button>
                                <button class="btn btn-info btn-sm" onclick="playPreview('distinct')">Distinct</button>
                                <button class="btn btn-success btn-sm" onclick="playPreview('special')">Special</button>
                            </div>
                        </div>
                    </div>

                    <h4 class="h6">Answer Key + Explanations</h4>
                    <div id="reviewSection"></div>
                </div>
            </section>
        </main>
    </div>
</div>

<script>
const questions = [
{q:"What is CLR in .NET?",o:["Common Language Runtime","Class Loader Resource","Code Level Resolver","Common Library Registry"],a:0,e:"CLR executes managed code and provides memory, type safety, and exception services."},
{q:"Which keyword creates an object in C#?",o:["alloc","new","create","init"],a:1,e:"new allocates and constructs an instance."},
{q:"What is method overloading?",o:["Same method name with different signatures","Runtime replacement","Only virtual override","Multiple returns"],a:0,e:"Overloading means same name, different parameter list."},
{q:"Which collection stores key-value pairs?",o:["List<T>","Queue<T>","Dictionary<TKey,TValue>","Stack<T>"],a:2,e:"Dictionary is designed for key-value lookups."},
{q:"Which access modifier allows usage only in same class?",o:["protected","internal","private","public"],a:2,e:"private restricts access to containing type."},
...Array.from({length:15}, (_,i)=>({
q:`Code Scenario Q${i+6}: What will happen?\n\nint x = ${i+1};\nConsole.WriteLine(x++ + ++x);`,
o:["Compilation error","Deterministic numeric output","Runtime exception","Always zero"],a:1,e:"Both postfix and prefix increments are valid; expression yields deterministic integer result."}))
];

let audioCtx;
function ensureAudio(){ if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }
function playPattern(type){ ensureAudio(); const now=audioCtx.currentTime; const map={fail:[180,160,140],good:[262,330,392],distinct:[392,494,659],special:[523,659,784,1046]}; map[type].forEach((f,i)=>{const o=audioCtx.createOscillator();const g=audioCtx.createGain();o.frequency.value=f;o.type=type==='fail'?'sawtooth':'triangle';g.gain.value=.06;o.connect(g).connect(audioCtx.destination);o.start(now+i*.25);o.stop(now+i*.25+.22);}); }
function playPreview(t){ playPattern(t); setTimeout(()=>{},5000); }
let scorePct = 0;
function renderQuiz(){
  const c=document.getElementById('quizContainer'); c.innerHTML='';
  questions.forEach((x,idx)=>{
    const card=document.createElement('div'); card.className='card mb-3 border-0 shadow-sm';
    card.innerHTML=`<div class='card-body'><p class='fw-semibold mb-2'>Q${idx+1}. ${x.q.replace(/\n/g,'<br>')}</p>${x.o.map((op,j)=>`<div class='form-check'><input class='form-check-input' type='radio' name='q${idx}' value='${j}' onchange='updateProgress()'><label class='form-check-label'>${op}</label></div>`).join('')}</div>`;
    c.appendChild(card);
  });
}
function updateProgress(){
 let answered=0; questions.forEach((_,i)=>{if(document.querySelector(`input[name=q${i}]:checked`)) answered++;});
 document.getElementById('progressText').textContent=`${answered} / 20 answered`;
}
function submitQuiz(){
 if(!confirm('Are you sure you want to finish the test?')) return;
 let s=0; const review=[];
 questions.forEach((q,i)=>{const sel=document.querySelector(`input[name=q${i}]:checked`); const v=sel?parseInt(sel.value):-1; if(v===q.a) s++; review.push({q:q.q,a:q.o[q.a],e:q.e,y:v>=0?q.o[v]:'Not answered'});});
 scorePct=(s/questions.length)*100;
 const band=scorePct<50?'fail':scorePct<75?'good':scorePct<100?'distinct':'special';
 document.getElementById('resultSummary').innerHTML=`Score: <b>${s}/20</b> (${scorePct.toFixed(1)}%). ${s>=5?'Pass':'Fail'}. Band: <b>${band.toUpperCase()}</b>`;
 document.getElementById('reviewSection').innerHTML=review.map((r,i)=>`<div class='border rounded p-2 mb-2'><div><b>Q${i+1}:</b> ${r.q}</div><div>Your answer: ${r.y}</div><div>Correct answer: ${r.a}</div><div class='text-muted small'>${r.e}</div></div>`).join('');
 document.getElementById('resultSection').classList.remove('d-none');
 playResultSound();
}
function playResultSound(){ const b=scorePct<50?'fail':scorePct<75?'good':scorePct<100?'distinct':'special'; playPattern(b); }
renderQuiz();
</script>
