@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-4">
    <div class="container">
        <h1 class="mb-3">Prompt Instructions and Guidelines</h1>
        <p class="lead">Consistent instructions make LLM outputs easier to review, reuse, and automate. Borrow these guidelines when designing prompts for your team.</p>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h2 class="h4">Structure Checklist</h2>
                <ol class="mb-0">
                    <li>Start with the role or persona for the assistant.</li>
                    <li>Describe the task and expected audience.</li>
                    <li>List must-have sections or data points.</li>
                    <li>Specify tone, length, or formatting rules.</li>
                    <li>State what to do when information is missing.</li>
                </ol>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h4">Helpful Phrases</h2>
                        <ul class="mb-0">
                            <li>“Respond using markdown headings.”</li>
                            <li>“Return JSON only with fields …”</li>
                            <li>“Cite the provided source IDs inline.”</li>
                            <li>“Ask clarifying questions before answering if requirements are unclear.”</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h4">Quality Guardrails</h2>
                        <ul class="mb-0">
                            <li>Define words or acronyms that could be misunderstood.</li>
                            <li>Call out forbidden behaviors (e.g., “Never fabricate statistics”).</li>
                            <li>Include a simple acceptance test at the end.</li>
                            <li>Encourage the assistant to state assumptions explicitly.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
