@{
    ViewData["ActivePage"] = "Dashboard";
    var userName = Context.Session.GetString("UserName") ?? "User";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Welcome, @userName!</h2>
    <p class="text-center text-muted mb-5">Explore your available courses below.</p>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">C# Fundamentals</h5>
                    <p class="card-text">Master object-oriented programming with real-world projects.</p>
                    <a href="@Url.Action("IntroductionToCSharp", "CSharp")" class="btn btn-primary">Go to Course</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Azure Fundamentals</h5>
                    <p class="card-text">Get started with core Azure services and cloud concepts.</p>
                    <a href="@Url.Action("Azure", "Home")" class="btn btn-primary">Go to Course</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">React for Beginners</h5>
                    <p class="card-text">Build modern web applications with React.js step-by-step.</p>
                    <a href="@Url.Action("IntroductionToReact", "React")" class="btn btn-primary">Go to Course</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 1rem;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: bold;
    }
    #sidebarMenu {
        display: none !important;
    }
</style>
