@{
    Layout = "_SliderLeft";
    ViewData["Title"] = "ASP.NET MVC";
    ViewData["HeroTitle"] = "ASP.NET MVC";
    ViewData["HeroIntroHtml"] = "<p>Start learning ASP.NET MVC from fundamentals to core framework concepts.</p>";
    ViewData["HeroTags"] = "ASP.NET MVC,Web Application,Routing,Filters,Bundling";
}

@section CourseData {
<script>
window.COURSE_DATA = [
  {
    id: "m1",
    badge: "1",
    title: "Course: ASP.NET MVC",
    desc: "Core topics and fundamentals",
    topics: [
      { id: "m1-a1", title: "What is Web application?", tags: ["Basics"], intro: "Understand what a web application is.", blocks: [{ heading: "Overview", html: `<p>A web application is software accessed through a web browser over a network, typically the internet or an intranet.</p>` }] },
      { id: "m1-a2", title: "What is ASP.NET Web Application?", tags: ["ASP.NET"], intro: "Learn ASP.NET web app basics.", blocks: [{ heading: "Overview", html: `<p>An ASP.NET web application is a dynamic website or service built using Microsoft's ASP.NET framework.</p>` }] },
      { id: "m1-a3", title: "Why ASP.NET MVC?", tags: ["MVC"], intro: "Why teams choose ASP.NET MVC.", blocks: [{ heading: "Overview", html: `<p>ASP.NET MVC offers separation of concerns, testability, and full control over HTML and routing.</p>` }] },
      { id: "m1-a4", title: "Overview of MVC Architecture", tags: ["Architecture"], intro: "Model, View, and Controller explained.", blocks: [{ heading: "Overview", html: `<p>MVC Architecture separates data (Model), UI (View), and request handling (Controller).</p>` }] },
      { id: "m1-a5", title: "Prerequisites for learning ASP.NET MVC", tags: ["Prerequisites"], intro: "Skills needed before you start.", blocks: [{ heading: "Overview", html: `<p>You should know basic C#, OOP concepts, HTML/CSS/JavaScript, and SQL fundamentals.</p>` }] },
      { id: "m1-a6", title: "ASP.NET MVC Framework Version History", tags: ["Versioning"], intro: "Track MVC evolution over releases.", blocks: [{ heading: "Overview", html: `<p>ASP.NET MVC evolved through multiple versions, improving routing, Razor, scaffolding, and integration features.</p>` }] },
      { id: "m1-a7", title: "Create First MVC App", tags: ["Hands-on"], intro: "Build your first application.", blocks: [{ heading: "Overview", html: `<p>Create a new ASP.NET MVC project, configure routes, add controller and view, then run the app.</p>` }] },
      { id: "m1-a8", title: "MVC Folder Structure", tags: ["Project Structure"], intro: "Understand core folders in MVC.", blocks: [{ heading: "Overview", html: `<p>Typical folders include Models, Views, Controllers, App_Start, Content, Scripts, and Areas.</p>` }] },
      { id: "m1-a9", title: "Routing in ASP.NET MVC", tags: ["Routing"], intro: "Map URLs to controller actions.", blocks: [{ heading: "Overview", html: `<p>Routing determines how incoming URLs are matched to controllers and actions using route templates.</p>` }] },
      { id: "m1-a10", title: "Filters in ASP.NET MVC", tags: ["Filters"], intro: "Run logic before or after actions.", blocks: [{ heading: "Overview", html: `<p>Filters provide reusable cross-cutting behavior such as authorization, logging, and exception handling.</p>` }] },
      { id: "m1-a11", title: "ActionFilter Attributes", tags: ["Attributes"], intro: "Use action filters in code.", blocks: [{ heading: "Overview", html: `<p>ActionFilter attributes let you execute code before and after action methods and result execution.</p>` }] },
      { id: "m1-a12", title: "What is Bundling in ASP.NET MVC?", tags: ["Optimization"], intro: "Optimize static assets.", blocks: [{ heading: "Overview", html: `<p>Bundling combines and minifies CSS/JS files to reduce HTTP requests and improve load performance.</p>` }] },
      { id: "m1-a13", title: "ScriptBundle", tags: ["Bundling"], intro: "Bundle JavaScript files.", blocks: [{ heading: "Overview", html: `<p>ScriptBundle groups JavaScript files and can apply minification for production builds.</p>` }] },
      { id: "m1-a14", title: "StyleBundle", tags: ["Bundling"], intro: "Bundle style sheets.", blocks: [{ heading: "Overview", html: `<p>StyleBundle combines CSS files and optimizes them for faster page rendering.</p>` }] },
      { id: "m1-a15", title: "Area in ASP.NET MVC", tags: ["Areas"], intro: "Organize large apps.", blocks: [{ heading: "Overview", html: `<p>Areas divide large MVC applications into smaller functional sections with their own controllers and views.</p>` }] }
    ]
  }
];

if (!location.hash || location.hash === "#home") {
  location.hash = "#m1-a1";
}
</script>
}
