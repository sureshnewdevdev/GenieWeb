      { id: "m1-a6", title: "ASP.NET MVC Framework Version History", tags: ["Versioning"], intro: "Track MVC evolution over releases.", blocks: [{ heading: "Overview", html: `<p>ASP.NET MVC evolved through multiple versions, improving routing, Razor, scaffolding, and integration features.</p>` }] },
      { id: "m1-a7", title: "Create First MVC App", tags: ["Hands-on"], intro: "Build your first application.", blocks: [{ heading: "Overview", html: `<p>Create a new ASP.NET MVC project, configure routes, add controller and view, then run the app.</p>` }] },
