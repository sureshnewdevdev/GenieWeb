@{
    ViewData["Title"] = "Courses";
    ViewData["ActiveMenu"] = "Courses";

    var courses = new[]
    {
        new { Title = "Generative AI with Python", Tagline = "Ship production-grade AI workflows with Python, LLM tooling, and responsible guardrails.", Level = "Intermediate", Modules = "12 modules", Path = "https://www.python.org" },
        new { Title = "Core Java Foundations", Tagline = "Build reliable services with modern Java patterns, testing discipline, and cloud-ready practices.", Level = "Beginner friendly", Modules = "15 modules", Path = "https://www.oracle.com/java/" },
        new { Title = "React Interface Design", Tagline = "Design accessible, performant interfaces using React, TypeScript, and reusable component systems.", Level = "Intermediate", Modules = "10 modules", Path = "https://react.dev/" },
        new { Title = "C#/.NET Engineering", Tagline = "Create maintainable .NET solutions with clean architecture, API design, and DevOps automation.", Level = "Advanced", Modules = "14 modules", Path = "https://dotnet.microsoft.com/" }
    };
}

<style>
    .courses-shell {
        background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.08), transparent 35%),
                    radial-gradient(circle at 90% 10%, rgba(14, 165, 233, 0.08), transparent 30%),
                    #0b1224;
        min-height: calc(100vh - 88px);
        padding: 4rem 0 5rem;
        color: #e2e8f0;
    }

    .courses-header {
        max-width: 760px;
        margin: 0 auto 2.5rem;
        text-align: center;
    }

    .courses-header h1 {
        font-weight: 700;
        font-size: clamp(2rem, 4vw, 2.8rem);
        color: #f8fafc;
        margin-bottom: 0.75rem;
    }

    .courses-header p {
        color: #cbd5e1;
        margin: 0;
    }

    .course-list {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    }

    .course-row {
        padding: 1.5rem;
        display: flex;
        gap: 1.2rem;
        align-items: flex-start;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    .course-row:not(:last-child) {
        border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    }

    .course-row:hover {
        background: rgba(59, 130, 246, 0.08);
        transform: translateY(-2px);
    }

    .course-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(94, 234, 212, 0.9), rgba(59, 130, 246, 0.85));
        color: #0b1224;
        font-weight: 700;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .course-body h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #f8fafc;
    }

    .course-body p {
        margin: 0.4rem 0 0.9rem;
        color: #cbd5e1;
    }

    .course-meta {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .badge-soft {
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(59, 130, 246, 0.15);
        color: #bfdbfe;
        border: 1px solid rgba(96, 165, 250, 0.3);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .course-link {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #a5b4fc;
        font-weight: 700;
        text-decoration: none;
        padding: 0.45rem 0.75rem;
        border-radius: 12px;
        transition: background 0.2s ease, color 0.2s ease;
        white-space: nowrap;
    }

    .course-row:hover .course-link {
        background: rgba(129, 140, 248, 0.15);
        color: #c7d2fe;
    }

    @media (max-width: 575.98px) {
        .course-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .course-link {
            margin-left: 0;
        }
    }
</style>

<div class="courses-shell">
    <div class="container">
        <div class="courses-header">
            <h1>Courses curated for real-world delivery</h1>
            <p>Focused, outcomes-first tracks that stay concise, actionable, and aligned to your engineering goals.</p>
        </div>

        <div class="course-list">
            @foreach (var course in courses)
            {
                <div class="course-row">
                    <div class="course-icon">@course.Title.Substring(0, 1)</div>
                    <div class="course-body">
                        <h3>@course.Title</h3>
                        <p>@course.Tagline</p>
                        <div class="course-meta">
                            <span class="badge-soft">@course.Level</span>
                            <span class="badge-soft">@course.Modules</span>
                        </div>
                    </div>
                    <a class="course-link" href="@course.Path" target="_blank" rel="noopener">View syllabus</a>
                </div>
            }
        </div>
    </div>
</div>
