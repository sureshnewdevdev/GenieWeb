@{
    ViewData["Title"] = "Courses";
    ViewData["ActiveMenu"] = "Courses";
}

<style>
    .courses-page {
        position: relative;
        padding: 8rem 0 5rem;
        background-color: #020617;
        background-image: url("data:image/svg+xml;base64,");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #f8fafc;
        overflow: hidden;
    }

    .courses-page::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(30, 41, 59, 0.72));
        backdrop-filter: blur(2px);
        z-index: 0;
    }

    .courses-page .container {
        position: relative;
        z-index: 2;
    }

    .ai-light {
        position: absolute;
        border-radius: 999px;
        filter: blur(60px);
        opacity: 0.45;
        z-index: 1;
    }

    .ai-light.one {
        width: 320px;
        height: 320px;
        top: 10%;
        left: 5%;
        background: rgba(99, 102, 241, 0.75);
    }

    .ai-light.two {
        width: 360px;
        height: 360px;
        bottom: 12%;
        right: 8%;
        background: rgba(56, 189, 248, 0.7);
    }

    .courses-hero h1 {
        font-weight: 700;
        font-size: clamp(2.5rem, 5vw, 3.6rem);
        line-height: 1.1;
    }

    .courses-hero p {
        color: rgba(226, 232, 240, 0.85);
        max-width: 640px;
        font-size: 1.1rem;
    }

    .hero-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .hero-badge {
        padding: 0.6rem 1.2rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.9), rgba(99, 102, 241, 0.9));
        border: 1px solid rgba(148, 163, 184, 0.32);
        font-weight: 600;
        font-size: 0.95rem;
        color: #f8fafc;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.45);
    }

    .preview-card {
        background: rgba(15, 23, 42, 0.58);
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 1.5rem;
        padding: 1.8rem;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 50px rgba(8, 11, 25, 0.45);
    }

    .preview-card h5 {
        font-weight: 700;
        letter-spacing: 0.03em;
        color: #e2e8f0;
    }

    .preview-card ul {
        margin: 1.1rem 0 0;
        padding-left: 1.2rem;
        color: rgba(226, 232, 240, 0.88);
        font-size: 0.95rem;
    }

    .preview-card li + li {
        margin-top: 0.6rem;
    }

    .courses-grid {
        margin-top: 3.2rem;
    }

    .course-card {
        height: 100%;
        background: rgba(15, 23, 42, 0.62);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 1.5rem;
        padding: 1.5rem;
        transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
        backdrop-filter: blur(14px);
        display: flex;
        flex-direction: column;
        box-shadow: 0 24px 50px rgba(8, 11, 25, 0.38);
    }

    .course-card:hover {
        transform: translateY(-12px);
        border-color: rgba(129, 140, 248, 0.85);
        box-shadow: 0 32px 70px rgba(8, 11, 25, 0.48);
    }

    .course-visual {
        position: relative;
        border-radius: 1.25rem;
        overflow: hidden;
        height: 180px;
        margin-bottom: 1.25rem;
        background-size: cover;
        background-position: center;
    }

    .course-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.78) 100%);
    }

    .course-visual span {
        position: absolute;
        bottom: 1rem;
        left: 1.1rem;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        color: #e0e7ff;
        z-index: 1;
    }

    .course-card h5 {
        font-size: 1.35rem;
        font-weight: 700;
        color: #fff;
    }

    .course-card p {
        color: rgba(226, 232, 240, 0.82);
        margin-bottom: 1.1rem;
    }

    .course-meta {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.9rem;
        color: rgba(203, 213, 225, 0.9);
    }

    .course-card .btn {
        margin-top: 1.4rem;
        border-radius: 999px;
        padding: 0.65rem 1.6rem;
        font-weight: 600;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.96), rgba(59, 130, 246, 0.96));
        border: none;
        color: #0f172a;
    }

    .course-card .btn:hover {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.96), rgba(129, 140, 248, 0.96));
        box-shadow: 0 14px 28px rgba(59, 130, 246, 0.35);
    }

    .course-visual.ai-python {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.core-java {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.react {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.csharp {
        background-image: url("data:image/svg+xml;base64,");
    }

    @media (max-width: 991.98px) {
        .courses-page {
            padding-top: 6.5rem;
        }

        .preview-card {
            margin-top: 2.2rem;
        }

        .hero-badges {
            justify-content: center;
        }
    }
</style>

<div class="courses-page">
    <span class="ai-light one"></span>
    <span class="ai-light two"></span>

    <div class="container">
        <div class="courses-hero">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h1>Level Up with AI-Ready Tech Courses</h1>
                    <p>Master modern engineering workflows with immersive content, guided labs, and project challenges designed around real AI transformation stories.</p>
                    <div class="hero-badges">
                        <span class="hero-badge">AI-powered curriculum</span>
                        <span class="hero-badge">Hands-on cloud labs</span>
                        <span class="hero-badge">Career-ready portfolios</span>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="preview-card">
                        <h5>What you'll experience</h5>
                        <ul>
                            <li>Cutting-edge lessons blending AI, cloud, and full-stack practices.</li>
                            <li>Guided exercises that fast-track problem solving with automation.</li>
                            <li>Mentor-inspired tips, downloadable assets, and certification prep.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 courses-grid">
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual ai-python">
                        <span>AI Projects</span>
                    </div>
                    <h5>Gen AI with Python</h5>
                    <p>Build intelligent solutions using Python, machine learning, and generative AI toolchains that scale from prototypes to production.</p>
                    <div class="course-meta">
                        <span>Intermediate</span>
                        <span>12 modules</span>
                    </div>
                    <a href="https://www.python.org" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual core-java">
                        <span>Enterprise Track</span>
                    </div>
                    <h5>Core Java</h5>
                    <p>Master the fundamentals of Java programming with best practices for building stable, enterprise-ready services and microservices.</p>
                    <div class="course-meta">
                        <span>Beginner friendly</span>
                        <span>15 modules</span>
                    </div>
                    <a href="https://www.oracle.com/java/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual react">
                        <span>UI Mastery</span>
                    </div>
                    <h5>React</h5>
                    <p>Learn to build fast, modern web interfaces using React, TypeScript, and component-driven workflows that delight end users.</p>
                    <div class="course-meta">
                        <span>Intermediate</span>
                        <span>10 modules</span>
                    </div>
                    <a href="https://react.dev/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual csharp">
                        <span>Cloud Ready</span>
                    </div>
                    <h5>C#.NET</h5>
                    <p>Develop robust applications on the .NET platform with modern C# patterns, clean architecture techniques, and DevOps integration.</p>
                    <div class="course-meta">
                        <span>Advanced</span>
                        <span>14 modules</span>
                    </div>
                    <a href="https://dotnet.microsoft.com/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
        </div>
    </div>
</div>
