@{
    ViewData["Title"] = "Courses";
    ViewData["ActiveMenu"] = "Courses";
}

<style>
    .courses-page {
        position: relative;
        padding: 8rem 0 5rem;
        background-color: #020617;
        background-image: url("data:image/svg+xml;base64,");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #f8fafc;
        overflow: hidden;
    }

    .courses-page::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(30, 41, 59, 0.72));
        backdrop-filter: blur(2px);
        z-index: 0;
    }

    .courses-page .container {
        position: relative;
        z-index: 2;
    }

    .ai-light {
        position: absolute;
        border-radius: 999px;
        filter: blur(60px);
        opacity: 0.45;
        z-index: 1;
    }

    .ai-light.one {
        width: 320px;
        height: 320px;
        top: 10%;
        left: 5%;
        background: rgba(99, 102, 241, 0.75);
    }

    .ai-light.two {
        width: 360px;
        height: 360px;
        bottom: 12%;
        right: 8%;
        background: rgba(56, 189, 248, 0.7);
    }

    .courses-intro {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 3.5rem;
    }

    .courses-intro .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.4rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.85), rgba(129, 140, 248, 0.95));
        border: 1px solid rgba(148, 163, 184, 0.35);
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #f8fafc;
        box-shadow: 0 22px 45px rgba(30, 64, 175, 0.35);
    }

    .courses-intro h1 {
        margin-top: 1.7rem;
        font-weight: 700;
        font-size: clamp(2.35rem, 4.6vw, 3.4rem);
        line-height: 1.08;
    }

    .courses-intro p {
        margin: 1.1rem auto 0;
        color: rgba(226, 232, 240, 0.84);
        font-size: 1.05rem;
        max-width: 620px;
    }

    .courses-grid {
        margin-top: 3rem;
    }

    .course-card {
        position: relative;
        height: 100%;
        border-radius: 1.8rem;
        padding: 1.8rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        isolation: isolate;
        backdrop-filter: blur(18px);
        transition: transform 0.5s ease, box-shadow 0.5s ease;
        animation: cardEntry 0.85s ease both;
    }

    .courses-grid .col-md-6:nth-child(1) .course-card {
        animation-delay: 0.1s;
    }

    .courses-grid .col-md-6:nth-child(2) .course-card {
        animation-delay: 0.25s;
    }

    .courses-grid .col-md-6:nth-child(3) .course-card {
        animation-delay: 0.4s;
    }

    .courses-grid .col-md-6:nth-child(4) .course-card {
        animation-delay: 0.55s;
    }

    .course-card::before {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: inherit;
        background: conic-gradient(from 180deg, rgba(56, 189, 248, 0.8), rgba(129, 140, 248, 0.95), rgba(59, 130, 246, 0.9), rgba(56, 189, 248, 0.8));
        opacity: 0;
        transform: rotate(0deg);
        transition: opacity 0.45s ease;
        animation: glowOrbit 6s linear infinite;
        z-index: 0;
    }

    .course-card::after {
        content: "";
        position: absolute;
        inset: 1px;
        border-radius: calc(1.8rem - 1px);
        background: rgba(15, 23, 42, 0.72);
        border: 1px solid rgba(148, 163, 184, 0.22);
        box-shadow: 0 28px 55px rgba(8, 11, 25, 0.45);
        z-index: 1;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .course-card:hover {
        transform: translateY(-14px) scale(1.01);
    }

    .course-card:hover::before {
        opacity: 1;
    }

    .course-card:hover::after {
        background: rgba(15, 23, 42, 0.82);
        border-color: rgba(165, 180, 252, 0.38);
        box-shadow: 0 38px 80px rgba(8, 11, 25, 0.55);
    }

    .course-card > * {
        position: relative;
        z-index: 2;
    }

    .course-visual {
        position: relative;
        border-radius: 1.4rem;
        overflow: hidden;
        height: 190px;
        margin-bottom: 1.4rem;
        background-size: cover;
        background-position: center;
        animation: floatFrame 12s ease-in-out infinite;
    }

    .course-visual::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 20%, rgba(224, 231, 255, 0.4), transparent 55%), radial-gradient(circle at 80% 30%, rgba(125, 211, 252, 0.38), transparent 60%);
        opacity: 0.65;
        mix-blend-mode: screen;
        animation: shimmer 9s ease-in-out infinite;
    }

    .course-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.85) 100%);
    }

    .course-card:hover .course-visual {
        animation-play-state: paused;
    }

    .course-card:hover .course-visual::before {
        opacity: 0.85;
    }

    .courses-grid .col-md-6:nth-child(2) .course-visual {
        animation-delay: 1.4s;
    }

    .courses-grid .col-md-6:nth-child(3) .course-visual {
        animation-delay: 2.1s;
    }

    .courses-grid .col-md-6:nth-child(4) .course-visual {
        animation-delay: 2.8s;
    }

    .course-visual span {
        position: absolute;
        bottom: 1.15rem;
        left: 1.2rem;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        color: #e0f2fe;
    }

    .course-card h5 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
    }

    .course-card p {
        color: rgba(226, 232, 240, 0.8);
        margin-bottom: 1.2rem;
    }

    .course-meta {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.92rem;
        color: rgba(203, 213, 225, 0.9);
    }

    .course-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: rgba(30, 64, 175, 0.25);
        border: 1px solid rgba(96, 165, 250, 0.25);
    }

    .course-card .btn {
        margin-top: 1.55rem;
        border-radius: 999px;
        padding: 0.68rem 1.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.98), rgba(56, 189, 248, 0.96));
        border: none;
        color: #0b1120;
        box-shadow: 0 18px 35px rgba(14, 165, 233, 0.35);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .course-card .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 24px 45px rgba(56, 189, 248, 0.42);
    }

    @@keyframes glowOrbit {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes floatFrame {
        0%,
        100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(-8px) scale(1.02);
        }
    }

    @@keyframes shimmer {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.65;
        }

        50% {
            transform: scale(1.05);
            opacity: 0.85;
        }
    }

    @@keyframes cardEntry {
        0% {
            opacity: 0;
            transform: translateY(35px) scale(0.97);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .course-visual.ai-python {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.core-java {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.react {
        background-image: url("data:image/svg+xml;base64,");
    }

    .course-visual.csharp {
        background-image: url("data:image/svg+xml;base64,");
    }

    @@media (max-width: 991.98px) {
        .courses-page {
            padding-top: 6rem;
        }

        .courses-intro {
            margin-bottom: 2.6rem;
            padding: 0 1.2rem;
        }
    }

    @@media (max-width: 575.98px) {
        .courses-page {
            padding-top: 5.5rem;
        }

        .course-card {
            padding: 1.4rem;
        }

    .course-row:hover .course-link {
        background: rgba(129, 140, 248, 0.15);
        color: #c7d2fe;
    }

    @@media (max-width: 575.98px) {
        .course-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.6rem;
        }
    }
</style>

<div class="courses-page">
    <span class="ai-light one"></span>
    <span class="ai-light two"></span>

    <div class="container">
        <div class="courses-intro">
            <span class="eyebrow">Course Catalog</span>
            <h1>Explore immersive tracks crafted for modern technologists</h1>
            <p>Choose a discipline to sharpen your craft through real-world scenarios, guided builds, and AI-infused workflows.</p>
        </div>

        <div class="row g-4 courses-grid">
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual ai-python">
                        <span>AI Projects</span>
                    </div>
                    <h5>Gen AI with Python</h5>
                    <p>Build intelligent solutions using Python, machine learning, and generative AI toolchains that scale from prototypes to production.</p>
                    <div class="course-meta">
                        <span>Intermediate</span>
                        <span>12 modules</span>
                    </div>
                    <a href="https://www.python.org" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual core-java">
                        <span>Enterprise Track</span>
                    </div>
                    <h5>Core Java</h5>
                    <p>Master the fundamentals of Java programming with best practices for building stable, enterprise-ready services and microservices.</p>
                    <div class="course-meta">
                        <span>Beginner friendly</span>
                        <span>15 modules</span>
                    </div>
                    <a href="https://www.oracle.com/java/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual react">
                        <span>UI Mastery</span>
                    </div>
                    <h5>React</h5>
                    <p>Learn to build fast, modern web interfaces using React, TypeScript, and component-driven workflows that delight end users.</p>
                    <div class="course-meta">
                        <span>Intermediate</span>
                        <span>10 modules</span>
                    </div>
                    <a href="https://react.dev/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="course-card h-100">
                    <div class="course-visual csharp">
                        <span>Cloud Ready</span>
                    </div>
                    <h5>C#.NET</h5>
                    <p>Develop robust applications on the .NET platform with modern C# patterns, clean architecture techniques, and DevOps integration.</p>
                    <div class="course-meta">
                        <span>Advanced</span>
                        <span>14 modules</span>
                    </div>
                    <a href="https://dotnet.microsoft.com/" target="_blank" rel="noopener" class="btn">View details</a>
                </div>
            </div>
        </div>
    </div>
</div>
