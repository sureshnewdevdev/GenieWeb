@{ 
    ViewData["Title"] = "Courses";
    ViewData["ActiveMenu"] = "Courses";

    var courses = new[]
    {
        new
        {
            Title = "Azure AI Fundamentals (AI-900)",
            Tagline = "Azure AI",
            Description = "Fundamentals of Azure AI services, responsible AI concepts, and machine learning basics to prepare for the AI-900 certification.",
            Level = "Beginner",
            Modules = "9 modules",
            Fee = "₹4,999/-",
            VisualClass = "ai-azure",
            SyllabusFile = "AI900Course",
            ImageUrl = Url.Content("~/css/Images/Logos/azure-ai.svg"),
            Anchor = "azure-ai"
        },
        new
        {
            Title = "GenAI with Python",
            Tagline = "Generative AI",
            Description = "Hands-on generative AI patterns with Python, including LLM prompt engineering, vector search, and deployment practices.",
            Level = "Intermediate",
            Modules = "12 modules",
            Fee = "₹4,999/-",
            VisualClass = "genai-python",
            SyllabusFile = "GenAISyllabusv1_new",
            ImageUrl = Url.Content("~/css/Images/Logos/genai.svg"),
            Anchor = "genai-python"
        },
        new
        {
            Title = "AWS Training Syllabus",
            Tagline = "Cloud Foundations",
            Description = "AWS compute, storage, networking, security, and serverless foundations aligned to real-world cloud implementations.",
            Level = "Beginner friendly",
            Modules = "10 modules",
            Fee = "₹4,999/-",
            VisualClass = "aws-cloud",
            SyllabusFile = "AWS_syllabus",
            ImageUrl = Url.Content("~/css/Images/Logos/aws.svg"),
            Anchor = "aws-cloud"
        },
        new
        {
            Title = "Informatica PowerCenter Training",
            Tagline = "Data Integration",
            Description = "ETL development, workflows, and administration with Informatica PowerCenter for enterprise data pipelines.",
            Level = "Intermediate",
            Modules = "11 modules",
            Fee = "₹4,999/-",
            VisualClass = "informatica",
            SyllabusFile = "InformaticaSyllabus",
            ImageUrl = Url.Content("~/css/Images/Logos/informatica.svg"),
            Anchor = "informatica"
        },
        new
        {
            Title = "Python & PySpark Training",
            Tagline = "Data Engineering",
            Description = "Python programming essentials plus PySpark and big data processing techniques for analytics workloads.",
            Level = "Intermediate",
            Modules = "14 modules",
            Fee = "₹4,999/-",
            VisualClass = "python-pyspark",
            SyllabusFile = "PythonSparkSyllabus",
            ImageUrl = Url.Content("~/css/Images/Logos/python-pyspark.svg"),
            Anchor = "python-pyspark"
        }
    };
}

<style>
    .courses-page {
        position: relative;
        padding: 8rem 0 5rem;
        background-color: #020617;
        background-image: url("data:image/svg+xml;base64,");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #f8fafc;
        overflow: hidden;
    }

    .courses-page::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(30, 41, 59, 0.72));
        backdrop-filter: blur(2px);
        z-index: 0;
    }

    .courses-page .container {
        position: relative;
        z-index: 2;
    }

    .ai-light {
        position: absolute;
        border-radius: 999px;
        filter: blur(60px);
        opacity: 0.45;
        z-index: 1;
    }

    .ai-light.one {
        width: 320px;
        height: 320px;
        top: 10%;
        left: 5%;
        background: rgba(99, 102, 241, 0.75);
    }

    .ai-light.two {
        width: 360px;
        height: 360px;
        bottom: 12%;
        right: 8%;
        background: rgba(56, 189, 248, 0.7);
    }

    .courses-intro {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 2.5rem;
    }

    .courses-intro .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.4rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.85), rgba(129, 140, 248, 0.95));
        border: 1px solid rgba(148, 163, 184, 0.35);
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #f8fafc;
        box-shadow: 0 22px 45px rgba(30, 64, 175, 0.35);
    }

    .courses-intro h1 {
        margin-top: 1.7rem;
        font-weight: 700;
        font-size: clamp(2.35rem, 4.6vw, 3.4rem);
        line-height: 1.08;
    }

    .courses-intro p {
        margin: 1.1rem auto 0;
        color: rgba(226, 232, 240, 0.84);
        font-size: 1.05rem;
        max-width: 620px;
    }

    .courses-grid {
        margin-top: 3rem;
    }

    .course-card {
        position: relative;
        height: 100%;
        border-radius: 1.8rem;
        padding: 1.8rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        isolation: isolate;
        backdrop-filter: blur(18px);
        transition: transform 0.5s ease, box-shadow 0.5s ease;
        animation: cardEntry 0.85s ease both;
    }

    .courses-grid .col-md-6:nth-child(1) .course-card { animation-delay: 0.1s; }
    .courses-grid .col-md-6:nth-child(2) .course-card { animation-delay: 0.25s; }
    .courses-grid .col-md-6:nth-child(3) .course-card { animation-delay: 0.4s; }
    .courses-grid .col-md-6:nth-child(4) .course-card { animation-delay: 0.55s; }
    .courses-grid .col-md-6:nth-child(5) .course-card { animation-delay: 0.7s; }

    .course-card::before {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: inherit;
        background: conic-gradient(from 180deg, rgba(56, 189, 248, 0.8), rgba(129, 140, 248, 0.95), rgba(59, 130, 246, 0.9), rgba(56, 189, 248, 0.8));
        opacity: 0;
        transform: rotate(0deg);
        transition: opacity 0.45s ease;
        animation: glowOrbit 6s linear infinite;
        z-index: 0;
    }

    .course-card::after {
        content: "";
        position: absolute;
        inset: 1px;
        border-radius: calc(1.8rem - 1px);
        background: rgba(15, 23, 42, 0.72);
        border: 1px solid rgba(148, 163, 184, 0.22);
        box-shadow: 0 28px 55px rgba(8, 11, 25, 0.45);
        z-index: 1;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .course-card:hover {
        transform: translateY(-14px) scale(1.01);
    }

    .course-card:hover::before {
        opacity: 1;
    }

    .course-card:hover::after {
        background: rgba(15, 23, 42, 0.82);
        border-color: rgba(165, 180, 252, 0.38);
        box-shadow: 0 38px 80px rgba(8, 11, 25, 0.55);
    }

    .course-card > * {
        position: relative;
        z-index: 2;
    }

    .course-visual {
        position: relative;
        border-radius: 1.4rem;
        overflow: hidden;
        height: 190px;
        margin-bottom: 1.4rem;
        background-size: cover;
        background-position: center;
        animation: floatFrame 12s ease-in-out infinite;
        display: grid;
        place-items: center;
    }

    .course-visual::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 20%, rgba(224, 231, 255, 0.4), transparent 55%), radial-gradient(circle at 80% 30%, rgba(125, 211, 252, 0.38), transparent 60%);
        opacity: 0.65;
        mix-blend-mode: screen;
        animation: shimmer 9s ease-in-out infinite;
    }

    .course-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.85) 100%);
    }

    .course-visual img {
        position: relative;
        z-index: 2;
        width: 96px;
        height: 96px;
        object-fit: contain;
        filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.3));
        transition: transform 0.3s ease;
    }

    .course-card:hover .course-visual {
        animation-play-state: paused;
    }

    .course-card:hover .course-visual::before {
        opacity: 0.85;
    }

    .course-card:hover .course-visual img {
        transform: scale(1.05);
    }

    .courses-grid .col-md-6:nth-child(2) .course-visual {
        animation-delay: 1.4s;
    }

    .courses-grid .col-md-6:nth-child(3) .course-visual {
        animation-delay: 2.1s;
    }

    .courses-grid .col-md-6:nth-child(4) .course-visual {
        animation-delay: 2.8s;
    }

    .course-visual span {
        position: absolute;
        bottom: 1.15rem;
        left: 1.2rem;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        color: #e0f2fe;
    }

    .course-card h5 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
    }

    .course-card p {
        color: rgba(226, 232, 240, 0.8);
        margin-bottom: 1.2rem;
    }

    .course-meta {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.92rem;
        color: rgba(203, 213, 225, 0.9);
    }

    .course-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: rgba(30, 64, 175, 0.25);
        border: 1px solid rgba(96, 165, 250, 0.25);
    }

    .course-fee {
        margin: 0.85rem 0 0.5rem;
        padding: 0.85rem 1rem;
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(129, 140, 248, 0.12));
        border: 1px solid rgba(148, 163, 184, 0.25);
        font-weight: 700;
        color: #e0f2fe;
        display: inline-block;
    }

    .course-card .btn {
        margin-top: 1.55rem;
        border-radius: 999px;
        padding: 0.68rem 1.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.98), rgba(56, 189, 248, 0.96));
        border: none;
        color: #0b1120;
        box-shadow: 0 18px 35px rgba(14, 165, 233, 0.35);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .course-card .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 24px 45px rgba(56, 189, 248, 0.42);
    }

    .course-marquee {
        margin: 0 auto 2.2rem;
        overflow: hidden;
        border-radius: 1rem;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: rgba(15, 23, 42, 0.35);
        padding: 0.85rem 0;
        position: relative;
    }

    .marquee-track {
        display: inline-flex;
        gap: 1.5rem;
        align-items: center;
        animation: marqueeSlide 24s linear infinite;
    }

    .course-marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.55rem 1rem;
        background: rgba(15, 23, 42, 0.55);
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: #e2e8f0;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        flex-shrink: 0;
    }

    .marquee-item img {
        width: 52px;
        height: 52px;
        object-fit: contain;
    }

    .marquee-item span {
        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;
    }

    .marquee-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 35px rgba(56, 189, 248, 0.25);
    }

    @@keyframes glowOrbit {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes floatFrame {
        0%,
        100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(-8px) scale(1.02);
        }
    }

    @@keyframes shimmer {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.65;
        }

        50% {
            transform: scale(1.05);
            opacity: 0.85;
        }
    }

    @@keyframes cardEntry {
        0% {
            opacity: 0;
            transform: translateY(35px) scale(0.97);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes marqueeSlide {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    .course-visual.ai-azure {
        background-image: linear-gradient(135deg, #0ea5e9, #38bdf8);
    }

    .course-visual.genai-python {
        background-image: linear-gradient(135deg, #a855f7, #6366f1);
    }

    .course-visual.aws-cloud {
        background-image: linear-gradient(135deg, #f97316, #f59e0b);
    }

    .course-visual.informatica {
        background-image: linear-gradient(135deg, #14b8a6, #0d9488);
    }

    .course-visual.python-pyspark {
        background-image: linear-gradient(135deg, #ef4444, #f59e0b);
    }

    @@media (max-width: 991.98px) {
        .courses-page {
            padding-top: 6rem;
        }

        .courses-intro {
            margin-bottom: 2.6rem;
            padding: 0 1.2rem;
        }
    }

    @@media (max-width: 575.98px) {
        .courses-page {
            padding-top: 5.5rem;
        }

        .course-card {
            padding: 1.4rem;
        }

    .course-row:hover .course-link {
        background: rgba(129, 140, 248, 0.15);
        color: #c7d2fe;
    }

    @@media (max-width: 575.98px) {
        .course-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.6rem;
        }
    }
</style>

<div class="courses-page">
    <span class="ai-light one"></span>
    <span class="ai-light two"></span>

        <div class="container">
            <div class="courses-intro">
                <span class="eyebrow">Course Catalog</span>
            </div>

            <div class="course-marquee">
                <div class="marquee-track">
                    @foreach (var course in courses)
                    {
                        <a href="#course-@course.Anchor" class="marquee-item">
                            <img src="@course.ImageUrl" alt="@course.Title image" />
                            <span>@course.Title</span>
                        </a>
                    }
                    @foreach (var course in courses)
                    {
                        <a href="#course-@course.Anchor" class="marquee-item">
                            <img src="@course.ImageUrl" alt="@course.Title image" />
                            <span>@course.Title</span>
                        </a>
                    }
                </div>
            </div>

            <div class="row g-4 courses-grid">
            @foreach (var course in courses)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="course-card h-100" id="course-@course.Anchor">
                        <div class="course-visual @course.VisualClass">
                            <img src="@course.ImageUrl" alt="@course.Title image" />
                            <span>@course.Tagline</span>
                        </div>
                        <h5>@course.Title</h5>
                        <p>@course.Description</p>
                        <div class="course-meta">
                            <span>@course.Level</span>
                            <span>@course.Modules</span>
                        </div>
                        <div class="course-fee">Fee: @course.Fee</div>
                        <a href='@Url.Action("Syllabus", "Courses", new { fileName = course.SyllabusFile })' target="_blank" rel="noopener" class="btn">View syllabus</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
