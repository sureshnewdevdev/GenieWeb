@{
    ViewData["Title"] = "Courses";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold">Explore Our Courses</h1>
            <p class="lead text-muted">Find the right course to boost your tech career.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Gen AI with Python</h5>
                    <p class="card-text flex-grow-1">Build intelligent solutions using Python, machine learning, and GenAI tools.</p>
                    <a href="https://www.python.org" target="_blank" rel="noopener" class="btn btn-primary mt-3">View details</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Core Java</h5>
                    <p class="card-text flex-grow-1">Master the fundamentals of Java programming for enterprise-grade solutions.</p>
                    <a href="https://www.oracle.com/java/" target="_blank" rel="noopener" class="btn btn-primary mt-3">View details</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">React</h5>
                    <p class="card-text flex-grow-1">Learn to build fast, modern web interfaces using React and TypeScript.</p>
                    <a href="https://react.dev/" target="_blank" rel="noopener" class="btn btn-primary mt-3">View details</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">C#.NET</h5>
                    <p class="card-text flex-grow-1">Develop robust applications on the .NET platform with modern C# patterns.</p>
                    <a href="https://dotnet.microsoft.com/" target="_blank" rel="noopener" class="btn btn-primary mt-3">View details</a>
                </div>
            </div>
        </div>
    </div>
</div>
