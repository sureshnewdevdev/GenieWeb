@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Azure AI Fundamentals (AI-900) - Course Syllabus";
    ViewData["ActiveMenu"] = "Courses";
    ViewData["HideSidebar"] = true;
}
<div class="syllabus-page">
<style>

        :root {
            --primary: #0078d4;
            --primary-dark: #106ebe;
            --secondary: #2b88d8;
            --light: #f3f2f1;
            --dark: #323130;
            --accent: #ffb900;
            --success: #107c10;
            --danger: #d13438;
            --shadow: 0 4px 8px rgba(0,0,0,0.1);
            --radius: 6px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f5f5f5;
            color: var(--dark);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 40px 20px;
            text-align: center;
            border-radius: var(--radius);
            margin-bottom: 30px;
            box-shadow: var(--shadow);
        }
        
        header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }
        
        header p {
            font-size: 1.2rem;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .course-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            margin-bottom: 30px;
            box-shadow: var(--shadow);
        }
        
        .info-card {
            flex: 1;
            min-width: 200px;
            padding: 15px;
            margin: 10px;
            background-color: var(--light);
            border-radius: var(--radius);
            text-align: center;
        }
        
        .info-card h3 {
            color: var(--primary);
            margin-bottom: 10px;
        }
        
        .week-container {
            margin-bottom: 40px;
        }
        
        .week-header {
            background-color: var(--primary);
            color: white;
            padding: 15px 20px;
            border-radius: var(--radius) var(--radius) 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }
        
        .week-header h2 {
            font-size: 1.5rem;
        }
        
        .week-content {
            background-color: white;
            border-radius: 0 0 var(--radius) var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            display: none;
        }
        
        .module {
            border-bottom: 1px solid #e1e1e1;
            padding: 20px;
        }
        
        .module:last-child {
            border-bottom: none;
        }
        
        .module-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .module-title {
            font-size: 1.3rem;
            color: var(--primary);
        }
        
        .module-duration {
            background-color: var(--light);
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        
        .learning-objectives {
            background-color: #e8f4fd;
            padding: 15px;
            border-radius: var(--radius);
            margin-bottom: 15px;
        }
        
        .learning-objectives h4 {
            color: var(--primary-dark);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .learning-objectives ul {
            padding-left: 20px;
        }
        
        .learning-objectives li {
            margin-bottom: 8px;
        }
        
        .resources {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }
        
        .resource-btn {
            background-color: var(--light);
            border: 1px solid #d1d1d1;
            padding: 8px 15px;
            border-radius: var(--radius);
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9rem;
        }
        
        .resource-btn:hover {
            background-color: var(--primary);
            color: white;
        }
        
        .mcq-preview, .interview-preview {
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: var(--radius);
            margin-top: 15px;
            display: none;
        }
        
        .mcq-preview h4, .interview-preview h4 {
            color: var(--primary-dark);
            margin-bottom: 10px;
        }
        
        .question {
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px dashed #ccc;
        }
        
        .question:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        
        .options {
            margin-top: 10px;
            padding-left: 20px;
        }
        
        .option {
            margin-bottom: 5px;
        }
        
        .correct {
            color: var(--success);
            font-weight: bold;
        }
        
        .interview-answer {
            margin-top: 10px;
            padding: 10px;
            background-color: #e8f4fd;
            border-radius: var(--radius);
            font-size: 0.95rem;
        }
        
        footer {
            text-align: center;
            padding: 20px;
            margin-top: 40px;
            color: #666;
            font-size: 0.9rem;
        }
        
        .expand-icon {
            transition: transform 0.3s;
        }
        
        .expanded .expand-icon {
            transform: rotate(180deg);
        }
        
        @@media (max-width: 768px) {
            .course-info {
                flex-direction: column;
            }
            
            .info-card {
                min-width: 100%;
            }
            
            .module-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .module-duration {
                margin-top: 10px;
            }
        }
    
</style>

    <div class="container">
