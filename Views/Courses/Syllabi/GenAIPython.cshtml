@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Generative AI with Python – Course Syllabus";
    ViewData["ActiveMenu"] = "Courses";
    ViewData["HideSidebar"] = true;
}
<div class="syllabus-page">
<style>

        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #3b82f6;
            --secondary: #7c3aed;
            --accent: #ec4899;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --light: #f8fafc;
            --dark: #1e293b;
            --gray: #64748b;
            --gray-light: #e2e8f0;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --radius: 8px;
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            color: var(--dark);
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 40px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Header Styles */
        header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 50px 20px;
            text-align: center;
            border-radius: var(--radius);
            margin-bottom: 40px;
            box-shadow: var(--shadow-lg);
            position: relative;
            overflow: hidden;
        }
        
        header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0,0 L100,0 L100,100 Z" fill="rgba(255,255,255,0.1)"/></svg>');
            background-size: cover;
        }
        
        header h1 {
            font-size: 2.8rem;
            margin-bottom: 15px;
            position: relative;
            font-weight: 700;
        }
        
        .course-subtitle {
            font-size: 1.3rem;
            max-width: 800px;
            margin: 0 auto 20px;
            position: relative;
            opacity: 0.9;
        }
        
        .course-duration {
            background: rgba(255, 255, 255, 0.2);
            display: inline-block;
            padding: 10px 25px;
            border-radius: 30px;
            margin-bottom: 20px;
            font-size: 1.1rem;
            position: relative;
            font-weight: 600;
        }
        
        .powered-by {
            position: relative;
            font-size: 1rem;
            background: rgba(255, 255, 255, 0.2);
            display: inline-block;
            padding: 8px 20px;
            border-radius: 30px;
            margin-top: 15px;
        }
        
        /* Course Features */
        .course-features {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 40px;
            justify-content: center;
        }
        
        .feature-badge {
            background: white;
            padding: 12px 20px;
            border-radius: 30px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: var(--primary);
            transition: var(--transition);
        }
        
        .feature-badge:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }
        
        .feature-badge i {
            color: var(--accent);
        }
        
        /* Quick Navigation */
        .quick-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 30px;
            justify-content: center;
        }
        
        .nav-btn {
            background: white;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: var(--transition);
            font-weight: 600;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .nav-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Course Overview */
        .course-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 50px;
        }
        
        .overview-card {
            background: white;
            padding: 30px 25px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            text-align: center;
            transition: var(--transition);
            border-top: 4px solid var(--primary);
        }
        
        .overview-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }
        
        .overview-card i {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 20px;
        }
        
        .overview-card h3 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 1.3rem;
        }
        
        .overview-card p {
            color: var(--gray);
            font-size: 0.95rem;
        }
        
        /* MCQ Link */
        .mcq-link {
            display: block;
            background: linear-gradient(135deg, var(--success), #059669);
            color: white;
            text-align: center;
            padding: 18px;
            border-radius: var(--radius);
            margin: 30px 0;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.1rem;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        
        .mcq-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
        }
        
        .mcq-link i {
            margin-right: 10px;
        }
        
        /* Part Sections */
        .part-section {
            margin-bottom: 50px;
        }
        
        .part-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 2px solid var(--gray-light);
        }
        
        .part-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }
        
        .part-1 .part-icon { background: var(--primary); }
        .part-2 .part-icon { background: var(--success); }
        .part-3 .part-icon { background: var(--danger); }
        .part-4 .part-icon { background: var(--warning); }
        .part-5 .part-icon { background: var(--secondary); }
        
        .part-title {
            font-size: 1.8rem;
            color: var(--dark);
            font-weight: 700;
        }
        
        /* Module Styles */
        .modules-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }
        
        .module-card {
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: var(--transition);
        }
        
        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }
        
        .module-header {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
            color: white;
            padding: 20px;
        }
        
        .module-number {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 5px;
        }
        
        .module-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .module-duration {
            font-size: 0.85rem;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .module-content {
            padding: 20px;
        }
        
        .topics-list {
            margin-bottom: 20px;
        }
        
        .topics-list h4 {
            color: var(--primary);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
        }
        
        .topics-list ul {
            list-style-type: none;
        }
        
        .topics-list li {
            padding: 8px 0;
            border-bottom: 1px dashed var(--gray-light);
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 0.95rem;
        }
        
        .topics-list li:before {
            content: "▸";
            color: var(--accent);
            font-weight: bold;
            flex-shrink: 0;
            margin-top: 2px;
        }
        
        .module-resources {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 20px;
        }
        
        .resource-tag {
            background: var(--light);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        /* Assessment Section */
        .assessment-section {
            background: white;
            border-radius: var(--radius);
            padding: 30px;
            box-shadow: var(--shadow);
            margin: 40px 0;
        }
        
        .assessment-title {
            text-align: center;
            margin-bottom: 30px;
            color: var(--primary);
            font-size: 1.8rem;
        }
        
        .assessment-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        
        .assessment-card {
            background: var(--light);
            padding: 25px;
            border-radius: var(--radius);
            text-align: center;
            border-left: 4px solid var(--primary);
        }
        
        .assessment-card h4 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 1.2rem;
        }
        
        .assessment-card p {
            color: var(--gray);
            font-size: 0.95rem;
        }
        
        /* Footer */
        footer {
            text-align: center;
            padding: 40px 20px;
            margin-top: 60px;
            color: var(--gray);
            font-size: 0.9rem;
            border-top: 1px solid var(--gray-light);
        }
        
        .footer-logo {
            font-weight: bold;
            color: var(--primary);
        }
        
        .footer-highlight {
            margin-top: 15px;
            font-weight: 600;
            color: var(--dark);
        }
        
        /* Responsive Design */
        @@media (max-width: 768px) {
            .modules-container {
                grid-template-columns: 1fr;
            }
            
            .course-overview {
                grid-template-columns: 1fr;
            }
            
            .quick-nav {
                flex-direction: column;
                align-items: center;
            }
            
            .nav-btn {
                width: 100%;
                justify-content: center;
            }
            
            header h1 {
                font-size: 2.2rem;
            }
            
            .part-header {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
        }
    
</style>

    <div class="container">
        <header>
            <h1>GenAI with Python</h1>
            <div class="course-subtitle">Complete Professional Course Syllabus</div>
            <div class="course-duration">
                <i class="fas fa-clock"></i> Total Duration: 60 Hours
            </div>
            
            <div class="course-features">
                <div class="feature-badge">
                    <i class="fas fa-video"></i> Recorded Sessions
                </div>
                <div class="feature-badge">
                    <i class="fas fa-file-alt"></i> MCQ Tests
                </div>
                <div class="feature-badge">
                    <i class="fas fa-comments"></i> Interview Q&A
                </div>
                <div class="feature-badge">
                    <i class="fas fa-code"></i> Practical Code Sharing
                </div>
                <div class="feature-badge">
                    <i class="fas fa-project-diagram"></i> Use Case Development
                </div>
            </div>
            
            <div class="powered-by">Powered by ittechgenie.com</div>
        </header>
        
        <div class="quick-nav">
            <button class="nav-btn" onclick="scrollToPart('part1')">
                <i class="fas fa-code"></i> Python Foundation
            </button>
            <button class="nav-btn" onclick="scrollToPart('part2')">
                <i class="fas fa-brain"></i> AI Fundamentals
            </button>
            <button class="nav-btn" onclick="scrollToPart('part3')">
                <i class="fas fa-database"></i> Vector Databases
            </button>
            <button class="nav-btn" onclick="scrollToPart('part4')">
                <i class="fas fa-link"></i> RAG & LangChain
            </button>
            <button class="nav-btn" onclick="scrollToPart('part5')">
                <i class="fas fa-graduation-cap"></i> Capstone Projects
            </button>
        </div>
        
        <a href="https://ittechgenie.com/TopicSelection" class="mcq-link" target="_blank">
            <i class="fas fa-external-link-alt"></i> Access All MCQ Tests at https://ittechgenie.com/TopicSelection
        </a>
        
        <div class="course-overview">
            <div class="overview-card">
                <i class="fas fa-laptop-code"></i>
                <h3>Python Foundation</h3>
                <p>Comprehensive Python programming, data structures, OOP, and development methodologies</p>
            </div>
            <div class="overview-card">
                <i class="fas fa-brain"></i>
                <h3>Generative AI</h3>
                <p>Deep dive into LLMs, prompt engineering, vector databases, and AI application development</p>
            </div>
            <div class="overview-card">
                <i class="fas fa-database"></i>
                <h3>Vector Databases</h3>
                <p>Hands-on with Chroma DB, FAISS, Pinecone, and semantic search implementation</p>
            </div>
            <div class="overview-card">
                <i class="fas fa-tasks"></i>
                <h3>Assessment</h3>
                <p>MCQs and Interview Questions provided for each module to test your understanding</p>
            </div>
        </div>

        <!-- Part 1: Python Foundations -->
        <section id="part1" class="part-section part-1">
            <div class="part-header">
                <div class="part-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h2 class="part-title">Part 1: Python Foundations</h2>
            </div>
            
            <div class="modules-container">
                <!-- Module 1 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 1</div>
                        <h3 class="module-title">Python Orientation & Development Practices</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 4 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Evolution of Python and its ecosystem</li>
                                <li>Interpreter vs Compiler</li>
                                <li>REPL, Jupyter Notebook, and IDE workflow</li>
                                <li>SDLC models: Waterfall, Agile</li>
                                <li>Agile concepts: Scrum roles, ceremonies, sprints</li>
                                <li>Story pointing & backlog overview</li>
                                <li>Git overview and repository management</li>
                                <li>Branching, merging, conflict handling</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (10)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (5)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                        </div>
                    </div>
                </div>
                
                <!-- Module 2 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 2</div>
                        <h3 class="module-title">Core Python Programming</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 5 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Python syntax and indentation</li>
                                <li>Writing & executing Python scripts</li>
                                <li>Variables and memory model</li>
                                <li>Data types: Numeric, String, List, Tuple</li>
                                <li>Sets, Dictionaries, Boolean, Binary, None</li>
                                <li>User input and formatting output</li>
                                <li>Namespaces and scopes</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (15)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (6)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                        </div>
                    </div>
                </div>
                
                <!-- Additional modules would follow the same pattern -->
                <!-- Module 3 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 3</div>
                        <h3 class="module-title">Program Flow & Data Handling</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 6 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Conditional statements</li>
                                <li>for/while loops</li>
                                <li>Iteration patterns</li>
                                <li>Range operations</li>
                                <li>Working with collections</li>
                                <li>Manipulating lists, sets, dictionaries</li>
                                <li>Type casting and comparisons</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (12)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (5)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                        </div>
                    </div>
                </div>
                
                <!-- Module 4 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 4</div>
                        <h3 class="module-title">Functions & Object-Oriented Programming</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 8 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Defining functions</li>
                                <li>Lambda expressions</li>
                                <li>Higher-order functions</li>
                                <li>Modules and imports</li>
                                <li>Working with arrays</li>
                                <li>OOP concepts: Classes, Inheritance, Polymorphism</li>
                                <li>Iterators & generators</li>
                                <li>Date & time operations</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (15)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (7)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                        </div>
                    </div>
                </div>
                
                <!-- Module 5 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 5</div>
                        <h3 class="module-title">Advanced Python Utilities & Testing</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 10 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Exception handling: try/except, custom exceptions</li>
                                <li>Logging in applications</li>
                                <li>Regular expressions</li>
                                <li>JSON & data parsing</li>
                                <li>Python Packaging (pip, __init__.py)</li>
                                <li>Introduction to data analysis libraries: NumPy, Pandas, Matplotlib</li>
                                <li>Collections module: Counter, NamedTuple, OrderedDict</li>
                                <li>Unit Testing with Pytest</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (20)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (8)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                            <span class="resource-tag"><i class="fas fa-project-diagram"></i> Use Case: Data Analysis App</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Part 2: Foundations of AI & Generative AI -->
        <section id="part2" class="part-section part-2">
            <div class="part-header">
                <div class="part-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <h2 class="part-title">Part 2: Foundations of AI & Generative AI</h2>
            </div>
            
            <div class="modules-container">
                <!-- Module 6 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 6</div>
                        <h3 class="module-title">Introduction to Artificial Intelligence</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 6 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>What is AI? AI vs ML vs DL comparison</li>
                                <li>Evolution of generative systems</li>
                                <li>Applications of AI in industries</li>
                                <li>Introduction to Large Language Models (LLMs)</li>
                                <li>Popular LLM families: GPT, Claude 3, Gemini, Llama, Mistral</li>
                                <li>Open-source ecosystems</li>
                                <li>On-device AI and tools like Ollama</li>
                                <li>Responsible AI & Ethical considerations</li>
                                <li>LLM safety and security practices</li>
                            </ul>
                        </div>
                        <div class="module-resources">
                            <span class="resource-tag"><i class="fas fa-question-circle"></i> MCQs (15)</span>
                            <span class="resource-tag"><i class="fas fa-comments"></i> Interview Qs (6)</span>
                            <span class="resource-tag"><i class="fas fa-code"></i> Code Examples</span>
                            <span class="resource-tag"><i class="fas fa-project-diagram"></i> Use Case: AI Chatbot</span>
                        </div>
                    </div>
                </div>
                
                <!-- Module 7 -->
                <div class="module-card">
                    <div class="module-header">
                        <div class="module-number">Module 7</div>
                        <h3 class="module-title">Prompt Engineering Essentials</h3>
                        <div class="module-duration">
                            <i class="fas fa-clock"></i> 8 Hours
                        </div>
                    </div>
                    <div class="module-content">
                        <div class="topics-list">
                            <h4><i class="fas fa-list"></i> Topics Covered</h4>
                            <ul>
                                <li>Structure of LLM communication: System, user, assistant roles</li>
                                <li>Zero-shot prompting</li>
                                <li>Few-shot prompting</li>
                                <li>Chain-of-Thought prompting</li>
                                <li>Instruction tuning & guidelines</li>
                                <li>Handling hallucinations</li>
