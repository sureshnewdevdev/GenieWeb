@model GenieWeb.Models.MicroservicesPageViewModel
@{
    Layout = "~/Views/Shared/Masterv1.cshtml";
}

<style>
    .ms-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 22px;
        align-items: start;
    }

    .ms-sidebar {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
        background: #f8fafc;
        max-height: 75vh;
        overflow: auto;
    }

    .ms-sidebar h3 {
        font-size: 1rem;
        margin-top: 0;
    }

    .ms-section {
        margin-bottom: 12px;
    }

    .ms-section-title {
        font-weight: 700;
        color: #0f172a;
        display: block;
        margin-bottom: 4px;
    }

    .ms-topic-list {
        list-style: none;
        margin: 0;
        padding-left: 10px;
    }

    .ms-topic-list li {
        margin-bottom: 3px;
    }

    .ms-topic-link,
    .ms-section-link {
        color: #334155;
        text-decoration: none;
        font-size: 0.92rem;
    }

    .ms-topic-link.active,
    .ms-section-link.active {
        color: #047857;
        font-weight: 700;
    }

    .ms-main h2 {
        margin-top: 0;
        color: #065f46;
    }

    .badge-chip {
        display: inline-block;
        background: #ecfeff;
        border: 1px solid #99f6e4;
        color: #115e59;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.8rem;
        margin-bottom: 8px;
    }

    @@media (max-width: 992px) {
        .ms-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ms-layout">
    <aside class="ms-sidebar">
        <h3>Microservices Syllabus Navigation</h3>
        @foreach (var section in Model.Sections)
        {
            <div class="ms-section">
                <a class="ms-section-link @(Model.ActiveSection?.Slug == section.Slug ? "active" : string.Empty)"
                   href="@Url.Action("Section", "Microservices", new { slug = section.Slug })">
                    @@section.Number. @@section.Title
                </a>
                @if (section.Topics.Any())
                {
                    <ul class="ms-topic-list">
                        @foreach (var topic in section.Topics)
                        {
                            <li>
                                <a class="ms-topic-link @(Model.ActiveTopic?.Slug == topic.Slug ? "active" : string.Empty)"
                                   href="@Url.Action("Section", "Microservices", new { slug = section.Slug })#@topic.Slug">
                                    @topic.Number @topic.Title
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </aside>

    <section class="ms-main">
        @if (Model.ActiveSection != null)
        {
            <span class="badge-chip">Section @Model.ActiveSection.Number</span>
        }
        <h2>@Model.PageTitle</h2>

        @if (!string.IsNullOrWhiteSpace(Model.IntroHtml))
        {
            @Html.Raw(Model.IntroHtml)
        }
        else
        {
            <div class="section">
                <h3>Learning Outcomes for @Model.ActiveSection?.Title</h3>
                <p>
                    This section page is ready for topic-wise content. Use the syllabus navigation to add dedicated views for each
                    subtopic as your course grows.
                </p>
                <div class="note-box">
                    <strong>Extend easily:</strong> Create topic-specific actions and render content blocks based on
                    <code>@Model.ActiveSection?.Slug</code> and selected topic slug.
                </div>
            </div>
        }
    </section>
</div>
