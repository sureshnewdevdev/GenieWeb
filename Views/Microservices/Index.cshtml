@model GenieWeb.Models.MicroservicesPageViewModel
@{
    Layout = "~/Views/Shared/MicroservicesMaster.cshtml";
}

<div class="ms-main">
    <span class="badge-chip">Microservices Learning Path</span>
    <h2>@Model.PageTitle</h2>

    @if (!string.IsNullOrWhiteSpace(Model.TopicViewName))
    {
        @await Html.PartialAsync(Model.TopicViewName)
    }
    else if (!string.IsNullOrWhiteSpace(Model.IntroHtml))
    {
        @Html.Raw(Model.IntroHtml)
    }
    else
    {
        <p>Select a topic from the left menu to view section content.</p>
    }
</div>
