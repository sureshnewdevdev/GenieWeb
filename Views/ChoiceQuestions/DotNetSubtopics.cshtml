@{
    ViewData["Title"] = ".NET Core MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "DotNet";
}

<div class="container mt-5">
    <h2 class="text-info mb-4">.NET Core Quiz Topics</h2>
    <p>Select a subtopic below to begin the quiz.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- .NET Core Basics -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">.NET Core Basics</h5>
                        <p class="card-text text-muted">Core concepts, SDK, CLI tools, and architecture.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Middleware -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">Middleware</h5>
                        <p class="card-text text-muted">Request pipeline, custom middleware, use/next logic.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Routing -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Routing</h5>
                        <p class="card-text text-muted">Endpoint routing, attribute routing, route templates.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>
