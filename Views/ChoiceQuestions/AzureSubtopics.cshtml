@{
    ViewData["Title"] = "Azure Storage MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "Azure";
}

<div class="container mt-5">
    <p>Select a quiz from the subtopics below to begin:</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Azure Storage Overview -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Azure Storage Overview</h5>
                        <p class="card-text text-muted">General features, account types, tiers, and replication.</p>
                    </div>
                    <a href="@Url.Action("AzureStorage", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Blob Storage -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">Blob Storage</h5>
                        <p class="card-text text-muted">Blob types, tiers, lifecycle, access control.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Queue Storage -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">Queue Storage</h5>
                        <p class="card-text text-muted">Messages, TTL, poison queues, asynchronous patterns.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- File Storage -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning">File Storage</h5>
                        <p class="card-text text-muted">SMB protocol, mounting, sync, and use cases.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>