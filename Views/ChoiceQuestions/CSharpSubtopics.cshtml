@{
    ViewData["Title"] = "C# Programming MCQs";
    ViewData["ActiveMenu"] = "ChoiceQuestions";
    ViewData["ActiveTopic"] = "CSharp";
}

<div class="container mt-5">
    <h2 class="text-success mb-4">C# Quiz Topics</h2>
    <p>Select a subtopic below to begin the quiz.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- C# Basics -->
        <div class="col">
            <div class="card h-100 border-success shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-success">C# Basics</h5>
                        <p class="card-text text-muted">Variables, data types, operators, control flow.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-success mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Inheritance -->
        <div class="col">
            <div class="card h-100 border-primary shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-primary">Inheritance</h5>
                        <p class="card-text text-muted">OOP inheritance concepts, base/derived classes.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-primary mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Polymorphism -->
        <div class="col">
            <div class="card h-100 border-info shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-info">Polymorphism</h5>
                        <p class="card-text text-muted">Method overriding, overloading, interfaces.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-info mt-3">Start Test</a>
                </div>
            </div>
        </div>

        <!-- Async & Await -->
        <div class="col">
            <div class="card h-100 border-warning shadow rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning">Async & Await</h5>
                        <p class="card-text text-muted">Asynchronous programming, task-based async pattern.</p>
                    </div>
                    <a href="@Url.Action("UnderDevelopment", "ChoiceQuestions")" class="btn btn-outline-warning mt-3">Start Test</a>
                </div>
            </div>
        </div>

    </div>
</div>