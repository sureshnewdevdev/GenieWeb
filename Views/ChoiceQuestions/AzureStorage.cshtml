<script>
        let totalTime = 5 * 60;
    let timerInterval;

    function startTimer() {
        const display = document.getElementById("timerDisplay");
        const box = document.getElementById("quiz-timer-box");

        timerInterval = setInterval(() => {
            const minutes = Math.floor(totalTime / 60);
            const seconds = totalTime % 60;
            display.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

            // Color transitions
            if (totalTime <= 60) {
                box.classList.remove("timer-orange");
                box.classList.add("timer-red");
            } else if (totalTime <= 180) {
                box.classList.remove("timer-red");
                box.classList.add("timer-orange");
            } else {
                box.classList.remove("timer-orange", "timer-red");
            }

            if (totalTime <= 0) {
                clearInterval(timerInterval);
                alert("Time is up! Submitting your quiz...");
                calculateScore();
            }

            totalTime--;
        }, 1000);
    }

    window.onload = startTimer;

    const correctAnswers = [
        "B", "D", "B", "A", "A", "B", "A", "C", "A", "A",
        "B", "D", "B", "B", "C", "A", "B", "A", "B", "A"
    ];

    function calculateScore() {
        clearInterval(timerInterval);
        let score = 0;
        let userAnswers = [];
        let totalQuestions = correctAnswers.length;

        for (let i = 1; i <= totalQuestions; i++) {
            const selectedOption = document.querySelector(`input[name="q${i}"]:checked`);
            if (selectedOption) {
                userAnswers.push(selectedOption.value);
                if (selectedOption.value === correctAnswers[i - 1]) {
                    score += 5; // Each correct answer is worth 5 marks
                }
            } else {
                userAnswers.push("Not Answered");
            }
        }

        document.getElementById("score").innerText = `You scored ${score} out of ${totalQuestions * 5}`;
        const answersList = document.getElementById("answers");
        answersList.innerHTML = "";

        correctAnswers.forEach((answer, index) => {
            const li = document.createElement("li");
            li.innerText = `Question ${index + 1}: Correct Answer - ${answer}, Your Answer - ${userAnswers[index]}`;
            answersList.appendChild(li);
        });

        document.getElementById("result").style.display = "block";
    }
</script>