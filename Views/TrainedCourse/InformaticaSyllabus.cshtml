@{
    ViewData["Title"] = "Informatica PowerCenter Training Syllabus";
    ViewData["ActiveMenu"] = "Courses";
}

<div class="container py-5">
    <div class="syllabus-wrapper informatica-syllabus">
        <style>
        .informatica-syllabus {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #0f172a;
            background: #f8fafc;
            padding: 22px;
            border-radius: 14px;
            box-shadow: 0 18px 32px rgba(0,0,0,0.06);
        }

        .informatica-syllabus header {
            background: linear-gradient(135deg, #0f766e, #14b8a6);
            color: #fff;
            padding: 26px 20px;
            border-radius: 12px;
            margin-bottom: 18px;
            text-align: center;
        }

        .informatica-syllabus h1 {
            margin: 0 0 8px;
            font-size: 2.1rem;
        }

        .informatica-syllabus .subtitle {
            margin: 0;
            color: #e0f2f1;
        }

        .informatica-syllabus .certification-note {
            background: #ecfdf3;
            border: 1px solid #bbf7d0;
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .informatica-syllabus .module {
            background: #fff;
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 14px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.05);
        }

        .informatica-syllabus .module-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .informatica-syllabus .module-title {
            margin: 0;
            font-size: 1.2rem;
            color: #0f766e;
        }

        .informatica-syllabus .duration,
        .informatica-syllabus .topic-duration {
            background: #e0f2fe;
            color: #0f172a;
            padding: 6px 10px;
            border-radius: 20px;
            font-weight: 700;
            white-space: nowrap;
        }

        .informatica-syllabus .topic {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 10px;
        }

        .informatica-syllabus .topic-title {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 8px;
            color: #0f172a;
        }

        .informatica-syllabus .learning-objectives {
            background: #fff;
            border-radius: 10px;
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
        }

        .informatica-syllabus .resources {
            margin-top: 8px;
        }

        .informatica-syllabus .use-cases {
            margin-top: 12px;
        }

        .informatica-syllabus .use-case-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
            gap: 10px;
            padding: 0;
            list-style: none;
        }

        .informatica-syllabus .use-case-item {
            background: #fff;
            border-radius: 10px;
            padding: 10px;
            border: 1px solid #e2e8f0;
        }

        @media (max-width: 768px) {
            .informatica-syllabus .module-header,
            .informatica-syllabus .topic-title {
                flex-direction: column;
                align-items: flex-start;
            }
        }
        </style>
<header>
        <h1>Informatica PowerCenter Training</h1>
        <p class="subtitle">Master ETL Development and Data Integration</p>
    </header>
    
    <div class="certification-note">
        <h3>🎓 Certification Ready Course</h3>
        <p>This syllabus prepares you for Informatica PowerCenter certification with hands-on labs and real-world scenarios</p>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 1: Data Warehousing Fundamentals</h2>
            <span class="duration">3 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Core Data Warehouse Concepts
                <span class="topic-duration">1.5 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Understand Data Warehouse and Data Mart architectures</li>
                    <li>Differentiate between OLAP and OLTP systems</li>
                    <li>Design staging areas for ETL processes</li>
                    <li>Implement dimensional modeling techniques</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Advanced Data Modeling
                <span class="topic-duration">1.5 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Design Star and Snowflake schemas</li>
                    <li>Implement Slowly Changing Dimensions (Type 1, 2, 3)</li>
                    <li>Work with Fact tables and Confirmed Dimensions</li>
                    <li>Create aggregation tables and implement Change Data Capture</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 2: PowerCenter Architecture & Components</h2>
            <span class="duration">2 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                PowerCenter Components
                <span class="topic-duration">1 hour</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Navigate Informatica Designer interface</li>
                    <li>Use Repository Manager for metadata management</li>
                    <li>Create and monitor workflows in Workflow Manager</li>
                    <li>Track job execution with Workflow Monitor</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                PowerCenter Architecture
                <span class="topic-duration">1 hour</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Understand PowerCenter server architecture</li>
                    <li>Work with Source Qualifier transformations</li>
                    <li>Design mappings and mapplets</li>
                    <li>Configure sessions and tasks</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 3: Sources & Targets Configuration</h2>
            <span class="duration">2 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Working with Data Sources
                <span class="topic-duration">1 hour</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Connect to relational databases as sources</li>
                    <li>Configure flat file sources with proper formatting</li>
                    <li>Handle different source data types</li>
                    <li>Implement source data validation</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Working with Data Targets
                <span class="topic-duration">1 hour</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Configure relational database targets</li>
                    <li>Set up flat file targets with proper formatting</li>
                    <li>Implement target load ordering</li>
                    <li>Handle bulk vs normal loading strategies</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 4: Core Transformations</h2>
            <span class="duration">4 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Basic Transformations
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Implement Expression transformations for data manipulation</li>
                    <li>Configure Lookup transformations for reference data</li>
                    <li>Use Sequence Generator for surrogate keys</li>
                    <li>Apply Filter and Router transformations for data routing</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Advanced Transformations
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Implement Joiner transformations for data integration</li>
                    <li>Use Aggregator for summary calculations</li>
                    <li>Configure Update Strategy for CDC</li>
                    <li>Apply Rank and Transaction Control transformations</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 5: Transformation Language & Functions</h2>
            <span class="duration">2 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                PowerCenter Functions
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Use numeric functions for calculations</li>
                    <li>Apply string functions for text manipulation</li>
                    <li>Implement date functions for temporal operations</li>
                    <li>Create user-defined functions for custom logic</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 6: Advanced PowerCenter Concepts</h2>
            <span class="duration">5 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Advanced Transformations & Reusability
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Implement unconnected lookups and stored procedures</li>
                    <li>Create and use mapplets for reusable logic</li>
                    <li>Define reusable transformations</li>
                    <li>Work with worklets for modular workflow design</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Session Management & Optimization
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Configure session parameters and recovery</li>
                    <li>Implement mapping parameters and variables</li>
                    <li>Apply push-down optimization techniques</li>
                    <li>Use PMCMD and PMREP utilities</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Lookup Cache Strategies
                <span class="topic-duration">1 hour</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Configure static and dynamic lookup caches</li>
                    <li>Implement persistent lookup caching</li>
                    <li>Use shared lookup caches for performance</li>
                    <li>Manage sorter and rank caches efficiently</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 7: Workflow Tasks & Scheduling</h2>
            <span class="duration">2 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                Task Management
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Configure different task types (Session, Command, Email)</li>
                    <li>Implement event-based workflows</li>
                    <li>Use timer and decision tasks</li>
                    <li>Schedule workflows for automated execution</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="module">
        <div class="module-header">
            <h2 class="module-title">Module 8: ETL Testing & Performance Tuning</h2>
            <span class="duration">2 hours</span>
        </div>
        
        <div class="topic">
            <h3 class="topic-title">
                ETL Testing & Optimization
                <span class="topic-duration">2 hours</span>
            </h3>
            <div class="learning-objectives">
                <h4>What You Will Learn:</h4>
                <ul>
                    <li>Perform unit testing and system integration testing</li>
                    <li>Conduct performance testing of ETL processes</li>
                    <li>Apply performance optimization techniques</li>
                    <li>Debug and troubleshoot mapping issues</li>
                </ul>
            </div>
            <div class="resources">
                <span>Free Resources:</span> MCQ Test & Interview Questions Available
            </div>
        </div>
    </div>
    
    <div class="use-cases">
        <h2>Real-World Informatica PowerCenter Use Cases</h2>
        
        <div class="use-case-category">
            <h3>Financial Services</h3>
            <div class="use-case-list">
                <div class="use-case-item">
                    <strong>Banking Data Warehousing</strong>
                    <p>Integrate transaction data from multiple banking systems into centralized data warehouse for regulatory reporting and customer analytics</p>
                </div>
                <div class="use-case-item">
                    <strong>Risk Management</strong>
                    <p>Process large volumes of trading data to calculate risk exposure and compliance metrics in real-time</p>
                </div>
                <div class="use-case-item">
                    <strong>Customer 360 View</strong>
                    <p>Create unified customer profiles by integrating data from banking, investment, and insurance systems</p>
                </div>
            </div>
        </div>
        
        <div class="use-case-category">
            <h3>Healthcare & Life Sciences</h3>
            <div class="use-case-list">
                <div class="use-case-item">
                    <strong>Clinical Data Integration</strong>
                    <p>Integrate patient data from EHR systems, lab results, and clinical trials for research and treatment optimization</p>
                </div>
                <div class="use-case-item">
                    <strong>Claims Processing</strong>
                    <p>Automate ETL processes for insurance claims data to detect fraud and optimize reimbursement cycles</p>
                </div>
                <div class="use-case-item">
                    <strong>Pharmaceutical Research</strong>
                    <p>Process clinical trial data and research findings to accelerate drug discovery and regulatory submissions</p>
                </div>
            </div>
        </div>
        
        <div class="use-case-category">
            <h3>Retail & E-commerce</h3>
            <div class="use-case-list">
                <div class="use-case-item">
                    <strong>Sales Data Integration</strong>
                    <p>Consolidate sales data from POS systems, e-commerce platforms, and mobile apps for business intelligence</p>
                </div>
                <div class="use-case-item">
                    <strong>Inventory Management</strong>
                    <p>Integrate inventory data across warehouses and stores to optimize stock levels and reduce carrying costs</p>
                </div>
                <div class="use-case-item">
                    <strong>Customer Behavior Analysis</strong>
                    <p>Process customer interaction data to create personalized marketing campaigns and improve customer retention</p>
                </div>
            </div>
        </div>
        
        <div class="use-case-category">
            <h3>Manufacturing & Supply Chain</h3>
            <div class="use-case-list">
                <div class="use-case-item">
                    <strong>Supply Chain Optimization</strong>
                    <p>Integrate data from suppliers, manufacturing systems, and logistics providers to optimize supply chain operations</p>
                </div>
                <div class="use-case-item">
                    <strong>Quality Control</strong>
                    <p>Process sensor data and quality metrics from production lines to identify defects and improve product quality</p>
                </div>
                <div class="use-case-item">
                    <strong>Predictive Maintenance</strong>
                    <p>Integrate equipment sensor data with maintenance records to predict failures and schedule preventive maintenance</p>
                </div>
            </div>
        </div>
    </div>
    
    <footer>
        <p><strong>Informatica PowerCenter Training Program</strong> | Total Estimated Duration: ~22 hours</p>
        <p>All modules include free MCQ tests, interview questions, and hands-on exercises</p>
        <p>Industry-recognized curriculum designed by ETL experts with 10+ years experience</p>
    </footer>
    </div>
</div>
