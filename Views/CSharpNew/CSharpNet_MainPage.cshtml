@{
    ViewData["Title"] = "C#.NET Course Home";
    ViewData["ActiveMenu"] = "CSharpAdvanced";
    ViewData["ActivePage"] = "CSharpAdvanced";
}

<div class="container-fluid px-0">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h2 class="mb-1">C#.NET Course — Main Page</h2>
                    <div class="text-muted">
                        Expand a topic → click a subtopic to preview details and open the corresponding course page.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="input-group" style="max-width:420px;">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input id="searchBox" type="text" class="form-control" placeholder="Search (e.g., DLL, StreamReader, Registry)" />
                        <button id="clearBtn" class="btn btn-outline-secondary" type="button">Clear</button>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <span class="badge text-bg-primary" id="topicCount">Topics: —</span>
                <span class="badge text-bg-secondary" id="subtopicCount">Subtopics: —</span>
                <span class="badge text-bg-light border"><i class="fa-regular fa-lightbulb me-1"></i>Tip: Use the search box to filter quickly</span>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- LEFT: Topics / Subtopics -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between">
                    <strong><i class="fa-solid fa-list-check me-2"></i>Topics</strong>
                    <button id="collapseAllBtn" type="button" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-compress me-1"></i>Collapse all
                    </button>
                </div>

                <div class="card-body p-2">
                    <div class="accordion" id="courseAccordion">
                        <!-- JS builds topics here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Preview -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between">
                    <strong><i class="fa-solid fa-eye me-2"></i>Preview</strong>
                    <div class="d-flex gap-2">
                        <a id="openBtn" class="btn btn-sm btn-success disabled" href="#" role="button">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open page
                        </a>
                        <button id="copyRouteBtn" class="btn btn-sm btn-outline-primary" type="button" disabled>
                            <i class="fa-regular fa-copy me-1"></i>Copy route
                        </button>
                    </div>
                </div>

                <div class="card-body" id="previewArea">
                    <div class="p-3 bg-light border rounded">
                        <h5 class="mb-2">Welcome 👋</h5>
                        <div class="text-muted mb-3">
                            Select any subtopic from the left. This panel will show the route and a recommended “Beginner‑First” structure for your course page.
                        </div>

                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 bg-white">
                                    <div class="fw-semibold mb-1">What you build next</div>
                                    <div class="text-muted">Create a course page (CSHTML) for each subtopic and map it to a controller action.</div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 bg-white">
                                    <div class="fw-semibold mb-1">Suggested action naming</div>
                                    <div class="text-muted">Use PascalCase action names (example: <code>/CSharp/CreatingAndUsingADll</code>).</div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="fw-semibold mb-2">Beginner‑First Page Structure (copy into your prompt)</div>
                        <ol class="mb-0">
                            <li>Introduction (What is it?)</li>
                            <li>Purpose (Why do we need it?)</li>
                            <li>Real‑World Usage</li>
                            <li>Prerequisites</li>
                            <li>Key Terms / Glossary</li>
                            <li>Syntax</li>
                            <li>Rules / Key Points (Do’s & Don’ts)</li>
                            <li>Basic Example + Output</li>
                            <li>Step‑by‑step Explanation</li>
                            <li>How it Works Internally</li>
                            <li>More Examples (Beginner → Intermediate)</li>
                            <li>Common Mistakes + Fixes</li>
                            <li>Best Coding Practices</li>
                            <li>MCQs + Interview Questions + Coding Exercises (Expandable answers)</li>
                            <li>Summary + What’s Next</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // -----------------------------
    // TOC data (from your syllabus)
    // -----------------------------
    const COURSE = [
  {
    "title": "Introduction to C#",
    "icon": "fa-solid fa-code",
    "controller": "CSharp",
    "subtopics": [
      {
        "label": "Features of C#",
        "action": "FeaturesOfCSharp",
        "route": "/CSharp/FeaturesOfCSharp"
      },
      {
        "label": "C# Compilation and Execution",
        "action": "CSharpCompilationAndExecution",
        "route": "/CSharp/CSharpCompilationAndExecution"
      },
      {
        "label": "General Structure of a C# Program",
        "action": "GeneralStructureOfACSharpProgram",
        "route": "/CSharp/GeneralStructureOfACSharpProgram"
      },
      {
        "label": "Creating and Using a DLL",
        "action": "CreatingAndUsingADll",
        "route": "/CSharp/CreatingAndUsingADll"
      }
    ]
  },
  {
    "title": "File I/O and Serialization",
    "icon": "fa-solid fa-file-lines",
    "controller": "CSharp",
    "subtopics": [
      {
        "label": "Persisting object state to a stream",
        "action": "PersistingObjectStateToAStream",
        "route": "/CSharp/PersistingObjectStateToAStream"
      },
      {
        "label": "Various classes used for File handling",
        "action": "VariousClassesUsedForFileHandling",
        "route": "/CSharp/VariousClassesUsedForFileHandling"
      },
      {
        "label": "Using StreamReader, StreamWriter",
        "action": "UsingStreamreaderStreamwriter",
        "route": "/CSharp/UsingStreamreaderStreamwriter"
      },
      {
        "label": "Using BinaryReader, BinaryWriter",
        "action": "UsingBinaryreaderBinarywriter",
        "route": "/CSharp/UsingBinaryreaderBinarywriter"
      },
      {
        "label": "Using File, FileInfo, Directory, DirectoryInfo",
        "action": "UsingFileFileinfoDirectoryDirectoryinfo",
        "route": "/CSharp/UsingFileFileinfoDirectoryDirectoryinfo"
      },
      {
        "label": "Serialization modes: SOAP, XML, JSON",
        "action": "SerializationModesSoapXmlJson",
        "route": "/CSharp/SerializationModesSoapXmlJson"
      }
    ]
  },
  {
    "title": "Packaging and Deployment",
    "icon": "fa-solid fa-box-open",
    "controller": "CSharp",
    "subtopics": [
      {
        "label": "File System Editor",
        "action": "FileSystemEditor",
        "route": "/CSharp/FileSystemEditor"
      },
      {
        "label": "Registry Editor",
        "action": "RegistryEditor",
        "route": "/CSharp/RegistryEditor"
      },
      {
        "label": "File Types Editor",
        "action": "FileTypesEditor",
        "route": "/CSharp/FileTypesEditor"
      },
      {
        "label": "User Interface Editor",
        "action": "UserInterfaceEditor",
        "route": "/CSharp/UserInterfaceEditor"
      },
      {
        "label": "Custom Actions",
        "action": "CustomActions",
        "route": "/CSharp/CustomActions"
      },
      {
        "label": "Launch Condition Editor",
        "action": "LaunchConditionEditor",
        "route": "/CSharp/LaunchConditionEditor"
      },
      {
        "label": "Creating Uninstall Shortcut",
        "action": "CreatingUninstallShortcut",
        "route": "/CSharp/CreatingUninstallShortcut"
      }
    ]
  }
];

    const accordion = document.getElementById("courseAccordion");
    const searchBox = document.getElementById("searchBox");
    const clearBtn = document.getElementById("clearBtn");
    const collapseAllBtn = document.getElementById("collapseAllBtn");

    const previewArea = document.getElementById("previewArea");
    const openBtn = document.getElementById("openBtn");
    const copyRouteBtn = document.getElementById("copyRouteBtn");

    const topicCount = document.getElementById("topicCount");
    const subtopicCount = document.getElementById("subtopicCount");

    let active = null;

    topicCount.textContent = "Topics: " + COURSE.length;
    subtopicCount.textContent = "Subtopics: " + COURSE.reduce((sum, t) => sum + t.subtopics.length, 0);

    function esc(s) {
        return (s || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function makeId(prefix, idx) {
        return prefix + "_" + idx + "_" + Math.random().toString(16).slice(2);
    }

    function buildAccordion(filter = "") {
        accordion.innerHTML = "";
        const q = (filter || "").trim().toLowerCase();

        COURSE.forEach((topic, tIndex) => {
            const topicId = makeId("topic", tIndex);
            const collapseId = makeId("collapse", tIndex);

            // filter subtopics
            const subs = topic.subtopics.filter(st => {
                if (!q) return true;
                const hay = (topic.title + " " + st.label + " " + st.action + " " + st.route).toLowerCase();
                return hay.includes(q);
            });

            if (q && subs.length === 0) return;

            const item = document.createElement("div");
            item.className = "accordion-item";

            const header = document.createElement("h2");
            header.className = "accordion-header";
            header.id = topicId;

            const button = document.createElement("button");
            button.className = "accordion-button collapsed";
            button.type = "button";
            button.setAttribute("data-bs-toggle", "collapse");
            button.setAttribute("data-bs-target", "#" + collapseId);
            button.setAttribute("aria-expanded", "false");
            button.setAttribute("aria-controls", collapseId);
            button.innerHTML = `<i class="${esc(topic.icon)} me-2"></i><strong>${esc(topic.title)}</strong>
                                <span class="ms-2 badge text-bg-light border">${subs.length}</span>`;

            header.appendChild(button);

            const collapse = document.createElement("div");
            collapse.id = collapseId;
            collapse.className = "accordion-collapse collapse";
            collapse.setAttribute("aria-labelledby", topicId);
            collapse.setAttribute("data-bs-parent", "#courseAccordion");

            const body = document.createElement("div");
            body.className = "accordion-body p-2";

            const list = document.createElement("div");
            list.className = "list-group";

            subs.forEach((st, sIndex) => {
                const row = document.createElement("div");
                row.className = "list-group-item list-group-item-action d-flex align-items-start justify-content-between gap-2";

                // left: label
                const left = document.createElement("div");
                left.className = "me-2";
                left.innerHTML = `<div class="fw-semibold">${esc(st.label)}</div>
                                  <div class="text-muted small">${esc(st.route)}</div>`;

                // right: buttons
                const right = document.createElement("div");
                right.className = "d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2";

                const previewBtn = document.createElement("button");
                previewBtn.type = "button";
                previewBtn.className = "btn btn-sm btn-outline-primary";
                previewBtn.innerHTML = '<i class="fa-solid fa-eye me-1"></i>Preview';
                previewBtn.addEventListener("click", () => selectSubtopic(topic, st, row));

                const openLink = document.createElement("a");
                openLink.className = "btn btn-sm btn-success";
                openLink.href = st.route;
                openLink.innerHTML = '<i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open';
                openLink.title = "Open the course page (create this route in MVC)";

                right.appendChild(previewBtn);
                right.appendChild(openLink);

                row.appendChild(left);
                row.appendChild(right);

                // clicking row (except Open link) also previews
                row.addEventListener("click", (e) => {
                    if (e.target.closest("a")) return;
                    if (e.target.closest("button")) return;
                    selectSubtopic(topic, st, row);
                });

                list.appendChild(row);
            });

            body.appendChild(list);
            collapse.appendChild(body);

            item.appendChild(header);
            item.appendChild(collapse);

            accordion.appendChild(item);

            // auto open during search
            if (q) {
                const bs = bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false });
                bs.show();
                button.classList.remove("collapsed");
                button.setAttribute("aria-expanded", "true");
            }
        });
    }

    function selectSubtopic(topic, st, rowEl) {
        // clear active
        accordion.querySelectorAll(".list-group-item").forEach(x => x.classList.remove("active"));
        rowEl.classList.add("active");

        active = { topic, st };

        openBtn.classList.remove("disabled");
        openBtn.href = st.route;

        copyRouteBtn.disabled = false;
        copyRouteBtn.dataset.route = st.route;

        const beginnerFirst = [
            "Introduction (What is it?)",
            "Purpose (Why do we need it?)",
            "Real‑World Usage",
            "Prerequisites",
            "Key Terms / Glossary",
            "Syntax",
            "Rules / Key Points (Do’s & Don’ts)",
            "Basic Example + Output",
            "Step‑by‑step Explanation",
            "How it Works Internally",
            "More Examples (Beginner → Intermediate)",
            "Common Mistakes + Fixes",
            "Best Coding Practices",
            "MCQs + Interview Questions + Coding Exercises (Expandable answers)",
            "Summary + What’s Next"
        ];

        previewArea.innerHTML = `
            <div class="mb-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge text-bg-primary"><i class="${esc(topic.icon)} me-1"></i>${esc(topic.title)}</span>
                    <span class="badge text-bg-success">${esc(st.label)}</span>
                </div>
            </div>

            <div class="border rounded p-3 bg-light">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="fw-semibold mb-1">MVC Route</div>
                        <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
                            <code class="border rounded px-2 py-1 bg-white">${esc(st.route)}</code>
                            <span class="text-muted small">Action: <strong>${esc(st.action)}</strong> | Controller: <strong>${esc(topic.controller)}</strong></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="fw-semibold mb-2">Beginner‑First Content Titles (for this course page)</div>
                        <ol class="mb-0">
                            ${beginnerFirst.map(x => `<li>${esc(x)}</li>`).join("")}
                        </ol>
                    </div>
                </div>
            </div>

            <div class="mt-3 text-muted small">
                Note: Create the corresponding CSHTML course page and MVC action for <strong>${esc(st.action)}</strong>.
            </div>
        `;
    }

    function collapseAll() {
        document.querySelectorAll("#courseAccordion .accordion-collapse").forEach(el => {
            const c = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
            c.hide();
        });
        document.querySelectorAll("#courseAccordion .accordion-button").forEach(btn => {
            btn.classList.add("collapsed");
            btn.setAttribute("aria-expanded", "false");
        });
    }

    function copyToClipboard(text) {
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            // tiny UX feedback
            copyRouteBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Copied';
            setTimeout(() => {
                copyRouteBtn.innerHTML = '<i class="fa-regular fa-copy me-1"></i>Copy route';
            }, 900);
        });
    }

    // events
    searchBox.addEventListener("input", () => buildAccordion(searchBox.value));
    clearBtn.addEventListener("click", () => {
        searchBox.value = "";
        buildAccordion("");
        searchBox.focus();
    });
    collapseAllBtn.addEventListener("click", collapseAll);
    copyRouteBtn.addEventListener("click", () => copyToClipboard(copyRouteBtn.dataset.route));

    // initial render
    buildAccordion("");
</script>
