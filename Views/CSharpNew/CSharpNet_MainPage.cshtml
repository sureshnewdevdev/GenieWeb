    const navEl = document.getElementById("nav");
    const contentArea = document.getElementById("contentArea");
    const searchBox = document.getElementById("searchBox");
    const collapseAllBtn = document.getElementById("collapseAllBtn");
    const topicCountChip = document.getElementById("topicCountChip");
    const subtopicCountChip = document.getElementById("subtopicCountChip");

    let activeSubtopicId = null;

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, (m) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      }[m]));
    }

    function buildNav(query) {
      const q = query.trim().toLowerCase();
      navEl.innerHTML = "";

      let topicCount = 0;
      let subtopicCount = 0;

      COURSE.forEach(topic => {
        const matchedSubtopics = topic.subtopics.filter(st =>
          st.label.toLowerCase().includes(q) ||
          st.short.toLowerCase().includes(q) ||
          topic.title.toLowerCase().includes(q)
        );

        if (q && matchedSubtopics.length === 0) return;

        topicCount += 1;
        subtopicCount += matchedSubtopics.length || topic.subtopics.length;

        const topicDiv = document.createElement("div");
        topicDiv.className = "topic";

        const topicBtn = document.createElement("button");
        topicBtn.type = "button";
        topicBtn.className = "topic-btn";
        topicBtn.setAttribute("aria-expanded", "false");

        const left = document.createElement("div");
        left.className = "topic-left";

        const icon = document.createElement("div");
        icon.className = "topic-icon";
        icon.textContent = topic.icon || "📘";

        const titleWrap = document.createElement("div");
        titleWrap.className = "topic-title";

        const strong = document.createElement("strong");
        strong.textContent = topic.title;

        const span = document.createElement("span");
        span.textContent = `${topic.subtopics.length} subtopics`;

        titleWrap.appendChild(strong);
        titleWrap.appendChild(span);

        left.appendChild(icon);
        left.appendChild(titleWrap);

        const caret = document.createElement("div");
        caret.className = "caret";
        caret.textContent = "▾";

        topicBtn.appendChild(left);
        topicBtn.appendChild(caret);

        const subDiv = document.createElement("div");
        subDiv.className = "subtopics";

        matchedSubtopics.forEach(st => {
          const stBtn = document.createElement("button");
          stBtn.type = "button";
          stBtn.className = "subtopic" + (st.id === activeSubtopicId ? " active" : "");
          stBtn.dataset.subtopicId = st.id;

          const label = document.createElement("div");
          label.className = "label";
          label.textContent = st.label;

          const pill = document.createElement("div");
          pill.className = "pill";
          pill.textContent = "Open page";

          stBtn.appendChild(label);
          stBtn.appendChild(pill);

          stBtn.addEventListener("click", () => {
            selectSubtopic(topic, st);
          });

          subDiv.appendChild(stBtn);
        });

        topicBtn.addEventListener("click", () => {
          const isOpen = topicDiv.classList.toggle("open");
          topicBtn.setAttribute("aria-expanded", String(isOpen));
        });

        if (q !== "") {
          topicDiv.classList.add("open");
          topicBtn.setAttribute("aria-expanded", "true");
        }

        topicDiv.appendChild(topicBtn);
        topicDiv.appendChild(subDiv);
        navEl.appendChild(topicDiv);
      });

      topicCountChip.textContent = `Topics: ${topicCount}`;
      topicCountChip.style.visibility = topicCount ? "visible" : "hidden";
      subtopicCountChip.textContent = `Subtopics: ${subtopicCount}`;
      subtopicCountChip.style.visibility = subtopicCount ? "visible" : "hidden";
    }

    function collapseAll() {
      document.querySelectorAll(".topic").forEach(t => {
        t.classList.remove("open");
        const btn = t.querySelector(".topic-btn");
        if (btn) btn.setAttribute("aria-expanded", "false");
      });
    }

    function setActiveButton(subtopicId) {
      document.querySelectorAll(".subtopic").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.subtopicId === subtopicId);
      });
    }

    function selectSubtopic(topic, subtopic) {
      activeSubtopicId = subtopic.id;
      setActiveButton(activeSubtopicId);

      const contentTitles = [
        "Introduction (What is it?)",
        "Purpose (Why do we need it?)",
        "Real-World Usage (Where used in apps)",
        "Prerequisites",
        "Key Terms / Glossary",
        "Syntax",
        "Rules / Key Points (Do’s & Don’ts)",
        "Basic Example + Output",
        "Step-by-step Explanation",
        "How it Works Internally",
        "Types / Variations (if applicable)",
        "More Examples (Beginner → Intermediate)",
        "Common Mistakes + Fixes",
        "Best Coding Practices",
        "Code Quality Checklist",
        "Logical Building Exercises (Expandable answers)",
        "Coding Practice Tasks (Expandable solutions)",
        "Mini Assignment (Expandable full solution)",
        "MCQ Quiz (Expandable explanations)",
        "Interview Questions (Expandable best answers)",
        "Summary (Key takeaways)",
        "What’s Next (Related topics)"
      ];

      const suggestedRoute = subtopic.route;

      contentArea.innerHTML = `
        <div class="hero">
          <h1>${escapeHtml(subtopic.label)}</h1>
          <p>
            <span class="badge green">Topic</span>
            <span class="badge">${escapeHtml(topic.title)}</span>
            <span class="badge">Subtopic</span>
          </p>
          <div class="divider"></div>
          <div class="breadcrumb">
            <span>Navigation:</span>
            <span class="badge">${escapeHtml(topic.icon || "📘")} ${escapeHtml(topic.title)}</span>
            <span>→</span>
            <span class="badge green">${escapeHtml(subtopic.label)}</span>
          </div>
        </div>

        <div class="grid">
          <div class="card">
            <h3>✅ What should be inside this course page?</h3>
            <p class="muted">Use this exact order for beginners (copy into your prompt).</p>
            <div class="divider"></div>
            <ul class="muted" style="margin:0; padding-left: 18px; line-height:1.75;">
              ${contentTitles.map(t => `<li>${escapeHtml(t)}</li>`).join("")}
            </ul>
          </div>

          <div class="card">
            <h3>🔗 Suggested MVC route</h3>
            <p class="muted">
              Replace with your real controller/action. For now this demo uses a placeholder route.
            </p>

            <div class="codebox">
              <div class="codehead">
                <span>Route (example)</span>
                <span class="muted">ASP.NET MVC</span>
              </div>
              <pre><code>${escapeHtml(suggestedRoute)}</code></pre>
            </div>

            <div class="mini-actions">
              <a class="linkbtn green" href="${escapeHtml(suggestedRoute)}" target="_blank" rel="noopener">
                Open route in new tab ↗
              </a>
              <a class="linkbtn" href="#" onclick="copyText('${suggestedRoute.replace("'", "\\'")}'); return false;">
                Copy route
              </a>
            </div>

            <div class="divider"></div>

            <h3 style="margin-top:0;">📌 Tip (MVC)</h3>
            <p class="muted">
              Create a CSHTML page for this subtopic and render it inside your main layout.
              Keep this navigation as a shared partial view for all pages.
            </p>
          </div>
        </div>

        <div class="divider"></div>

        <div class="card">
          <h3>Suggested next action</h3>
          <p class="muted">
            Create a view named like <span class="kbd">${escapeHtml(subtopic.label)}</span> and connect it with a controller action.
            Then paste your “Beginner-First” sections into that view.
          </p>
        </div>
      `;
    }

    function copyText(text) {
      try {
        navigator.clipboard.writeText(text);
        alert("Copied: " + text);
      } catch (e) {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
        alert("Copied: " + text);
      }
    }

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        searchBox?.focus();
      }
    });

    searchBox?.addEventListener("input", () => {
      buildNav(searchBox.value);
      setActiveButton(activeSubtopicId);
    });

    collapseAllBtn.addEventListener("click", () => collapseAll());

    buildNav("");
  </script>
