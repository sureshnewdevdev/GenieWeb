</style>

<div class="course-hero rounded-4 p-4 mb-3">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
    <div>
      <h2 class="mb-1">C#.NET Course Dashboard</h2>
      <p class="mb-0 text-muted">Expand a topic → click a subtopic to open its course page.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-end">
      <button class="btn btn-outline-success btn-sm" type="button" onclick="expandAllTopics()">Expand All</button>
      <button class="btn btn-outline-secondary btn-sm" type="button" onclick="collapseAllTopics()">Collapse All</button>
    </div>
  </div>

  <div class="mt-3 d-flex flex-column flex-md-row gap-2 align-items-md-center">
    <div class="input-group toc-search">
      <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
      <input id="tocSearch" type="text" class="form-control" placeholder="Search topics / subtopics (e.g., CLR, async, generics)..." />
    </div>
    <div class="text-muted small">Tip: Press <kbd>Ctrl</kbd> + <kbd>K</kbd> to focus search</div>
  </div>
</div>

