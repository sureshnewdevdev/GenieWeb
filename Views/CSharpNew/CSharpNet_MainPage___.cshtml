<script>
  const searchBox = document.getElementById("tocSearch");
  const collapseEls = Array.from(document.querySelectorAll("#csharpCourseToc .accordion-collapse"));

  function expandAllTopics(){
    collapseEls.forEach(el => bootstrap.Collapse.getOrCreateInstance(el, {toggle:false}).show());
  }

  function collapseAllTopics(){
    collapseEls.forEach(el => bootstrap.Collapse.getOrCreateInstance(el, {toggle:false}).hide());
  }

  function filterToc(q){
    const query = (q||"").trim().toLowerCase();
    const items = Array.from(document.querySelectorAll(".toc-subtopic"));
    const topicItems = Array.from(document.querySelectorAll("#csharpCourseToc .accordion-item"));

    // show/hide subtopics
    items.forEach(it => {
      const hay = it.getAttribute("data-search") || "";
      const match = query === "" ? true : hay.includes(query);
      it.style.display = match ? "" : "none";
    });

    // show/hide topics based on visible subtopics
    topicItems.forEach(topic => {
      const visible = Array.from(topic.querySelectorAll(".toc-subtopic")).some(x => x.style.display !== "none");
      topic.style.display = visible ? "" : "none";
      const collapse = topic.querySelector(".accordion-collapse");
      if (!collapse) return;
      const inst = bootstrap.Collapse.getOrCreateInstance(collapse, {toggle:false});
      if (query !== "" && visible) inst.show();
      if (query === "") inst.hide();
    });
  }

  searchBox?.addEventListener("input", () => filterToc(searchBox.value));

  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); searchBox?.focus(); }
  });

  function copyPrompt(){
    const prompt = `Act as a professional C#/.NET trainer and technical author for an ASP.NET MVC course website.

Topic: <TOPIC_NAME>
Audience: Beginners

Create the content in this exact Beginner-First order:
1) Introduction (What is it?)
2) Purpose (Why do we need it?)
3) Real-World Usage
4) Prerequisites
5) Key Terms / Glossary
6) Syntax
7) Rules / Key Points
8) Basic Example + Output
9) Step-by-step Explanation
10) How it Works Internally
11) Types / Variations (if applicable)
12) More Examples (Beginner → Intermediate)
13) Common Mistakes + Fixes
14) Best Coding Practices
15) Code Quality Checklist
16) Logical Building Exercises (5) with expandable answers
17) Coding Practice Tasks (3) with expandable solutions
18) Mini Assignment (1) with expandable full solution
19) MCQ Quiz (10) with expandable explanations
20) Interview Questions (10) with expandable best answers
21) Summary
22) What’s Next

Return output as CSHTML-ready sections.`;
    navigator.clipboard.writeText(prompt).then(() => alert("Prompt copied!"));
  }
</script>