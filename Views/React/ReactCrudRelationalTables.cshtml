<!-- Section: React Frontend -->
<section class="mb-5">
    <h2 class="text-secondary">Frontend: React Application</h2>

    <h3 class="text-info">ProductComponent.js with Category Link</h3>
    <div class="code-snippet bg-light p-3 rounded border position-relative">
<pre class="mb-0"><code>import React, { useEffect, useState } from 'react';
import axios from 'axios';

const API = "https://localhost:5001/api";

function ProductComponent() {
  const [products, setProducts] = useState([]);
  const [categories, setCategories] = useState([]);
  const [form, setForm] = useState({ id: 0, name: "", price: "", categoryId: "" });
  const [editing, setEditing] = useState(false);

  useEffect(() => {
    axios.get(`${API}/categories`).then(res => setCategories(res.data));
    axios.get(`${API}/products`).then(res => setProducts(res.data));
  }, []);

  const handleChange = e => setForm({ ...form, [e.target.name]: e.target.value });

  const handleSubmit = e => {
    e.preventDefault();
    const method = editing ? "put" : "post";
    const url = `${API}/products${editing ? `/${form.id}` : ""}`;
    axios[method](url, form).then(() => {
      resetForm();
      axios.get(`${API}/products`).then(res => setProducts(res.data));
    });
  };

  const handleEdit = p => {
    setForm(p);
    setEditing(true);
  };

  const handleDelete = id => {
    axios.delete(`${API}/products/${id}`).then(() =>
      setProducts(prev => prev.filter(p => p.id !== id))
    );
  };

  const resetForm = () => {
    setForm({ id: 0, name: "", price: "", categoryId: "" });
    setEditing(false);
  };

  return (
    &lt;div&gt;
      &lt;h3&gt;{editing ? "Edit Product" : "Add Product"}&lt;/h3&gt;
      &lt;form onSubmit={handleSubmit}&gt;
        &lt;input name="name" value={form.name} onChange={handleChange} placeholder="Name" required /&gt;
        &lt;input name="price" value={form.price} onChange={handleChange} placeholder="Price" type="number" required /&gt;
        &lt;select name="categoryId" value={form.categoryId} onChange={handleChange} required&gt;
          &lt;option value=""&gt;-- Select Category --&lt;/option&gt;
          {categories.map(c =&gt; (
            &lt;option key={c.id} value={c.id}&gt;{c.name}&lt;/option&gt;
          ))}
        &lt;/select&gt;
        &lt;button type="submit"&gt;{editing ? "Update" : "Add"}&lt;/button&gt;
        {editing && &lt;button type="button" onClick={resetForm}&gt;Cancel&lt;/button&gt;}
      &lt;/form&gt;

      &lt;h4&gt;Product List&lt;/h4&gt;
      &lt;ul&gt;
        {products.map(p =&gt; (
          &lt;li key={p.id}&gt;
            {p.name} (${p.price}) - Category: {p.category?.name}
            &lt;button onClick={() =&gt; handleEdit(p)}&gt;Edit&lt;/button&gt;
            &lt;button onClick={() =&gt; handleDelete(p.id)}&gt;Delete&lt;/button&gt;
          &lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  );
}

export default ProductComponent;</code></pre>
        <button class="btn btn-outline-secondary copy-btn position-absolute top-0 end-0 m-2">Copy</button>
    </div>
</section>

<!-- Section: Summary -->
<section class="mb-5">
    <h2 class="text-secondary">Summary</h2>
    <p class="lead">
        This setup demonstrates how to build and link related entities in a full-stack app:
    </p>
    <ul class="list-group">
        <li class="list-group-item"><b>Products have a foreign key</b> linking them to Categories</li>
        <li class="list-group-item"><b>Categories can exist independently</b>, and products are created under them</li>
        <li class="list-group-item"><b>Product list includes category name</b> using Entity Framework's <code>Include</code></li>
        <li class="list-group-item">React form uses <code>&lt;select&gt;</code> for category assignment</li>
        <li class="list-group-item"><b>Full CRUD</b> supported for both tables, including Edit and Delete</li>
    </ul>
</section>

